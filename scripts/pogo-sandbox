#!/usr/bin/env bash
# =============================================================================
# pogo-sandbox — PACKAGED TEST ISOLATION (mg-78a5)
# =============================================================================
#
#   source "$REPO_ROOT/scripts/pogo-sandbox"
#   pogo_sandbox_create live          # a private root; NO env change yet
#   ...build the binaries under the real HOME...
#   pogo_sandbox_isolate              # HOME/XDG/POGO_HOME pinned, and PROVEN private
#   pogo_sandbox_daemon "$POGO_SANDBOX_DIR/pogod" /scheduler/schedules
#   trap pogo_sandbox_down EXIT
#
# or, for a test that is not written in shell:
#
#   scripts/pogo-sandbox run -- go test ./internal/agent/...
#
# WHY THIS FILE EXISTS
# --------------------
# FOUR tickets have been filed for ONE defect — a test reading the developer's
# live ~/.pogo, live daemon, or live fleet instead of a fixture:
#
#   mg-6092   a test reading live ~/.pogo park state
#   mg-e8e7   seven respawn tests reading the host's live park state
#   mg-5336   the project and driver suites writing to the real ~/.pogo
#   mg-3412   scripts/pogo-self-deploy_live_test.sh, which gates EVERY merge
#
# Each fix was correct and each left the next instance available, because every
# one of them re-derived isolation by hand at the call site. Isolation done by
# hand is isolation done by REMEMBERING, and the record says four teams in a row
# did not. mg-3412 is what that costs at the far end: a suite that binds a port
# and reads fleet state BY NAME produced fourteen assertion failures — including
# verbatim fail-open security findings — about a tree that was provably fine. It
# cost a merge and fifteen minutes of wrong diagnosis.
#
# So the unit of reuse here is not a helper for the parts that are tedious. It is
# the whole envelope, and every guarantee in it is CHECKED rather than
# constructed-and-assumed:
#
#   1. A PRIVATE HOME THAT CANNOT BE THE DEVELOPER'S. HOME, XDG_CONFIG_HOME and
#      POGO_HOME are pinned under a throwaway root, and then each one is RESOLVED
#      THROUGH SYMLINKS and refused if it lands on, above, or below the real
#      ~/.pogo. POGO_HOME is pinned separately from HOME on purpose: this box
#      exports POGO_HOME=$HOME from a stale profile, so a test that sets only
#      HOME still writes to the live tree — which is mg-5336 exactly.
#
#   2. A PRIVATE PORT THAT CANNOT COLLIDE. Delegated to lib/sandbox-daemon.sh:
#      an O_EXCL reservation rather than a probe, plus a proof that the process
#      answering the port is the one this run started. mg-3412 drew 17731 while
#      another run held it, and spent the rest of the file interrogating a
#      stranger's daemon.
#
#   3. NAMES NO LIVE FLEET COULD HOLD — and, more to the point, no way to use a
#      name that IS one. Every write through pogo_sandbox_curl has its schedule
#      and agent identities checked against this run's token, so registering
#      `mail-check-pa` (which mg-3412's suite really did, and really removed and
#      restored) is refused at the write boundary. Namespacing you have to
#      remember is the thing that failed four times; this one refuses.
#
#   4. A SETUP FAILURE THAT CANNOT BE READ AS A REGRESSION. Everything above
#      ends the run through sandbox_setup_fail: a distinct banner, a distinct
#      exit code (99), and an explicit statement that the run makes NO claim
#      about the tree. mg-3412's cascade printed fourteen assertion failures
#      downstream of one setup failure; that single property would have
#      prevented the misdiagnosis outright.
#
#   5. A PRIVATE HOME THAT DOES NOT COST THE NETWORK, and that is CHECKED for
#      the same reason the rest is. Go resolves both of its caches off $HOME, so
#      the move that makes the home private also empties them: the toolchain pin
#      (mg-cdf1) stopped a ~70 MB toolchain fetch that cost three consecutive
#      60-minute gate timeouts, and the module pin beside it (mg-a9d8) stops the
#      module fetch that made the $TMPDIR guard reach the network on every run —
#      and be reported, when the resolver blinked, as `[setup failed]` in a
#      package that passed in the same gate run. Both read the real environment
#      before the move and then PROVE the pin took under the private HOME, with
#      the network refused so an unproven pin fails in milliseconds rather than
#      reproducing the bug it exists to remove.
#
# WHAT IT DELIBERATELY DOES NOT DO
# --------------------------------
# It does not retry, and it must never learn to: a control that reruns itself on
# failure converts a real regression into a merged one. It does not soften any
# caller's assertion — it fails EARLIER and LOUDER, never later and quieter. And
# it makes no attempt to sandbox things it cannot check; where a guarantee cannot
# be verified it is not claimed (see pogo_sandbox_daemon's note on lsof).
#
# See scripts/pogo-sandbox_test.sh, which breaks each guarantee on purpose and
# reads back what comes out. A harness observed only making tests pass has not
# been observed working.
# =============================================================================

# Idempotent: a suite may source this and a library it already sourced.
if [ -z "${POGO_SANDBOX_SOURCED:-}" ]; then
POGO_SANDBOX_SOURCED=1

POGO_SANDBOX_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The port reservation, the daemon-ownership proof, and sandbox_setup_fail
# (mg-3412). Kept as its own file: it is the layer that has already shipped and
# is already directly exercised by pogo-self-deploy_live_setup_test.sh.
# shellcheck source=/dev/null
. "$POGO_SANDBOX_SCRIPT_DIR/lib/sandbox-daemon.sh"

# THE REAL ONES, CAPTURED BEFORE ANYTHING CAN OVERRIDE THEM. Every check below
# compares against these, so they have to be read at source time — after
# pogo_sandbox_isolate has run there is no way left to ask what the developer's
# home was, and a check that reads the value it just wrote checks nothing.
POGO_SANDBOX_REAL_HOME="${HOME:-}"
POGO_SANDBOX_REAL_POGO_HOME="${POGO_HOME:-$POGO_SANDBOX_REAL_HOME/.pogo}"

# The toolchain the real environment resolves, read by pogo_sandbox_isolate at
# the last instant before the HOME move — NOT at source time, because a caller
# that only ever creates a root should not pay for a `go env` it never uses. See
# the toolchain-pin note above pogo_sandbox_isolate for why sharing this, and
# only this, is the trade that keeps the sandbox private (mg-cdf1).
POGO_SANDBOX_REAL_GOROOT=""
POGO_SANDBOX_REAL_GOVERSION=""

# The module cache the real environment resolves, read at the same instant and
# from the same `go env` call as the toolchain above — one invocation, so the
# three facts cannot disagree with each other. POGO_SANDBOX_MODCACHE_PINNED is
# the answer to "did the pin take?", which a suite reporting a module failure
# has to be able to state rather than guess (mg-a9d8).
POGO_SANDBOX_REAL_GOMODCACHE=""
POGO_SANDBOX_MODCACHE_PINNED=""

# Set by the lifecycle functions. Globals rather than stdout for the same reason
# sandbox-daemon.sh uses globals: these functions can END THE RUN, and
# `X="$(pogo_sandbox_create)"` would run that exit inside a command substitution
# — killing the subshell, handing the caller an empty string, and carrying on
# into the cascade this file exists to prevent.
POGO_SANDBOX_DIR=""
POGO_SANDBOX_TOKEN=""
POGO_SANDBOX_PORT=""
POGO_SANDBOX_URL=""
POGO_SANDBOX_PID=""
POGO_SANDBOX_LOG=""
POGO_SANDBOX_READY=""
POGO_SANDBOX_ISOLATED=""

# pogo_sandbox_fail MSG [LOGFILE] — end the run as INFRASTRUCTURE, loudly.
# The whole of guarantee 4; see sandbox_setup_fail for the banner and the rc.
pogo_sandbox_fail() { sandbox_setup_fail "$@"; }

# ---------------------------------------------------------------------------
# path helpers — everything here resolves SYMLINKS, because the interesting
# failure is the one where $root/home is a link to the developer's home and
# every string comparison says the sandbox is private.
# ---------------------------------------------------------------------------
pogo_sandbox__realpath() {
    local p="$1" d b
    if [ -d "$p" ]; then
        (cd "$p" 2>/dev/null && pwd -P) || printf '%s' "$p"
        return 0
    fi
    d="$(dirname "$p")"; b="$(basename "$p")"
    if [ -d "$d" ]; then
        printf '%s/%s' "$(cd "$d" && pwd -P)" "$b"
    else
        printf '%s' "$p"
    fi
}

# pogo_sandbox__under CHILD PARENT — true if CHILD is PARENT or lives inside it.
pogo_sandbox__under() {
    local child="$1" parent="$2"
    [ -n "$child" ] && [ -n "$parent" ] || return 1
    [ "$child" = "$parent" ] && return 0
    case "$child" in "$parent"/*) return 0 ;; esac
    return 1
}

# pogo_sandbox__reject_live_path PATH WHAT — end the run if PATH is, contains, or
# sits inside the developer's home or live pogo state. Symlinks resolved first:
# the whole point is the case where the string looks private and the inode is not.
pogo_sandbox__reject_live_path() {
    local path="$1" what="$2" resolved real_home real_pogo
    resolved="$(pogo_sandbox__realpath "$path")"
    real_home="$(pogo_sandbox__realpath "$POGO_SANDBOX_REAL_HOME")"
    real_pogo="$(pogo_sandbox__realpath "$POGO_SANDBOX_REAL_POGO_HOME")"

    if [ "$resolved" = "$real_home" ] || pogo_sandbox__under "$real_home" "$resolved"; then
        pogo_sandbox_fail "$what ($path) resolves to $resolved, which IS the developer's home ($real_home) or contains it. Refusing: this directory is removed at teardown."
    fi
    if [ "$resolved" = "$real_pogo" ] || pogo_sandbox__under "$real_pogo" "$resolved" \
        || pogo_sandbox__under "$resolved" "$real_pogo"; then
        pogo_sandbox_fail "$what ($path) resolves to $resolved, which is the developer's live pogo state ($real_pogo), contains it, or lives inside it. Refusing: this directory is removed at teardown."
    fi
}

# ---------------------------------------------------------------------------
# 1. the root and the run token
# ---------------------------------------------------------------------------

# pogo_sandbox_create [LABEL] — make a private root and mint this run's name
# token. Sets $POGO_SANDBOX_DIR and $POGO_SANDBOX_TOKEN. Changes NO environment
# variable, so a caller that wants to build under the real HOME can still do it
# between create and isolate.
#
# THAT WINDOW IS NO LONGER LOAD-BEARING FOR GO, which is worth saying because
# this header used to prescribe it and one suite's download was the standing
# proof that a prescription is not a mechanism: scripts/tmpdir-leak_test.sh calls
# create and isolate back to back, and paid a module fetch on every run for it.
# Both halves of that fetch are now closed by isolate itself — the
# TOOLCHAIN by the pin in section 2 (mg-cdf1), the MODULE GRAPH by the pin beside
# it (mg-a9d8). Neither is a reason to move a build out of the window if it is
# there for its own reasons.
pogo_sandbox_create() {
    local label="${1:-sbx}" root

    root="${POGO_SANDBOX_ROOT:-}"
    if [ -n "$root" ]; then
        mkdir -p "$root" 2>/dev/null \
            || pogo_sandbox_fail "could not create the caller-supplied sandbox root POGO_SANDBOX_ROOT=$root"
    else
        root="$(mktemp -d 2>/dev/null)" \
            || pogo_sandbox_fail "mktemp -d failed — there is no private root to build a sandbox in"
    fi
    [ -n "$root" ] && [ -d "$root" ] \
        || pogo_sandbox_fail "the sandbox root ($root) does not exist after creation"
    [ -w "$root" ] \
        || pogo_sandbox_fail "the sandbox root $root is not writable — nothing below could stage the state it asserts on"

    # THE FIRST CHECK, AND THE ONE WITH TEETH IN THE OTHER DIRECTION. Teardown
    # does `rm -rf` on this root, so a root that resolves onto the developer's
    # home would not merely READ live state — it would delete it. The isolate
    # checks below run too late to help: an EXIT trap installed between create
    # and isolate fires on the very setup failure they raise. So the root is
    # vetted here, before it is stored anywhere anything could remove it from.
    pogo_sandbox__reject_live_path "$root" "the sandbox root"

    POGO_SANDBOX_DIR="$root"

    # The token is what makes guarantee 3 checkable. It has to be unique per run
    # (two concurrent runs must not be able to name the same schedule) and it has
    # to be a string no live fleet would ever hold — hence the `sbx` prefix and
    # the hex, rather than a bare pid, which reads like a number a human might
    # pick. $$ alone is not enough: pids recycle, and a leaked lock outliving a
    # recycled pid is exactly the ambiguity the port lockdir has to prune around.
    POGO_SANDBOX_TOKEN="$(printf 'sbx%s%04x%04x' "$label" "$(( $$ & 0xffff ))" "$(( RANDOM & 0xffff ))")"
    return 0
}

# pogo_sandbox_name BASE — a name namespaced to this run.
# `pogo_sandbox_name pa` is a name only this process can hold; `pa` is a name the
# machine's crew holds right now.
pogo_sandbox_name() {
    [ -n "$POGO_SANDBOX_TOKEN" ] \
        || pogo_sandbox_fail "pogo_sandbox_name was called before pogo_sandbox_create — there is no run token to namespace with, and an un-namespaced name is how a control ends up removing the live fleet's mail-check-pa"
    printf '%s-%s' "$POGO_SANDBOX_TOKEN" "$1"
}

# pogo_sandbox_is_private NAME — true if NAME belongs to this run.
pogo_sandbox_is_private() {
    [ -n "$POGO_SANDBOX_TOKEN" ] || return 1
    case "$1" in *"$POGO_SANDBOX_TOKEN"*) return 0 ;; esac
    return 1
}

# ---------------------------------------------------------------------------
# 2. the private home
# ---------------------------------------------------------------------------

# THE TOOLCHAIN PIN (mg-cdf1). Two halves, run either side of the HOME move,
# because the fact each half needs only exists on its own side of it.
#
# WHAT GOES WRONG WITHOUT IT. Go resolves its module cache off $HOME, so the
# instant isolate moves HOME that cache is EMPTY. With GOTOOLCHAIN=auto (the
# default on this box) and `go 1.25.0` in go.mod, the very next `go` call decides
# it must upgrade and fetches the whole ~70 MB toolchain from Google into a
# directory teardown deletes. It does not take a build to trigger this: a bare
# `go env GOBIN` — which scripts/pogo-self-deploy's resolve_mg does on every
# invocation — is enough. Measured live 2026-08-06 at ~32 KB/s, i.e. ~36 minutes,
# inside ./test.sh, which IS the refinery gate: three consecutive 60-minute gate
# timeouts on one merge, each reported as a verdict on the branch under test.
#
# WHY IT IS NOT JUST `GOTOOLCHAIN=local`, which is what `go version` suggests.
# `go version` prints go1.25.0 because GOTOOLCHAIN=auto has ALREADY switched into
# the cached toolchain module; the toolchain actually INSTALLED here is go1.24.0
# (/opt/homebrew/Cellar/go/1.24.0/libexec), and go.mod needs 1.25.0. A bare
# GOTOOLCHAIN=local would trade a slow sandbox for one where every build fails
# "go.mod requires go >= 1.25.0". So the pin puts the GOROOT the real environment
# ALREADY resolved onto PATH first, and only then says `local` — naming that one.
#
# WHAT IT DOES NOT WEAKEN, which is the half that has to be stated: a fix that
# bought speed with reach would be worse than the bug it cures. HOME,
# XDG_CONFIG_HOME, POGO_HOME and MG_ROOT are untouched and still every one of the
# resolve-checks below runs against them; and nothing here touches the port, the
# daemon, or which base_url the driver resolves — the suite's "driver resolves
# base_url to the sandbox daemon, not the live fleet" assertion is unaffected
# because it is decided by POGO_HOME and $PORT, neither of which moves.

# THE MODULE PIN (mg-a9d8), which is the OTHER half of the same download and was
# left open when the toolchain half was closed. The paragraph above used to end
# by rejecting it; that rejection is withdrawn here, and the measurement that
# withdraws it is recorded because the rejection was reasonable.
#
# WHAT GOES WRONG WITHOUT IT. The same sentence as above — Go resolves GOMODCACHE
# off $HOME, so the instant isolate moves HOME that cache is EMPTY — has a second
# consequence the toolchain pin does not touch: the next build must fetch, from
# proxy.golang.org, every module the packages under test import.
#
# HOW MUCH, MEASURED (2026-08-19, against a file:// proxy served from a clone of
# the real cache, so the count is exact and nothing left the box). One run of
# scripts/tmpdir-leak_test.sh: **2 module zips and 2 .mod files, 752 KB, fetched
# ONCE.** Not six times — the file makes six `go test` invocations but they share
# one sandbox HOME and therefore one cache, so only the second fetches and the
# other five read what it left. This WITHDRAWS the "six times per run" figure the
# ticket carried (mg-b463, never measured); the mechanism is real and the multiple
# is not.
#
# WHICH PACKAGE, AND WHY IT IS ALWAYS THE SAME ONE. The five-package slice fetches
# NOTHING — it imports no external module at all. Every byte is `./internal/agent`,
# which is the only package in this suite with external imports. So the
# misattribution below is not bad luck about which package happened to name the
# unreachable module: this failure mode can only ever name internal/agent.
#
# When the resolver blinked, on 2026-08-14T03:46Z, the row failed as
#
#     internal/agent/terminal.go:9:2: nhooyr.io/websocket@v1.8.17: ...
#       dial tcp: lookup proxy.golang.org: no such host
#     FAIL  github.com/drellem2/pogo/internal/agent [setup failed]
#
# — a network outage wearing the name of a package that, in the same gate run,
# passed. No assertion failed. It was classed DEFECT, which commits to
# "re-running establishes the same fact", and for weather that is false.
#
# WHY THE ORIGINAL REJECTION DOES NOT APPLY TO THE PAIR. The objection was
# specific and correct: the sandbox WRITES to its module cache, and pointed at the
# real one that write lands in the developer's. GOPROXY=off removes the write
# PATH — there is no download, so there is nothing to write. Measured 2026-08-19
# rather than reasoned: an APFS clone of this box's 1.2 GB / 48,124-entry module
# cache, pinned into a sandbox with GOPROXY=off, then a cold-GOCACHE compile and
# run of the tmpdir-leak slice plus ./internal/agent. Every entry's mode, size,
# mtime and ctime was stat'd before and after: ZERO changed, ZERO added.
#
# THE ONE WRITE THAT SURVIVES GOPROXY=off, measured in the same session and named
# here rather than left for the next reader to discover: a module whose ZIP is in
# cache/download but whose tree is NOT extracted is extracted on demand, offline,
# writing that module's own go.sum-verified contents (76 entries for
# nhooyr.io/websocket in the probe). It cannot fetch and it cannot write anything
# the developer's next build would not write itself, but it is a write outside the
# sandbox root, so it is stated. It does not arise in the steady state the gate
# runs in: test.sh's whole-tree `go test ./...` (real HOME) runs at step 2, before
# any sandboxed suite, and leaves every module this build needs extracted.
#
# THE COST THE PIN ADDS, also stated: a module that is in NEITHER the extracted
# tree nor cache/download now fails INSIDE the sandbox with `module lookup
# disabled by GOPROXY=off` instead of being downloaded. That is deterministic and
# offline rather than weather, but it still lands as `[setup failed]` in whichever
# package imports it — so pogo_sandbox_go_module_failure below exists to let a
# suite say what it actually is. The cure is one `go mod download` under the real
# HOME, and on the gate path the step-2 whole-tree run already is one.
#
# WHAT IS SHARED WITH THE REAL HOME, in full, after both pins: the resolved
# toolchain's bin directory, EXECUTED and never written; and the module cache,
# READ and — with the download path off — not written. GOCACHE is deliberately
# NOT pinned: it is written by every compile, and it costs CPU rather than
# network, which is not what this is about.

# pogo_sandbox__capture_go_env — read, while $HOME is still the developer's,
# which toolchain the real environment resolves. After the move there is nothing
# left to ask: the answer is derived from a cache that is now empty.
#
# GOPROXY=off ON THE CAPTURE ITSELF, which is not belt-and-braces: `go env` obeys
# the same toolchain rule everything else does, so a capture run under a HOME
# that is ALREADY cold would trigger the exact download this exists to remove —
# and one caller reaches here in precisely that state, since pogo-sandbox_test.sh
# runs children under decoy HOMEs on purpose. Refused-network is the honest
# question here: "which toolchain does this environment ALREADY have?" A cold
# ambient HOME answers "none", the pin is skipped, and behaviour is what it was.
pogo_sandbox__capture_go_env() {
    local out

    POGO_SANDBOX_REAL_GOROOT=""
    POGO_SANDBOX_REAL_GOVERSION=""

    # No `go` at all is not an error — not every caller of this harness runs one,
    # and a sandbox with no toolchain cannot download one either.
    command -v go >/dev/null 2>&1 || return 0

    # One invocation, so the three cannot disagree with each other.
    out="$(GOPROXY=off go env GOROOT GOVERSION GOMODCACHE 2>/dev/null)" || return 0
    POGO_SANDBOX_REAL_GOROOT="$(printf '%s\n' "$out" | sed -n 1p)"
    POGO_SANDBOX_REAL_GOVERSION="$(printf '%s\n' "$out" | sed -n 2p)"
    POGO_SANDBOX_REAL_GOMODCACHE="$(printf '%s\n' "$out" | sed -n 3p)"
}

# pogo_sandbox__pin_toolchain — apply the pin under the now-private HOME and
# PROVE it took, which is the harness's rule and not decoration here: an
# unproven pin fails as a 36-minute stall an hour downstream, in a gate, wearing
# the branch's name. The proof runs with GOPROXY=off precisely so that a pin that
# did NOT take fails in milliseconds instead of reproducing the bug.
pogo_sandbox__pin_toolchain() {
    local pinned

    [ -n "${POGO_SANDBOX_REAL_GOVERSION:-}" ] || return 0

    if [ -z "$POGO_SANDBOX_REAL_GOROOT" ] || [ ! -x "$POGO_SANDBOX_REAL_GOROOT/bin/go" ]; then
        pogo_sandbox_fail "the real environment resolves $POGO_SANDBOX_REAL_GOVERSION but its GOROOT (${POGO_SANDBOX_REAL_GOROOT:-<empty>}) holds no executable go — refusing to enter the sandbox with an unpinned toolchain, because every \`go\` call inside it would then re-download ~70 MB into a HOME this run deletes (mg-cdf1)"
    fi

    export PATH="$POGO_SANDBOX_REAL_GOROOT/bin:$PATH"
    export GOTOOLCHAIN=local

    # A cold cache by construction — this HOME was created seconds ago — which is
    # the only state the bug appears in, so this check is the one that counts.
    pinned="$(GOPROXY=off go env GOVERSION 2>&1)"
    if [ "$pinned" != "$POGO_SANDBOX_REAL_GOVERSION" ]; then
        pogo_sandbox_fail "the sandbox toolchain pin did not take: under the private HOME \`go env GOVERSION\` said '$pinned', the real environment says '$POGO_SANDBOX_REAL_GOVERSION'. Unpinned, the next \`go\` call in this run downloads a toolchain over the network into a directory teardown removes — ~36 minutes measured, inside a 60-minute gate (mg-cdf1)"
    fi
}

# pogo_sandbox__pin_modcache — point GOMODCACHE at the cache the real
# environment already holds and CLOSE the download path, then prove both took.
# Runs after the toolchain pin, because the proof shells out to `go` and an
# unpinned toolchain would answer that question by downloading one.
#
# Separate from the toolchain pin rather than folded into it, because they fail
# separately: a box can resolve a toolchain and hold no module cache, and the
# right answer in that case is the behaviour we already had, not a refusal.
#
# Failing OPEN on an absent cache is deliberate and is the one place this
# function is quieter than pogo_sandbox__pin_toolchain. An unpinned toolchain is
# a 36-minute stall; an unpinned module cache is the download this exists to
# remove, which is exactly what happens today and on every box with no cache to
# share there is nothing better available. POGO_SANDBOX_MODCACHE_PINNED records
# which of the two happened so a suite can say so instead of inferring it.
pogo_sandbox__pin_modcache() {
    local out pinned proxy

    POGO_SANDBOX_MODCACHE_PINNED=""

    # No `go`, or a capture that declined (a cold ambient HOME answers "none"),
    # leaves the sandbox exactly as it was before this pin existed.
    [ -n "${POGO_SANDBOX_REAL_GOMODCACHE:-}" ] || return 0
    [ -d "$POGO_SANDBOX_REAL_GOMODCACHE" ] || return 0

    # A cache INSIDE the sandbox root is not the developer's — it is this run's
    # own, teardown removes it, and pinning to it would be the empty cache with
    # extra steps. It cannot happen through the capture (that reads the real
    # environment before the move) but it can through a caller's own GOMODCACHE.
    if pogo_sandbox__under "$(pogo_sandbox__realpath "$POGO_SANDBOX_REAL_GOMODCACHE")" \
            "$(pogo_sandbox__realpath "$POGO_SANDBOX_DIR")"; then
        return 0
    fi

    export GOMODCACHE="$POGO_SANDBOX_REAL_GOMODCACHE"
    # The half that makes the pin safe rather than merely fast: no download path,
    # therefore no write into the developer's cache. See the module-pin note in
    # section 2 for the measurement, and for the one write that survives it.
    export GOPROXY=off

    # PROVEN, for the same reason the toolchain pin is proven: an unproven pin
    # fails as a network dependency an hour downstream, wearing the branch's name.
    # Both halves are read back, because either alone is the bug: the cache
    # without the proxy off writes to the developer's, and the proxy off without
    # the cache turns every sandboxed build into an immediate hard failure.
    # One invocation for both, so the pair cannot disagree with itself — the same
    # rule the capture above follows.
    out="$(go env GOMODCACHE GOPROXY 2>&1)"
    pinned="$(printf '%s\n' "$out" | sed -n 1p)"
    proxy="$(printf '%s\n' "$out" | sed -n 2p)"

    if [ "$pinned" != "$POGO_SANDBOX_REAL_GOMODCACHE" ]; then
        pogo_sandbox_fail "the sandbox module-cache pin did not take: under the private HOME \`go env GOMODCACHE\` said '$pinned', the real environment says '$POGO_SANDBOX_REAL_GOMODCACHE'. Unpinned, every build in this sandbox must fetch what it imports from proxy.golang.org — 752 KB on every run of the \$TMPDIR guard, measured — and a resolver that blinks mid-fetch is reported as \`[setup failed]\` in whichever package imports the module it could not reach (mg-a9d8)"
    fi
    if [ "$proxy" != "off" ]; then
        pogo_sandbox_fail "the sandbox pinned GOMODCACHE to the developer's cache ($POGO_SANDBOX_REAL_GOMODCACHE) but \`go env GOPROXY\` says '$proxy', not 'off' — with a download path open a fetch inside this run would WRITE into that cache, which is the hazard the pin was refused over until GOPROXY=off removed it (mg-a9d8)"
    fi

    POGO_SANDBOX_MODCACHE_PINNED=1
    return 0
}

# pogo_sandbox_go_module_failure LOGFILE — if LOGFILE holds a Go MODULE
# RESOLUTION failure, print what it actually was and return 0. Otherwise print
# nothing and return 1.
#
# This exists because of what the failure looks like when it is NOT translated.
# The 2026-08-14 instance surfaced as
#
#   Test 5: repeated runs do not grow the testtmp root
#     FAIL: SETUP: the fixture-creating suite did not pass on the third run
#
# over a log whose real content was `lookup proxy.golang.org: no such host` and
# `FAIL github.com/drellem2/pogo/internal/agent [setup failed]`. Read at the top,
# that is a $TMPDIR or concurrency problem in internal/agent — a package that in
# the same gate run passed in 358s. It cost the mayor a held worker slot
# (2026-08-14 03:57Z), pm-pogo a withdrawn hypothesis, and p82a6 an initial
# mis-scoping. The refinery learned to classify the network case for itself
# (mg-67c9); this is the same repair one layer down, where the suite's own words
# are what a person reads first.
#
# It reports the CONFIGURATION case too, which mg-67c9 deliberately does not
# treat as network: with the module pin above, `module lookup disabled by
# GOPROXY=off` means the pinned cache does not hold something this tree imports,
# and the fix is a `go mod download` under the real HOME — not a re-run, and
# nothing to do with the package the compiler named.
pogo_sandbox_go_module_failure() {
    local log="$1" cache="${POGO_SANDBOX_REAL_GOMODCACHE:-<unpinned>}"

    [ -n "$log" ] && [ -r "$log" ] || return 1

    if grep -qE 'module lookup disabled by GOPROXY=off' "$log" 2>/dev/null; then
        printf 'NOT A DEFECT IN THE PACKAGE NAMED ABOVE: this is a MODULE CACHE MISS.\n'
        printf '  The sandbox pins GOMODCACHE at %s and sets GOPROXY=off, so a module\n' "$cache"
        printf '  that cache does not hold cannot be fetched and the compiler reports it as\n'
        printf '  [setup failed] in whichever package imports it. Re-running changes nothing.\n'
        printf '  Fix: run `go mod download` (or any build) under your REAL HOME, then re-run.\n'
        grep -E 'module lookup disabled|^go: downloading|\[setup failed\]' "$log" 2>/dev/null \
            | head -8 | sed 's/^/    /'
        return 0
    fi

    if grep -qiE 'proxy\.golang\.org|sum\.golang\.org|^go: downloading' "$log" 2>/dev/null &&
        grep -qiE 'no such host|dial tcp|i/o timeout|tls handshake timeout|connection reset|connection refused|server misbehaving' "$log" 2>/dev/null; then
        printf 'NOT A DEFECT IN THE PACKAGE NAMED ABOVE: this is a NETWORK failure fetching modules.\n'
        printf '  The Go toolchain could not reach the module proxy. The package the compiler\n'
        printf '  named is the one that imports the unreachable module, not the one at fault —\n'
        printf '  re-running is a coin flip against the weather, not a repeated measurement.\n'
        printf '  This sandbox pins GOMODCACHE (%s) precisely so this cannot\n' "$cache"
        printf '  happen; seeing it means the pin did not take or the cache is missing a module.\n'
        grep -iE 'proxy\.golang\.org|no such host|dial tcp|i/o timeout|\[setup failed\]' "$log" 2>/dev/null \
            | head -8 | sed 's/^/    /'
        return 0
    fi

    return 1
}

# pogo_sandbox_isolate — pin HOME / XDG_CONFIG_HOME / POGO_HOME under the root,
# then PROVE none of them can reach the developer's state. Ends the run if any
# check fails.
#
# The three variables are set separately and checked separately because they fail
# separately. HOME alone leaks POGO_HOME on this box (a stale profile exports
# POGO_HOME=$HOME) and leaks config.toml through XDG (config is layered, so the
# real user config is read even under a private HOME — mg-cf9e).
pogo_sandbox_isolate() {
    local var val resolved real_home real_pogo root

    [ -n "$POGO_SANDBOX_DIR" ] \
        || pogo_sandbox_fail "pogo_sandbox_isolate was called before pogo_sandbox_create — there is no private root to point HOME at"

    real_home="$(pogo_sandbox__realpath "$POGO_SANDBOX_REAL_HOME")"
    real_pogo="$(pogo_sandbox__realpath "$POGO_SANDBOX_REAL_POGO_HOME")"
    root="$(pogo_sandbox__realpath "$POGO_SANDBOX_DIR")"

    # Before the move, for the same reason real_home is read before the move.
    pogo_sandbox__capture_go_env

    export HOME="$POGO_SANDBOX_DIR/home"
    export XDG_CONFIG_HOME="$POGO_SANDBOX_DIR/xdg"
    export POGO_HOME="$POGO_SANDBOX_DIR/home/.pogo"
    # Belt to the no-config-file braces: with no config.toml pogod starts no crew,
    # but a caller that stages one should still not get the machine's fleet.
    export POGO_AGENT_AUTOSTART=false
    # A sandbox that reaches the live mail store is not a sandbox: stallwatch and
    # the mg client root off the real $HOME unless told otherwise, so a control
    # that sends mail would land it in ~/.macguffin/mail (mg-9a1c).
    export MG_ROOT="$POGO_SANDBOX_DIR/home/.macguffin"

    mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$POGO_HOME" 2>/dev/null \
        || pogo_sandbox_fail "could not create the sandbox HOME/XDG_CONFIG_HOME/POGO_HOME under $POGO_SANDBOX_DIR"

    for var in HOME XDG_CONFIG_HOME POGO_HOME MG_ROOT; do
        eval "val=\"\$$var\""
        resolved="$(pogo_sandbox__realpath "$val")"

        # The check that catches the symlinked root, which is the only shape in
        # which this goes wrong quietly: every string here reads as a private
        # path right up until something follows the link.
        if pogo_sandbox__under "$resolved" "$real_pogo" || pogo_sandbox__under "$real_pogo" "$resolved"; then
            pogo_sandbox_fail "the sandbox's \$$var resolves to $resolved, which is the developer's live pogo state ($real_pogo) or contains it — the tests would be reading and WRITING the machine's real ~/.pogo, which is mg-6092/mg-e8e7/mg-5336 verbatim"
        fi
        if [ "$resolved" = "$real_home" ] || pogo_sandbox__under "$real_home" "$resolved"; then
            pogo_sandbox_fail "the sandbox's \$$var resolves to $resolved, which is the developer's home ($real_home) or contains it — this is not a sandbox"
        fi
        if ! pogo_sandbox__under "$resolved" "$root"; then
            pogo_sandbox_fail "the sandbox's \$$var resolves to $resolved, which is outside the sandbox root $root — it was not created by this run and nothing here owns its contents"
        fi
    done

    # A just-created POGO_HOME holds nothing. If this one holds something, it is
    # not the directory we think it is — and the cheapest moment to learn that is
    # now, not from a control asserting on park state it did not stage.
    if [ -n "$(ls -A "$POGO_HOME" 2>/dev/null)" ]; then
        pogo_sandbox_fail "the sandbox POGO_HOME ($POGO_HOME) is not empty — a freshly created one is, so this directory predates this run and its contents are somebody else's state"
    fi

    # Last, and deliberately after the checks above rather than among them: the
    # pins are about what the sandbox COSTS, not about what it can reach, and
    # they must not be able to satisfy or mask a privacy check. In this order
    # because the module pin's proof shells out to `go`, and an unpinned
    # toolchain answers a `go env` by downloading one.
    pogo_sandbox__pin_toolchain
    pogo_sandbox__pin_modcache

    POGO_SANDBOX_ISOLATED=1
    return 0
}

# ---------------------------------------------------------------------------
# 3. the private daemon
# ---------------------------------------------------------------------------

# pogo_sandbox_daemon BIN READY_PATH [LOGFILE] — reserve a port (once per run)
# and start a pogod that has been PROVEN to be ours. Sets $POGO_SANDBOX_PORT,
# $POGO_SANDBOX_URL, $POGO_SANDBOX_PID, $POGO_SANDBOX_LOG.
#
# Safe to call again after pogo_sandbox_daemon_kill: the port reservation is held
# until teardown on purpose, so a control that kills its daemon to prove what a
# dead one reports can start a successor on the SAME port without racing anyone
# for it.
pogo_sandbox_daemon() {
    local bin="$1" ready="$2" log="${3:-}"

    [ -n "$POGO_SANDBOX_DIR" ] \
        || pogo_sandbox_fail "pogo_sandbox_daemon was called before pogo_sandbox_create"
    [ -n "$POGO_SANDBOX_ISOLATED" ] \
        || pogo_sandbox_fail "pogo_sandbox_daemon was called before pogo_sandbox_isolate — a daemon started under the developer's HOME would read, spawn from, and write to the live ~/.pogo whatever port it bound"
    [ -x "$bin" ] \
        || pogo_sandbox_fail "the sandbox daemon binary ($bin) is missing or not executable"

    if [ -z "$POGO_SANDBOX_PORT" ]; then
        sandbox_port_reserve
        POGO_SANDBOX_PORT="$SANDBOX_PORT"
        POGO_SANDBOX_URL="http://127.0.0.1:$POGO_SANDBOX_PORT"
    fi

    POGO_SANDBOX_LOG="${log:-$POGO_SANDBOX_DIR/pogod.log}"
    POGO_SANDBOX_READY="$ready"
    sandbox_daemon_start "$bin" "$POGO_SANDBOX_PORT" "$POGO_SANDBOX_LOG" "$ready"
    POGO_SANDBOX_PID="$SANDBOX_DAEMON_PID"
    return 0
}

# pogo_sandbox_daemon_kill — stop the sandbox daemon and do not return until the
# port has actually gone quiet. Keeps the reservation (see above). Safe to call
# twice.
#
# The readiness path is polled rather than `/`, because a control that kills its
# daemon to observe what a DEAD one reports needs the endpoint it will read to be
# the endpoint proven silent — `/` 404s on a perfectly live pogod, so a poll
# against it would return at once and hand the control a daemon still answering.
pogo_sandbox_daemon_kill() {
    local i
    [ -n "$POGO_SANDBOX_PID" ] || return 0
    kill "$POGO_SANDBOX_PID" 2>/dev/null
    wait "$POGO_SANDBOX_PID" 2>/dev/null
    POGO_SANDBOX_PID=""
    for i in $(seq 1 40); do
        curl -sf --max-time 1 "$POGO_SANDBOX_URL${POGO_SANDBOX_READY:-/}" >/dev/null 2>&1 || return 0
        sleep 0.25
    done
    return 0
}

# pogo_sandbox_assert_no_schedules — a just-booted sandbox pogod holds nothing.
# Independent of lsof and of the process table: it interrogates the STATE, so it
# still bites where the ownership proof cannot look (another user's socket).
pogo_sandbox_assert_no_schedules() {
    [ -n "$POGO_SANDBOX_URL" ] || return 0
    if [ -n "$(curl -sf --max-time 5 "$POGO_SANDBOX_URL/scheduler/schedules" 2>/dev/null | grep -o '"id":"[^"]*"')" ]; then
        pogo_sandbox_fail "the daemon on $POGO_SANDBOX_URL already holds schedules — a just-booted sandbox pogod holds none, so this is not our daemon and nothing below would be measuring the tree under test" "$POGO_SANDBOX_LOG"
    fi
}

# ---------------------------------------------------------------------------
# 4. writes to the sandbox, with the name guard
# ---------------------------------------------------------------------------

# pogo_sandbox_curl DESC -- <curl args> — stage state in the sandbox daemon.
#
# Two jobs, and they are the two halves of mg-3412's cascade:
#
#   * A failed staging call ends the run as INFRASTRUCTURE. These calls are
#     scaffolding; when one fails the state was never staged, so every assertion
#     after it is measuring something other than what its text claims. The
#     incident's first line was "could not remove mail-check-pa from the sandbox
#     daemon" and the next thirteen buried it.
#
#   * A staging call may only name THIS RUN's schedules and agents. The identity
#     in `{"id":...}` / `{"agent":...}`, and the trailing path segment of a
#     /scheduler/schedules/<id> URL, must carry the run token. So the literal
#     write mg-3412 performed — removing and restoring a schedule named
#     `mail-check-pa`, which is a real crew loop — is refused HERE, at the write
#     boundary, rather than being left to whoever remembers.
#
# It is NOT for anything the code under test does. The driver's own curls run
# exactly as shipped and their failures are still the control's verdict — a
# control that kills its daemon needs those to fail. Guarding the scaffolding is
# not guarding the instrument, and only the first is done here.
pogo_sandbox_curl() {
    local desc="$1"; shift
    [ "${1:-}" = "--" ] && shift
    pogo_sandbox__assert_private_args "$desc" "$@"
    curl -sf --max-time 10 "$@" >/dev/null 2>&1 \
        || pogo_sandbox_fail "$desc — the sandbox daemon on $POGO_SANDBOX_URL did not accept it, so the state the controls below assert on was never staged"
}

# pogo_sandbox__assert_private_args DESC ARGS... — refuse a write that names
# anything outside this run. Deliberately conservative about WHAT it inspects
# (schedule/agent identities and the schedules-collection path) and absolute
# about the verdict once it finds one: an identity that does not carry the token
# is a name some live fleet may hold, and there is no safe way to guess which.
pogo_sandbox__assert_private_args() {
    local desc="$1"; shift
    local arg name tail names

    [ -n "$POGO_SANDBOX_TOKEN" ] || return 0

    for arg in "$@"; do
        case "$arg" in
            */scheduler/schedules/*)
                tail="${arg##*/scheduler/schedules/}"
                if [ -n "$tail" ] && ! pogo_sandbox_is_private "$tail"; then
                    pogo_sandbox__name_fail "$desc" "$tail" "the URL path"
                fi
                ;;
        esac
        case "$arg" in
            *'"id"'*|*'"agent"'*)
                names="$(printf '%s' "$arg" \
                    | grep -oE '"(id|agent)"[[:space:]]*:[[:space:]]*"[^"]*"' \
                    | sed -e 's/.*"\([^"]*\)"$/\1/')"
                while IFS= read -r name; do
                    [ -n "$name" ] || continue
                    pogo_sandbox_is_private "$name" && continue
                    pogo_sandbox__name_fail "$desc" "$name" "the request body"
                done <<<"$names"
                ;;
        esac
    done
}

pogo_sandbox__name_fail() {
    local desc="$1" name="$2" where="$3"
    pogo_sandbox_fail "$desc — refused: $where names '$name', which is not namespaced to this run (token '$POGO_SANDBOX_TOKEN'). A sandbox write may only touch names this run minted, because a real fleet can hold the others: mg-3412's suite removed and restored a schedule literally called 'mail-check-pa'. Use \"\$(pogo_sandbox_name <base>)\"."
}

# ---------------------------------------------------------------------------
# teardown
# ---------------------------------------------------------------------------

# pogo_sandbox_down — kill the daemon, release the port claim, remove the root.
# Safe from an EXIT trap and safe to call twice.
pogo_sandbox_down() {
    if [ -n "$POGO_SANDBOX_PID" ]; then
        kill "$POGO_SANDBOX_PID" 2>/dev/null
        wait "$POGO_SANDBOX_PID" 2>/dev/null
        POGO_SANDBOX_PID=""
    fi
    sandbox_port_release
    if [ -n "$POGO_SANDBOX_DIR" ] && [ -d "$POGO_SANDBOX_DIR" ]; then
        # Re-vetted at the moment of removal, not just at creation: the root may
        # have GAINED a link to live state while the run was using it, and this
        # is the last instant before an rm -rf that cannot be taken back.
        pogo_sandbox__reject_live_path "$POGO_SANDBOX_DIR" "the sandbox root being torn down"
        # A `go` call under the sandbox HOME materialises modules into
        # $root/home/go/pkg/mod, and Go marks the module cache 0444 by design —
        # so a plain rm -rf fails "Permission denied" on every file and litters
        # the temp dir each run (mg-e91e). Still required after the mg-cdf1
        # toolchain pin: the pin stops the TOOLCHAIN being fetched here, not the
        # module cache from being written here.
        chmod -R u+w "$POGO_SANDBOX_DIR" 2>/dev/null
        rm -rf "$POGO_SANDBOX_DIR"
    fi
    POGO_SANDBOX_DIR=""
}

# pogo_sandbox_up BIN READY_PATH [LABEL] — create + isolate + daemon, for the
# common case where nothing has to be built under the real HOME first.
pogo_sandbox_up() {
    local bin="$1" ready="$2" label="${3:-sbx}"
    pogo_sandbox_create "$label"
    pogo_sandbox_isolate
    pogo_sandbox_daemon "$bin" "$ready"
}

fi  # POGO_SANDBOX_SOURCED

# =============================================================================
# EXECUTABLE FRONT END
# =============================================================================
# For tests that are not written in shell. `run` is the one that matters: it puts
# a command inside the same envelope the shell API gives, so a Go suite becomes
# hermetic without every _test.go re-deriving the override set — which is what
# mg-6092, mg-e8e7 and mg-5336 each did by hand.
#
# Setup failures keep their exit code here too, so a caller can still tell "the
# suite never ran" from "the suite ran and found something" (99 vs whatever the
# command exits).
# =============================================================================
pogo_sandbox__usage() {
    cat <<'USAGE'
pogo-sandbox — packaged test isolation for pogo (mg-78a5)

  scripts/pogo-sandbox run [--daemon BIN] [--ready PATH] [--label NAME] -- CMD [ARGS...]
      Run CMD with a private HOME/XDG_CONFIG_HOME/POGO_HOME/MG_ROOT (and, with
      --daemon, a private pogod on a reserved port, exported as POGO_PORT).
      Exits with CMD's status; exits 99 if the sandbox could not be established.

  scripts/pogo-sandbox env [--label NAME]
      Print the sandbox environment as `export` lines. The caller owns the root
      it prints (POGO_SANDBOX_DIR) and must remove it.

  source scripts/pogo-sandbox
      The shell API: pogo_sandbox_create / _isolate / _daemon / _name / _curl /
      _down, plus pogo_sandbox_go_module_failure for translating a Go module
      fetch failure into what it actually is. See the header of this file.
USAGE
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    set -u
    pogo_sandbox__main() {
        local mode="${1:-}"; shift || true
        local daemon_bin="" ready="/scheduler/schedules" label="sbx" rc=0

        case "$mode" in
            run)
                while [ $# -gt 0 ]; do
                    case "$1" in
                        --daemon) daemon_bin="${2:-}"; shift 2 ;;
                        --ready)  ready="${2:-}"; shift 2 ;;
                        --label)  label="${2:-}"; shift 2 ;;
                        --)       shift; break ;;
                        *)        pogo_sandbox__usage >&2; exit 2 ;;
                    esac
                done
                [ $# -gt 0 ] || { pogo_sandbox__usage >&2; exit 2; }

                pogo_sandbox_create "$label"
                trap pogo_sandbox_down EXIT
                pogo_sandbox_isolate
                if [ -n "$daemon_bin" ]; then
                    pogo_sandbox_daemon "$daemon_bin" "$ready"
                    export POGO_PORT="$POGO_SANDBOX_PORT"
                fi
                export POGO_SANDBOX_DIR POGO_SANDBOX_TOKEN POGO_SANDBOX_PORT POGO_SANDBOX_URL
                "$@" || rc=$?
                exit "$rc"
                ;;
            env)
                while [ $# -gt 0 ]; do
                    case "$1" in
                        --label) label="${2:-}"; shift 2 ;;
                        *)       pogo_sandbox__usage >&2; exit 2 ;;
                    esac
                done
                pogo_sandbox_create "$label"
                pogo_sandbox_isolate
                printf 'export HOME=%s\n' "$HOME"
                printf 'export XDG_CONFIG_HOME=%s\n' "$XDG_CONFIG_HOME"
                printf 'export POGO_HOME=%s\n' "$POGO_HOME"
                printf 'export MG_ROOT=%s\n' "$MG_ROOT"
                printf 'export POGO_AGENT_AUTOSTART=false\n'
                printf 'export POGO_SANDBOX_DIR=%s\n' "$POGO_SANDBOX_DIR"
                printf 'export POGO_SANDBOX_TOKEN=%s\n' "$POGO_SANDBOX_TOKEN"
                ;;
            -h|--help|help|"")
                pogo_sandbox__usage ;;
            *)
                pogo_sandbox__usage >&2; exit 2 ;;
        esac
    }
    pogo_sandbox__main "$@"
fi

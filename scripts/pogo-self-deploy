#!/bin/bash
# pogo-self-deploy — out-of-band pogod redeployer (mg-6afa / mg-cae1).
#
# IT DEPLOYS THE CLI TOO, AND THAT IS NOT A CONVENIENCE (mg-ddf1)
# --------------------------------------------------------------
# `do_build` installs every binary in DEPLOYED_CMDS — today `pogod` AND `pogo`.
# The CLI belongs here and nowhere else. A `pogo` newer than the running `pogod`
# risks a protocol mismatch that breaks the tooling every agent depends on,
# mid-flight (mg-49bc). A redeploy is the exact moment pogod moves to main's
# revision — which makes it the one moment the CLI can move safely, and the
# reason installing it at any OTHER time is the hazard. Lockstep, by design.
#
# Before this, `do_build` installed ./cmd/pogod alone, so no code path installed
# the CLI at all: every cmd/pogo change was merged and dark, indefinitely, with
# no signal. Not a staleness window — an absence. The CLI sat three days behind
# main while the drift check called the box clean, because it too read only the
# daemon. If you add a binary to DEPLOYED_CMDS, the drift check covers it for
# free; that coupling is deliberate, and it is what stops this recurring.
#
# WHY THIS IS A STANDALONE SCRIPT, NOT A pogod OR pogo SUBCOMMAND
# ---------------------------------------------------------------
# A thing that replaces or supervises X cannot live inside X — not inside X's
# process tree, and not inside X's change-surface (architect ruling, mg-6afa).
# pogod redeploys pogod; if the redeployer shipped *with* pogod (as a `pogod`
# or `pogo` subcommand) it would churn on every pogod change and could ship
# broken exactly when you need it to fix a broken pogod — a deploy path you
# cannot fix without the deploy path. So this is a deliberately thin, rarely-
# touched script that calls only STABLE primitives: curl, go install,
# launchctl kickstart, git rev-parse, mg unclaim. Keep it dumb.
#
# It also must run OUT OF BAND — not as a descendant of pogod — because the
# redeploy kickstart -k kills pogod's entire process tree. A human runs it
# today; a healthy-launchd one-shot may run it later (mg-6afa sequencing).
# That is ENFORCED, not merely asserted: assert_out_of_band refuses a caller
# inside pogod's tree, on cmd_redeploy's first line (mg-1bbf). It was prose
# alone until then — the one constraint in a script with sixteen refusal paths
# that nothing checked.
#
# A redeploy PROVES THE DETECTOR BEFORE IT TRUSTS IT (do_prove, mg-bfe5). After
# the build and before the kickstart, every run stands the live control up
# against the artifact it is about to deploy and refuses to proceed unless the
# mail-check post-check is observed going RED on a broken fleet AND GREEN on an
# intact one. do_build runs `go install` and no tests, so without this a redeploy
# ships a pogod whose detector has never been exercised against it; a merge-time
# pass is a claim about a commit, not a measurement of the artifact. It adds ~2min
# to a redeploy, inside the drain window. A refusal exits with the drain trap
# still armed, so the old pogod keeps running and dispatching.
#
# USAGE
#   pogo-self-deploy check                 # three-way drift report; NEVER acts
#   pogo-self-deploy redeploy [flags]      # guarded rebuild+prove+restart
#
# redeploy flags:
#   --yes                 proceed without the interactive confirmation prompt
#   --force               permit a HARD BOUNCE the drain would otherwise refuse.
#                         Two refusals, both overridden by this flag:
#                           - polecats still holding commits that exist only in
#                             their worktree after the drain timeout (kills them,
#                             then cleans up claims + worktrees)
#                           - the drain could not establish whether the fleet is
#                             idle: pogod went silent or unreadable mid-drain and
#                             the on-disk witness could not settle it (mg-65b2)
#                         Default REFUSES both — the fleet-kill footgun must be
#                         explicit (mg-6afa MVP). On the second, --force means
#                         "I know it's wedged, bounce it anyway".
#   --skip-drain          skip the drain phase entirely and go straight to
#                         rebuild+restart. Required to self-deploy ONTO a pogod
#                         that predates the /agents/drain endpoint (mg-cae1) —
#                         the one-time bootstrap chicken-and-egg (mg-065e). Also
#                         usable when the operator knows the fleet is idle.
#   --drain-timeout SECS  how long to wait for the refinery's outstanding merges
#                         to land (default 1800). NOT how long to wait for
#                         polecats to finish — see WHAT THE DRAIN WAITS FOR below.
#   --repo PATH           pogo source repo to build from (see repo resolution)
#   --port N              pogod HTTP port (default $POGO_PORT or 10000)
#
# ENV overrides: POGO_PORT, POGO_REPO, POGO_DAEMON_LABEL (default
# com.pogo.daemon), POGO_DEPLOY_REF (default main), LAUNCHCTL, POGO_GOBIN,
# POGO_DEPLOY_MERGE_TARGETS (the refs a branch must be contained in to count as
# merged; default "refs/remotes/origin/main refs/remotes/origin/master"),
# POGO_DEPLOY_REASON_FILE.
#
# WHAT THE DRAIN WAITS FOR (mg-853a, re-aimed by mg-3a96)
# -------------------------------------------------------
# The drain does NOT wait for polecats to exit, and it does NOT wait for the
# refinery. It waits for every polecat that would LOSE WORK if it were stopped
# right now — one whose worktree holds commits that exist nowhere but there — and
# for nothing else. A polecat running a four-hour analysis does not hold the
# deploy. Neither does a polecat that pushed and is waiting on the merge queue:
# pushing is what makes work DURABLE, so that polecat is the safest thing in the
# fleet to stop, and mg-853a had it exactly backwards — one such branch held an
# entire deploy for 7,200s on 2026-08-06 while being safe to interrupt the whole
# time. The full argument, including why this script rather than pogod is the
# site, is at THE DRAIN PREDICATE, beside the code.
#
# HOW A FAILURE IS REPORTED (mg-0155)
#   An exit code says WHERE the run stopped. It does not say WHY, and it must
#   not be asked to: codes are assigned per site, stories are needed per cause,
#   and every attempt to carry the second on the first has misreported the next
#   failure that shared a code. So a `redeploy` writes a reason record — the
#   failing sentence it already computed, the stage it reached, and whether
#   anything had been installed by then — to $POGO_DEPLOY_REASON_FILE, and the
#   unattended runner (scripts/launchd/pogo-deploy.sh) reads THAT into its alert
#   instead of re-deriving a story from an integer. Unset the variable and
#   nothing is written; a human at a terminal is already reading the stderr the
#   record is a copy of.
#
#   docs/deploy-exit-paths.md enumerates every exit in this script: what the
#   operator is told at each, and whether an install had happened by then.

set -u

# ---------------------------------------------------------------------------
# Config / stable primitives
# ---------------------------------------------------------------------------
PORT="${POGO_PORT:-10000}"
DAEMON_LABEL="${POGO_DAEMON_LABEL:-com.pogo.daemon}"
DEPLOY_REF="${POGO_DEPLOY_REF:-main}"
LAUNCHCTL="${LAUNCHCTL:-launchctl}"
# The `pogo` CLI, used for ONE thing: asking the on-disk polecat witness whether
# any polecat is alive when pogod has stopped answering (drain_wait, mg-65b2).
# A variable rather than a bare `pogo` for the same reason LAUNCHCTL is one — the
# live control has to point it at a sandbox artifact instead of the machine's
# installed binary, and PATH games in a script that runs as root at 03:00 are a
# worse seam. See witness_alive_count for why this hop is not a header violation.
POGO_CLI="${POGO_CLI:-pogo}"
DRAIN_TIMEOUT=1800
# How long verify_mail_checks_restored polls for the new pogod to finish loading
# its schedules. A variable rather than a literal so the live control
# (pogo-self-deploy_live_test.sh) can drive the RED and UNKNOWN verdicts without
# burning the full window per assertion. It changes how many times the check
# probes, never what a probe does — the seam under test (curl -> parse ->
# classify -> report) is identical either way.
MAIL_CHECK_TIMEOUT=30
FORCE=false
ASSUME_YES=false
SKIP_DRAIN=false
REPO="${POGO_REPO:-}"

# ---------------------------------------------------------------------------
# The reason channel (mg-0155)
# ---------------------------------------------------------------------------
# THE ONE FACT THIS SCRIPT OWNS AND USED TO THROW AWAY. Every refusal below
# already computes the correct operator-facing sentence — "unexpected HTTP 503
# from POST /agents/drain; refusing to proceed", "$n polecat(s) still active
# after ${DRAIN_TIMEOUT}s drain timeout", "go install failed" — writes it to
# stderr, and then exits with an integer. The unattended runner
# (scripts/launchd/pogo-deploy.sh) is a separate process; the only thing that
# crossed the boundary was that integer, so the runner had to RE-DERIVE a
# sentence from it, and it re-derived the wrong one whenever a code covered more
# than one cause.
#
# That is a generator, not an incident. Exit codes are assigned per SITE; the
# operator's story is needed per CAUSE. So every new failure path must either
# reuse a code (and silently inherit a story about a different failure — exit 6
# on 2026-08-07) or mint a fresh integer plus a hand-written paragraph (mg-0d70's
# exit 10). Four generations of this defect have now been fixed one exit path at
# a time: mg-8f7e, mg-65b2, mg-0d70, and 2026-08-07's exit 6.
#
# So: carry the reason instead of re-deriving it. Nothing here decides what to
# say — the refusal sites already did that. This machinery only makes sure the
# sentence they wrote is the sentence the operator reads.
#
# STRUCTURAL, NOT PER-SITE. The record is assembled by an EXIT trap out of two
# things that accumulate on their own: every line `err` has emitted, and the
# stage the run had reached. No exit site has to remember to call anything, so a
# path added next year is covered by having been written at all — which is the
# property the four point-fixes did not have.
#
# POGO_DEPLOY_REASON_FILE — where to write it. Unset (a human at a terminal) and
# nothing is written: they are reading the stderr this is a copy of.
REASON_FILE="${POGO_DEPLOY_REASON_FILE:-}"
# ERR_LOG — a FILE, not an array, because `err` is called from inside command
# substitutions (witness_alive_count, drain_wait's helpers) whose variable
# assignments die with the subshell. Appends from a subshell land in the parent's
# file.
ERR_LOG=""
# Where the run got to, and what it had changed by then. These are the two
# questions the 03:00 alert answered wrongly, so they are fields rather than
# prose: `installed` is what stops a remedy asserting an install that never
# happened, whichever code the run exits with.
DEPLOY_STAGE="startup"
DEPLOY_INSTALLED="no"     # no | partial | yes

ts()   { date -u +%Y-%m-%dT%H:%M:%SZ; }
log()  { echo "[$(ts)] $*"; }
# Every err line is tagged with the stage it was emitted in. That tag is what
# lets the record pick a headline without guessing: see deploy_reason_record.
err()  { echo "[$(ts)] ERROR: $*" >&2; [ -n "$ERR_LOG" ] && printf '%s\t%s\n' "$DEPLOY_STAGE" "$*" >> "$ERR_LOG"; return 0; }
short(){ printf '%s' "${1:0:12}"; }

# deploy_stage STAGE — advance the run's stage marker, and say so in the log.
#
# The stage is not decoration: it is how the record answers "how far did this run
# get?" without every exit site being asked to declare it.
deploy_stage() {
    DEPLOY_STAGE="$1"
    log "stage: $1"
}

# deploy_reason_record CODE — write the record the runner reads. Called from the
# EXIT trap, so it runs on EVERY exit including 0 and including the signal paths
# that convert themselves into exits.
#
# FORMAT. Single-line `key=value` header, then a separator, then the verbatim
# stderr transcript. Deliberately not JSON: this script is jq-free on purpose
# (one fewer dependency in the path that must work when everything else is
# broken) and the runner reads it with the same seds it uses everywhere else.
#
#   exit=6
#   stage=drain
#   installed=no
#   reason=<the FIRST line err emitted — the headline, not the elaboration>
#   --- verbatim ---
#   <every err line, in order>
#
# CHOOSING THE HEADLINE. reason= is the FIRST err line emitted in the stage the
# run ENDED in. Two wrong rules were available and both are worth naming, since
# a headline is the part of an alert that travels:
#
#   - the last line overall: every refusal here is written headline-first, cause
#     then remedy, so the last line is the remedy. The 503 refusal would have
#     been described to the operator as "confirm with: curl -s .../server/mode".
#   - the first line overall: some errs are not fatal. report_drain_complete
#     warns that it could not re-read /agents/drain and the run continues; a
#     build failure ten minutes later would then be announced under the drain's
#     warning.
#
# Scoping to the final stage takes the first line of the burst that actually
# ended the run. If that stage emitted nothing (a clean exit, or a failure whose
# errs were all in an earlier stage), it falls back to the last err line rather
# than reporting no reason at all.
deploy_reason_record() {
    local code="$1" reason="" verbatim=""
    [ -n "$REASON_FILE" ] || return 0
    if [ -n "$ERR_LOG" ] && [ -s "$ERR_LOG" ]; then
        reason="$(awk -v s="$DEPLOY_STAGE" 'index($0, s "\t")==1 { print substr($0, length(s)+2); exit }' "$ERR_LOG")"
        # awk, not sed: the tag separator is a TAB, and BSD sed on macOS reads
        # \t in a BRE as a literal 't'.
        verbatim="$(awk '{ i=index($0,"\t"); if (i>0) print substr($0,i+1); else print }' "$ERR_LOG")"
        [ -n "$reason" ] || reason="$(printf '%s\n' "$verbatim" | tail -n 1)"
    fi
    {
        printf 'exit=%s\n' "$code"
        printf 'stage=%s\n' "$DEPLOY_STAGE"
        printf 'installed=%s\n' "$DEPLOY_INSTALLED"
        printf 'reason=%s\n' "$reason"
        printf -- '--- verbatim ---\n'
        [ -n "$verbatim" ] && printf '%s\n' "$verbatim"
    } > "$REASON_FILE" 2>/dev/null || true
    [ -n "$ERR_LOG" ] && rm -f "$ERR_LOG"
    return 0
}

# Flat-JSON field extractors — the driver stays jq-free on purpose (one fewer
# dependency in the path that must work when everything else is broken). Go's
# json.Encoder emits single-line objects, so these single-line seds suffice.
json_str() { sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p"; }
json_num() { sed -n "s/.*\"$1\":\([0-9][0-9]*\).*/\1/p"; }
# json_bool — a BARE json bool, echoing "true"/"false" (empty if the field is
# absent or is not a bool). json_str cannot do this and must not be made to: the
# value carries no quotes, which is exactly what the unit test pins when it
# asserts `json_str draining` is empty. BRE only — this runs under BSD sed on
# macOS, where GNU's \| alternation silently matches nothing.
json_bool() { sed -n "s/.*\"$1\":\([tf][a-z]*\).*/\1/p"; }
# json_arr — a flat array of strings, rendered as a comma-space list with the
# quotes stripped ("a", "b" -> a, b). Empty for an absent field AND for an empty
# array, which are the same thing to every caller here: nothing to name.
#
# [^]]* is what keeps the greedy leading .* from swallowing a later key's
# bracket. BRE only, BSD sed: no \| and no + — see json_bool above.
json_arr() {
    sed -n "s/.*\"$1\":\[\([^]]*\)\].*/\1/p" | sed 's/"//g; s/,/, /g'
}

base_url() { echo "http://127.0.0.1:${PORT}"; }

# ---------------------------------------------------------------------------
# Out-of-band guard (mg-1bbf)
# ---------------------------------------------------------------------------
# The header above has said "must run OUT OF BAND — not as a descendant of
# pogod" since mg-6afa. Until this block, that was the ONE constraint in a
# script with sixteen refusal paths that had no mechanism behind it: enforced
# only by whether the caller read a 1800-line preamble.
#
# That is the wrong enforcement for this population. A human at a terminal
# reading the header is plausible; an agent told "run the redeploy" is not —
# and an agent is precisely who this forbids. Every crew agent and every polecat
# is a pogod descendant, so the actor most likely to skip the prose is the actor
# the prose exists to stop. On 2026-07-21 what stopped it was a mayor happening
# to read the header and decline. Nothing else would have.
#
# The failure it prevents is unrecoverable and self-erasing: `kickstart -k`
# kills pogod's entire process tree, so a descendant that gets this far kills
# the fleet AND itself mid-run, with nobody left to report what happened.
#
# TWO independent signals, reported separately because they fail separately:
#
#   1. Process ancestry — the walk the header describes. Authoritative when the
#      chain is intact.
#   2. The POGO_AGENT_* environment marker pogod stamps on every agent it
#      spawns. Load-bearing precisely where (1) goes blind: a detached or
#      backgrounded grandchild whose intermediate parent has exited is
#      REPARENTED to launchd, and an ancestry walk from there finds no pogod
#      while the caller is still, in every way that matters, in the fleet.
#
# Deliberately NOT wired to `check`, which the usage block promises NEVER acts:
# it is a read-only drift report, it is how the fleet notices it is stale, and
# blinding the fleet to its own drift is not what this guard is for. The hazard
# is exclusively `redeploy`, and that is where the guard sits — on cmd_redeploy's
# first line, ahead of every other precondition, so no invocation reaches the
# drain, the build, or the kickstart without passing it.
#
# There is no override flag, by design. A flag that lets the forbidden caller
# proceed reduces this to the prose it replaces.

# ps_parent PID — prints "PPID COMM" for PID, or nothing if PID is unknown.
# The single seam onto the process table, isolated so the ancestry walk above it
# can be exercised against a synthetic tree with no processes to spawn (and, in
# particular, with no pogod to be a descendant of). Overridden wholesale by the
# unit test; never called with anything but a numeric pid.
ps_parent() {
    ps -o ppid=,comm= -p "$1" 2>/dev/null | sed 's/^ *//'
}

# pogod_ancestor [PID] — walks up the parent chain from PID (default: this
# process) and prints "PID COMM" of the first pogod ancestor. Returns 0 when one
# is found, 1 when the walk reaches the root without seeing one.
#
# Matches on the basename of COMM: ps reports pogod as the absolute path it was
# exec'd from (/Users/daniel/go/bin/pogod), which varies per machine and per
# sandbox, while the basename does not.
#
# The depth cap is a termination guarantee, not a policy: this walk must not be
# able to hang the deploy path even if the process table hands it a cycle.
pogod_ancestor() {
    local pid="${1:-$$}" depth=0 parent comm self=true
    while [ "$depth" -lt 64 ]; do
        depth=$((depth + 1))
        # ps_parent yields this pid's PARENT and this pid's OWN comm, so the
        # chain is walked by stepping to the parent and reading its comm on the
        # next lap. The starting process is stepped over without being tested:
        # the question is ancestry, not identity.
        read -r parent comm <<<"$(ps_parent "$pid")"
        if ! $self && [ -n "${comm:-}" ] && [ "$(basename "$comm")" = "pogod" ]; then
            printf '%s %s' "$pid" "$comm"
            return 0
        fi
        self=false
        # Unknown pid, no parent, a non-numeric read, or the root: the chain
        # ends here and it ended without a pogod in it.
        case "${parent:-}" in ''|*[!0-9]*) return 1 ;; esac
        [ "$parent" -gt 1 ] || return 1
        pid="$parent"
    done
    return 1
}

# assert_out_of_band — refuse to redeploy from inside pogod's process tree.
#
# The message NAMES the remedy and not just the refusal, on purpose: an agent
# that hits a bare "refused" will reasonably conclude the deploy is broken and
# either escalate wrongly or start hunting for a way around the guard. The
# redeploy it was asked to run is legitimate; it is the CALLER that is wrong,
# and only saying so turns a dead end into a handoff.
assert_out_of_band() {
    local ancestor="" reason=""
    if ancestor="$(pogod_ancestor)"; then
        reason="this process is a descendant of pogod (pid ${ancestor%% *}, ${ancestor#* })"
    elif [ -n "${POGO_AGENT_NAME:-}" ]; then
        reason="this process is a pogod-spawned agent (POGO_AGENT_NAME=${POGO_AGENT_NAME}); its parent chain no longer shows pogod, which is what a detached or reparented agent looks like"
    else
        return 0
    fi

    err "refusing to redeploy: $reason"
    cat >&2 <<EOF

  A redeploy runs 'launchctl kickstart -k' on ${DAEMON_LABEL}, which kills
  pogod's ENTIRE process tree. Run from inside that tree, it would kill the
  fleet and this process along with it, mid-deploy, with nothing left running
  to report what happened.

  THE REDEPLOY IS LEGITIMATE. THE CALLER IS NOT.
  It must be performed OUT OF BAND — from a process pogod did not spawn:

    * Daniel, from his own terminal:   scripts/pogo-self-deploy redeploy
    * a launchd one-shot outside pogod's job (mg-6afa sequencing)

  If you are an agent and were asked to redeploy: you cannot, and no flag
  changes that. Hand it back — mail 'human' that pogod is ready for an
  out-of-band redeploy, and say which revision it is owed.

  'scripts/pogo-self-deploy check' is safe from here and never acts; use it to
  report the drift you were going to fix.

EOF
    exit 1
}

# ---------------------------------------------------------------------------
# Mail-check post-check (mg-de08)
# ---------------------------------------------------------------------------
# The bounce is the one moment the fleet's mail loop reliably breaks, so it is
# the one moment worth checking it. On 2026-07-17 a redeploy reaped five crew
# mail-check schedules as agent_gone; the fleet then looked healthy — scheduled,
# answering nudges, diagnosing clean — with no mail delivery for ~2h. Nobody
# noticed until an unrelated heartbeat happened to look stale.
#
# pogod now keeps EXPECTED agents' mail-checks across a restart (mg-de08 Part
# A), and diagnose reports a missing one RED (Part C). This is the third leg:
# an independent assertion, from outside pogod, on the exact event that
# triggers the failure. It reports; it never blocks the redeploy — the daemon
# is already up and running main by the time it runs, and a false alarm must
# not look like a failed deploy.
#
# The ASSEMBLED path below (verify_mail_checks_restored -> mail_check_ids ->
# live curl -> parse -> classify) is shown able to go RED by
# scripts/pogo-self-deploy_live_test.sh, which stands up a real pogod, lets its
# real GC reap real mail-checks, and asserts this code reports the loss (mg-c02d).
# The pure-function tests in pogo-self-deploy_test.sh do NOT cover that wiring.
# If you change anything in that chain, that live control is the one that matters.
#
# EVERYTHING HERE REASONS ABOUT NAMES, NEVER TALLIES (mg-ea3e). The first cut of
# this check compared counts and granted slack as a NUMBER of dead polecats, so
# a --force bounce that killed a polecat with no mail-check handed out an
# allowance no schedule had earned — and one REAL crew loss slid under it
# silently. Architect: "Slack computed as a COUNT of dead polecats rather than
# the SET of schedules that legitimately vanished is the same error shape as the
# original bug — reasoning about a number instead of an identity." Count
# arithmetic cannot tell you WHICH schedule went missing, and WHICH is the only
# question this check exists to answer. A silent miss in the detector, inside
# the detector built because a health signal could not tell "fine" from "gone".
# So: sets in, set difference, names out. If you find yourself adding an
# integer here, you are reintroducing the bug.

# extract_mail_check_ids — the SET of mail-check-* schedule ids in a
# /scheduler/schedules body on stdin, one per line, sorted. Pure: the parse half
# of mail_check_ids, split out so it is testable without a live daemon.
extract_mail_check_ids() {
    grep -o '"id":"mail-check-[^"]*"' | sed 's/^"id":"//; s/"$//' | LC_ALL=C sort -u
}

# extract_mail_check_ids_for_agents NAMES — from a /scheduler/schedules body on
# stdin, the mail-check ids ADDRESSED TO any agent named in NAMES (one name per
# line). Pure.
#
# Matches on the schedule's `agent` field, not on the id string, because that is
# the identity both ends already agree on: internal/agent/mailcheck.go registers
# a polecat's loop against its bare registry name — "the same identity the reap
# path matches on" — while the id is keyed on the work item id. An agent with no
# mail-check yields no id here, which is exactly the point: slack it never
# earned is slack it never gets.
extract_mail_check_ids_for_agents() {
    local names="$1" line agent
    [ -n "$names" ] || return 0
    # `|| [ -n "$line" ]` is load-bearing: the body's LAST object carries no
    # trailing newline, so a bare `read` sets $line and then returns 1, and the
    # loop drops it. That silently forgives whichever schedule sorts last — a
    # miss in the detector, found only by an assertion that named a schedule the
    # daemon really emitted last.
    sed 's/},{/}\n{/g' | while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in *'"id":"mail-check-'*) ;; *) continue ;; esac
        agent="$(printf '%s' "$line" | json_str agent)"
        [ -n "$agent" ] || continue
        printf '%s\n' "$names" | grep -qxF "$agent" || continue
        printf '%s' "$line" | json_str id
    done | LC_ALL=C sort -u
}

# snapshot_polecat_names — the names of every polecat in an /agents/drain
# snapshot on stdin, one per line. Pure. These are the identities a forced
# bounce killed; they are what the slack set is looked up BY.
snapshot_polecat_names() {
    sed 's/},{/}\n{/g' | grep -o '"name":"[^"]*"' | sed 's/^"name":"//; s/"$//'
}

# schedules_body — the raw /scheduler/schedules body. Returns 1 (and prints
# nothing) when pogod cannot be reached, so callers can tell "unreachable" from
# "reachable, and it holds nothing" — different facts that must never compare
# equal. Reporting an unreachable daemon as an empty fleet would announce the
# entire fleet lost; reporting it as OK would make this check decoration.
schedules_body() {
    local body
    body="$(curl -sf --max-time 5 "$(base_url)/scheduler/schedules" 2>/dev/null)" || return 1
    [ -n "$body" ] || return 1
    printf '%s' "$body"
}

# mail_check_ids — the SET of mail-check-* ids pogod currently holds, one per
# line. Echoes the "?" sentinel and returns 1 when pogod is unreachable.
#
# The sentinel is load-bearing. Under the old count this role was played by an
# empty string, which worked only because "" is not a number. A set has no such
# luck: "" is a perfectly good EMPTY SET. So unreachable gets an explicit mark —
# "?", the same sentinel this script already uses for an unknown polecat count —
# and empty is left free to mean what it says.
mail_check_ids() {
    local body
    body="$(schedules_body)" || { echo "?"; return 1; }
    printf '%s' "$body" | extract_mail_check_ids
}

# expected_lost_mail_checks PRE_BODY SNAPSHOT -> the SET of mail-check ids whose
# loss the forced bounce EXPLAINS, one per line.
#
# A schedule qualifies only if it (a) belongs to a polecat the bounce killed and
# (b) really existed before the bounce. Both halves come from names: the dead
# polecats' names out of the pre-kickstart drain snapshot, the schedules out of
# the pre-kickstart schedule body. Nothing is inferred from how MANY polecats
# died — a bounce that kills three polecats holding one mail-check between them
# excuses exactly one schedule, and it can say which.
expected_lost_mail_checks() {
    local body="$1" snapshot="$2" names
    names="$(printf '%s' "$snapshot" | snapshot_polecat_names)"
    printf '%s' "$body" | extract_mail_check_ids_for_agents "$names"
}

# missing_mail_checks PRE POST SLACK -> the SET of ids that vanished unexplained.
# Pure set arithmetic: PRE - (POST + SLACK). Each argument is a newline-separated
# set of ids. This is the whole check.
missing_mail_checks() {
    LC_ALL=C comm -23 \
        <(printf '%s\n' "$1" | sed '/^$/d' | LC_ALL=C sort -u) \
        <(printf '%s\n%s\n' "$2" "$3" | sed '/^$/d' | LC_ALL=C sort -u)
}

# classify_mail_check_restore PRE POST SLACK -> ok | unknown | missing:<ids>
#
# PRE and POST are SETS of mail-check ids (newline-separated); "?" means the
# daemon could not be read. SLACK is the SET of ids whose loss is EXPECTED — the
# schedules the --force-killed polecats really did take with them. They are
# reaped on purpose, so calling them damage would cry wolf on every forced
# deploy; but slack is granted per NAMED schedule, so it can only ever excuse
# the schedule it names.
#
# Ids in POST that were never in PRE are "ok": the crew re-registering, or a
# polecat spawning, both legitimately add. This check only ever asserts that
# mail-checks were not silently LOST.
classify_mail_check_restore() {
    local pre="$1" post="$2" slack="${3:-}" missing
    # Test each side SEPARATELY for the unreachable sentinel — an unreadable
    # daemon on either end is unknown, and must never be differenced against a
    # real set as though "?" were an id.
    [ "$pre" = "?" ] && { echo "unknown"; return; }
    [ "$post" = "?" ] && { echo "unknown"; return; }
    [ "$slack" = "?" ] && { echo "unknown"; return; }
    missing="$(missing_mail_checks "$pre" "$post" "$slack")"
    if [ -z "$missing" ]; then
        echo "ok"
    else
        echo "missing:$(printf '%s' "$missing" | tr '\n' ' ' | sed 's/ *$//')"
    fi
}

# set_size — how many ids are in a newline-separated set. For REPORTING only:
# the verdict is reached by name, and the count is a courtesy to the reader.
set_size() { printf '%s' "$1" | sed '/^$/d' | grep -c . ; }

# verify_mail_checks_restored PRE SLACK — poll the post-bounce SET and report.
# PRE and SLACK are newline-separated sets of mail-check ids ("?" for PRE when
# the pre-bounce daemon could not be read). Polls because the new pogod loads
# its schedules from disk moments after the port answers; it is not an "agents
# re-register in time" race (Part A means nothing has to re-register), just
# startup ordering.
verify_mail_checks_restored() {
    local pre="$1" slack="${2:-}" deadline verdict post
    if [ "$pre" = "?" ]; then
        log "mail-check post-check: SKIPPED (could not read mail-checks before the bounce)"
        return 0
    fi
    deadline=$(( $(date +%s) + MAIL_CHECK_TIMEOUT ))
    while :; do
        post="$(mail_check_ids)"
        verdict="$(classify_mail_check_restore "$pre" "$post" "$slack")"
        [ "$verdict" = "ok" ] && break
        [ "$(date +%s)" -ge "$deadline" ] && break
        sleep 3
    done
    case "$verdict" in
        ok)
            log "mail-check post-check: OK — $(set_size "$post") mail-check schedule(s) present (pre-bounce $(set_size "$pre"), expected loss $(set_size "$slack"))"
            if [ -n "$slack" ]; then
                log "  expected loss (force-killed polecats' own loops): $(printf '%s' "$slack" | tr '\n' ' ')"
            fi
            ;;
        unknown)
            log "mail-check post-check: UNKNOWN — could not read schedules from the new pogod"
            log "  verify by hand: pogo schedule list | grep mail-check"
            ;;
        missing:*)
            local lost="${verdict#missing:}"
            err "mail-check post-check: FAILED — $(printf '%s' "$lost" | wc -w | tr -d ' ') mail-check schedule(s) LOST across the bounce"
            err "  LOST: $lost"
            err "  pre-bounce $(set_size "$pre"), now $(set_size "$post"), expected loss $(set_size "$slack") (mg-de08)"
            err "  the fleet's mail loop is degraded and WILL LOOK HEALTHY. Diagnose:"
            err "    pogo agent list               # FIRST: is the owning agent still there at all?"
            err "    pogo schedule list | grep mail-check"
            err "    pogo agent diagnose <name>    # reports no_mail_loop for an agent with no loop"
            # This check reads schedules, never the agent registry, so it cannot
            # tell the two causes apart — and on 2026-08-10 the one it always
            # printed was the impossible one (mg-6d7b). It prints both, gated on
            # the answer it does not have, rather than a confident guess:
            err "  the REMEDY depends on that first answer, and the two are opposites:"
            err "    agent present -> pogo nudge <agent>        # it survived; it can re-register"
            err "    agent GONE    -> pogo agent start <agent>  # the schedule was reaped WITH it;"
            err "                                               # a nudge has nothing to nudge"
            err "  pogo-deploy's later re-check reads the registry and mails the resolved answer."
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Revision sources (the three axes of drift)
# ---------------------------------------------------------------------------

# THE STAMP IS EVIDENCE, NOT TRUTH (mg-8f09). Every axis below reports what a
# binary CLAIMS about its own provenance, and a claim has three failure modes
# this check must keep apart, because they owe three different actions:
#
#   present & ours    — a commit that exists in $REPO. Comparable to main.
#   ABSENT            — no vcs stamp at all. NOT comparable to anything.
#   present & FOREIGN — a real commit, from a DIFFERENT repo. NOT comparable.
#
# The old code collapsed all three into a bare string and compared it to MAIN.
# That is why it could only ever say "behind main" — a claim about ANCESTRY it
# had not measured and, for the last two cases, could not measure. mg-49bc read
# that output and concluded "stale dirty build"; the truth was a foreign repo's
# HEAD (see the FOREIGN STAMP note in classify_drift). A verdict phrased in a
# vocabulary the check cannot actually support sends the reader somewhere else.
#
# So each source distinguishes its OWN kinds of absence, with sentinels that
# can never collide with a hex revision. Two absences that mean different things
# must not arrive here as the same empty string — that is the mg-de08 defect
# (absence of evidence read as evidence), and it is the one this file is for.
REV_UNSTAMPED='<unstamped>'     # binary is there; it carries NO vcs stamp
REV_MISSING='<missing>'         # binary is not on disk at all
REV_UNREACHABLE='<unreachable>' # pogod is not answering /version

# running: the revision of the LIVE pogod process, self-reported via /version.
# Must come from the process, not `go version -m` on disk: `go install` rewrites
# the on-disk binary underneath a live daemon, so the file's revision diverges
# from the running one the instant a rebuild happens.
#
# UNREACHABLE and UNSTAMPED are different answers: a daemon that will not talk
# owes a restart, a daemon that talks but cannot say what it is owes an
# investigation. Reporting both as "" made them one state.
running_rev() {
    local body
    body="$(curl -sf --max-time 5 "$(base_url)/version" 2>/dev/null)" \
        || { echo "$REV_UNREACHABLE"; return 0; }
    local rev; rev="$(printf '%s' "$body" | json_str revision)"
    if [ -n "$rev" ]; then echo "$rev"; else echo "$REV_UNSTAMPED"; fi
}

# --- the RUN MODE, which is a different fact from "a process answered" -------
#
# A REVISION IS NOT AN ANSWER TO "DID THE SERVER START" (mg-6d2f). /version is
# deliberately NOT behind RequireOrchestration — it has to answer for a daemon in
# any mode, or the drift check could never read an index-only one. That is right,
# and it is exactly why running_rev cannot close this deploy: a pogod that came
# back in index-only mode serves /version, reports main's revision, and refuses
# every /agents, /refinery and /scheduler call with HTTP 503. To verify_running
# that is a completed deploy. To the fleet it is an outage — no dispatch, no
# refinery, no scheduler — and it is Daniel's sentence about the 08-07 night
# verbatim: "didnt actually start the server and i had to manually start it."
#
# /server/mode is the reading that separates them, and it is registered on the
# UNGUARDED mux for the same reason /version is: it must be answerable precisely
# when the guarded surface is not. So an unreachable daemon and a stopped one
# stay different answers here, as they must.
MODE_UNREACHABLE='<unreachable>' # pogod is not answering /server/mode at all
MODE_UNSTAMPED='<unreported>'    # it answered, but named no mode

# NAME THE LAYER. `full` means the orchestration HTTP surface is up: /agents,
# /refinery and /scheduler are past RequireOrchestration and dispatch can happen.
# It does NOT claim every crew agent is running — that is a different layer with
# its own defect (mg-060c) and its own ticket. This deploy verifies the layer it
# turned off and back on, and says which one that is rather than letting a green
# line be read as a statement about the whole fleet.
server_mode() {
    local body
    body="$(curl -sf --max-time 5 "$(base_url)/server/mode" 2>/dev/null)" \
        || { echo "$MODE_UNREACHABLE"; return 0; }
    local mode; mode="$(printf '%s' "$body" | json_str mode)"
    if [ -n "$mode" ]; then echo "$mode"; else echo "$MODE_UNSTAMPED"; fi
}

# DEPLOYED_CMDS: every binary this deploy owns, as `go install` package paths.
# The CLI is here because it is not optional cargo: `pogo` is the operator's only
# interface to the daemon, and a `pogo` older than the `pogod` it talks to is a
# protocol mismatch waiting to happen (mg-49bc). They move together or not at all
# — which is why the list lives at the top and every path below iterates it
# rather than naming a binary.
DEPLOYED_CMDS=(pogod pogo)

# installed_bin: where a deployed binary lives on disk.
installed_bin() {
    local name="$1"
    if [ -n "${POGO_GOBIN:-}" ]; then echo "$POGO_GOBIN/$name"; return; fi
    local gobin; gobin="$(go env GOBIN 2>/dev/null)"
    if [ -n "$gobin" ]; then echo "$gobin/$name"; return; fi
    echo "$(go env GOPATH 2>/dev/null)/bin/$name"
}
# installed: the revision baked into an on-disk ~/go/bin/<name> binary.
#
# The old contract was "empty when the binary is absent OR carries no stamp",
# justified as: empty never equals MAIN, so it classifies as a build owed rather
# than passing as "matches". That reasoning is CORRECT for a missing binary and
# WRONG for an unstamped one, and it fused the two cases into one string:
#
#   MISSING   — no binary. A build genuinely IS owed, and a build fixes it.
#   UNSTAMPED — a binary, built from a tree Go could not read VCS info for. A
#               build is NOT owed and a build does NOT fix it: the rebuild is
#               unstamped too, so it still "!= MAIN", so the drift never clears.
#               "Never equals MAIN" stops being a safe default the moment it
#               becomes permanent — it is a reconcile loop against an artifact
#               that is not broken, which is the exact thing this file's header
#               says a drift check must never start.
#
# Keeping them apart is what lets classify_drift owe a build for the first and
# refuse for the second.
installed_rev() {
    local bin; bin="$(installed_bin "$1")"
    [ -x "$bin" ] || { echo "$REV_MISSING"; return 0; }
    local rev
    rev="$(go version -m "$bin" 2>/dev/null | sed -n 's/.*vcs.revision=\([0-9a-f]*\).*/\1/p' | head -1)"
    if [ -n "$rev" ]; then echo "$rev"; else echo "$REV_UNSTAMPED"; fi
}

# rev_in_repo — does $REPO actually contain this commit? This is the whole
# foreign-stamp test, and it is re-derivable by hand: `git -C $REPO cat-file -e
# <rev>^{commit}`. A stamp naming a commit no ancestor query can even resolve is
# not "behind"; it is from somewhere else. Stubbed by the unit tests, which
# exercise the staleness axis with symbolic revisions.
rev_in_repo() {
    git -C "${REPO:-}" cat-file -e "${1}^{commit}" 2>/dev/null
}

# Revisions that are not comparable to MAIN at all — the sentinels above.
rev_is_sentinel() {
    case "$1" in
        "$REV_UNSTAMPED"|"$REV_MISSING"|"$REV_UNREACHABLE"|"") return 0 ;;
        *) return 1 ;;
    esac
}

# main: what the repo says SHOULD run (the deploy ref's HEAD).
main_rev() {
    git -C "$REPO" rev-parse "$DEPLOY_REF" 2>/dev/null
}

# ---------------------------------------------------------------------------
# Repo resolution — build from a known-good local checkout of the pogo source.
# Precedence: --repo / $POGO_REPO > the checkout this script lives in (when it
# is the pogo module) > error. The driver refuses to guess.
# ---------------------------------------------------------------------------
resolve_repo() {
    if [ -n "$REPO" ]; then
        git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || { err "repo path '$REPO' is not a git repo"; exit 2; }
        return
    fi
    local self_dir top
    self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    top="$(git -C "$self_dir" rev-parse --show-toplevel 2>/dev/null)"
    if [ -n "$top" ] && [ -f "$top/go.mod" ] && grep -q '^module github.com/drellem2/pogo$' "$top/go.mod" 2>/dev/null; then
        REPO="$top"
        return
    fi
    err "cannot resolve the pogo source repo; pass --repo PATH or set POGO_REPO"
    exit 2
}

# ---------------------------------------------------------------------------
# Drift computation
# ---------------------------------------------------------------------------
RUNNING="" ; INSTALLED="" ; INSTALLED_CLI="" ; MAIN=""
compute_drift() {
    RUNNING="$(running_rev)"
    INSTALLED="$(installed_rev pogod)"
    INSTALLED_CLI="$(installed_rev pogo)"
    MAIN="$(main_rev)"
}

# The CLI has no `running` axis — `pogo` is a short-lived process, so there is
# nothing to be stale except the binary on disk. That asymmetry is why it gets a
# row and not a column: installed-vs-main is the whole question for it.
print_drift() {
    echo "revision drift (repo: $REPO, ref: $DEPLOY_REF)"
    printf '  running        : %s\n' "$(annotate_rev "${RUNNING:-$REV_UNREACHABLE}")"
    printf '  installed pogod: %s\n' "$(annotate_rev "${INSTALLED:-$REV_MISSING}")"
    printf '  installed pogo : %s\n' "$(annotate_rev "${INSTALLED_CLI:-$REV_MISSING}")"
    printf '  main HEAD      : %s\n' "${MAIN:-<unknown>}"
}

# annotate_rev — print a revision with what we know ABOUT it. A bare hash in the
# report tells the reader nothing about whether it is even this repo's hash, and
# that missing word is what mg-49bc had to guess at.
annotate_rev() {
    local rev="$1"
    case "$rev" in
        "$REV_UNSTAMPED")   echo "<no vcs stamp — provenance UNKNOWN>"; return ;;
        "$REV_MISSING")     echo "<none on disk>"; return ;;
        "$REV_UNREACHABLE") echo "<unreachable — pogod not answering /version>"; return ;;
    esac
    if rev_in_repo "$rev"; then echo "$rev"; else echo "$rev  <FOREIGN — no such commit in $REPO>"; fi
}

# The three axes as "label:revision" pairs. One list, so a new axis cannot be
# added to the staleness check and forgotten by the provenance check.
drift_axes() {
    printf '%s\n' "running pogod:$RUNNING" "installed pogod:$INSTALLED" "installed pogo:$INSTALLED_CLI"
}

# Names the axes whose binary carries no vcs stamp at all.
unstamped_axes() {
    local line out=""
    while IFS= read -r line; do
        [ "${line#*:}" = "$REV_UNSTAMPED" ] && out="${out:+$out, }${line%%:*}"
    done < <(drift_axes)
    echo "$out"
}

# Names the axes whose stamp is a real revision that this repo has never heard
# of, quoting the claimed revision — the operator must be able to see WHAT was
# claimed, not just that something was wrong.
foreign_axes() {
    local line rev out=""
    while IFS= read -r line; do
        rev="${line#*:}"
        rev_is_sentinel "$rev" && continue
        rev_in_repo "$rev" || out="${out:+$out; }${line%%:*} claims $(short "$rev")"
    done < <(drift_axes)
    echo "$out"
}

# Names the binaries whose installed revision is behind main, for the operator
# who has to read WHY a build is owed.
stale_bins() {
    local out=""
    [ "$INSTALLED" != "$MAIN" ] && out="pogod"
    [ "$INSTALLED_CLI" != "$MAIN" ] && out="${out:+$out, }pogo"
    echo "$out"
}

# Sets NEEDS_BUILD / NEEDS_RESTART / owed-action string. Reports; never acts.
NEEDS_BUILD=false ; NEEDS_RESTART=false ; ACTION=""
classify_drift() {
    NEEDS_BUILD=false ; NEEDS_RESTART=false
    if [ -z "$MAIN" ]; then ACTION="cannot classify: main HEAD unknown"; return 1; fi

    # THE PROVENANCE GATE (mg-8f09) — runs BEFORE any comparison to MAIN,
    # because a comparison to MAIN is only meaningful once we know the thing we
    # are comparing is a commit from this repo. Both branches below REFUSE
    # (return 1) rather than owe a build: a build is the answer to "behind",
    # and neither of these is behind. Refusing is also the safe direction — the
    # caller leaves the old pogod running and dispatching, which is the correct
    # resting state for "we do not know what is deployed".
    local unstamped; unstamped="$(unstamped_axes)"
    if [ -n "$unstamped" ]; then
        # THE POST-mg-2ce4 WORLD. Once polecat worktrees move out of the ~/.pogo
        # repo, Go finds no VCS to read and stamps NOTHING. Absent beats false —
        # but absent must not read as clean, and it must not read as "behind"
        # either. Both are claims about a binary that has told us nothing.
        # The fleet already paid for this lesson once: the mg-de08 reap
        # concluded death from two absences. Absence of evidence is not
        # evidence, and a drift check is the last place that rule may lapse.
        ACTION="UNKNOWN PROVENANCE: $unstamped — NO vcs stamp. This is not a clean box and it is not a stale one; the binary has told us nothing. Expected a commit from $DEPLOY_REF (HEAD $(short "$MAIN")) in ${REPO:-<unresolved>}. A rebuild will NOT clear this — an unstamped binary rebuilds unstamped. Verify: go version -m \$(command -v pogod) | grep vcs."
        return 1
    fi

    local foreign; foreign="$(foreign_axes)"
    if [ -n "$foreign" ]; then
        # THE mg-49bc CORRECTION, made mechanical. A stamp naming a commit that
        # does not exist in $REPO is not stale and is not dirty — it is from
        # another repo entirely, and no amount of "git log main" will explain
        # it. Name BOTH sides so the verdict can be re-derived from its own
        # output with one cat-file, instead of re-investigated from scratch.
        ACTION="FOREIGN STAMP: $foreign — no such commit in ${REPO:-<unresolved>}. Expected a commit from $DEPLOY_REF (HEAD $(short "$MAIN")). This binary was built against a DIFFERENT repository; its revision (and any vcs.modified=true it reports) describes that repo, not this one. Verify: git -C ${REPO:-<repo>} cat-file -e <rev>^{commit}"
        return 1
    fi
    # A build is owed if ANY deployed binary is behind main — not just pogod.
    # Reading only pogod here is what let the CLI sit three days stale while this
    # very function reported "clean": the daemon matched main, so nothing looked
    # owed, and the drift check could not see the drift it was there to catch
    # (mg-ddf1). A check blind to half of what it installs reports health it has
    # not measured.
    { [ "$INSTALLED" != "$MAIN" ] || [ "$INSTALLED_CLI" != "$MAIN" ]; } && NEEDS_BUILD=true
    [ "$RUNNING"  != "$MAIN" ] && NEEDS_RESTART=true
    if ! $NEEDS_BUILD && ! $NEEDS_RESTART; then
        ACTION="clean — running == installed (pogod, pogo) == main; nothing owed"
    elif ! $NEEDS_BUILD; then
        # A rebuild already happened; only a restart bounces the fleet.
        ACTION="RESTART owed (no go install): installed already matches main, running is stale"
    elif ! $NEEDS_RESTART; then
        # The case the old classifier could not express, and today's actual
        # state: pogod is current and running main, and the CLI is stale anyway.
        ACTION="BUILD owed (no restart): running pogod is main, but installed $(stale_bins) behind main"
    elif [ "$RUNNING" = "$INSTALLED" ] && [ "$INSTALLED" != "$MAIN" ]; then
        ACTION="BUILD + RESTART owed: running == installed, both behind main"
    else
        ACTION="BUILD + RESTART owed: running/installed/main all differ ($(stale_bins) behind)"
    fi
    return 0
}

# ---------------------------------------------------------------------------
# check — report only, never act
# ---------------------------------------------------------------------------
cmd_check() {
    resolve_repo
    compute_drift
    print_drift
    classify_drift || { echo "action    : $ACTION"; return 1; }
    echo "action    : $ACTION"
    echo
    echo "(report only — 'pogo-self-deploy redeploy' performs the guarded rebuild+restart)"
}

# ---------------------------------------------------------------------------
# redeploy — guarded rebuild + restart
# ---------------------------------------------------------------------------
confirm() {
    $ASSUME_YES && return 0
    if [ ! -t 0 ]; then
        err "refusing to redeploy non-interactively without --yes (fleet-wide bounce)"
        exit 3
    fi
    printf 'Redeploy pogod (this WILL bounce the whole fleet)? [y/N] '
    read -r ans
    case "$ans" in y|Y|yes|YES) return 0 ;; *) log "aborted by user"; exit 0 ;; esac
}

# POST a drain state ({"draining":<bool>}) and echo the response BODY, then a
# final line carrying the HTTP status, so the caller can tell an ANSWERED-but-
# missing endpoint (404, bootstrap) apart from a genuinely-unreachable pogod.
# curl (no -f) writes "000" for connection refused / DNS / timeout, so a
# numeric-but-non-2xx code always means the server answered. Kept curl-only on
# purpose — no jq, no extra hop (see file header).
#
# THE BODY USED TO GO TO /dev/null, AND THAT COST A NIGHT (mg-08e9). On
# 2026-08-07 this POST answered 503 and the run exited 6 after 0 seconds. The
# reason pogod gave was in hand and was written to /dev/null at the moment it
# arrived, so the question worth asking the next morning had no answer anywhere
# on the box. Not ambiguous evidence: NO evidence.
#
# WHAT THIS ADDS ON TOP OF mg-0155, WHICH IS NOT THE SAME THING. That ticket
# classified 503 as `stopped` and wrote the operator's sentence at the refusal
# site, and it is right: RequireOrchestration is the only non-test 503 on this
# route today. But that sentence is an INFERENCE FROM THE SOURCE TREE — it says
# what a 503 must have meant, given how the daemon is currently wired. This
# prints what the daemon ACTUALLY SAID. The two agreeing is the confirmation;
# the two disagreeing is the only way we would ever find out that the inference
# had gone stale — a middleware added above the mux, a proxy in front of the
# port, a 503 from something that is not this build at all. mg-293c found the
# matching hazard from the other side on 2026-08-07: the mode-transition lines
# that have logged since March were ABSENT from pogod.log across the whole
# window, so the daemon's own account of how it got into that mode is missing.
# When the log is silent, the answer to the request is the only thing left.
#
# THE CLASS, NOT THE INSTANCE. This is not a curl flag that happened to be
# wrong; it is an error path that stopped explaining itself while continuing to
# report correctly. mail_alert acquired the same defect from a different
# direction and was fixed the same night (mg-0155): its `mailbox_created` branch
# went unreachable against a current mg, so the refusal still fired and still
# returned 1 — the control was intact — while the sentence naming the wrong
# recipient became a raw no_such_mailbox blob. Both stay green under every test
# that asks "did it refuse?" and both fail the only question asked at 08:00,
# which is "why?".
#
# THE STATUS IS THE PRIMARY FACT AND MUST SURVIVE AN UNREADABLE BODY. That is
# why the body is not fetched separately and is not written to a file that could
# fail to open: `-w '\n%{http_code}'` puts both on one stream from one hop, so
# the status is always the last line no matter what the body is (empty, binary,
# multi-line, huge). There is no read that can fail and take the status with it.
# Same shape as drain_probe, and split with the same two expansions.
drain_post() {
    local state="$1"
    curl -s -w '\n%{http_code}' --max-time 5 \
        -X POST "$(base_url)/agents/drain" \
        -H 'Content-Type: application/json' -d "{\"draining\":${state}}" 2>/dev/null
}

# http_status / http_body — split a `\n%{http_code}` response into its two
# facts. Named because drain_wait, drain_post's callers and restore_drain all do
# it, and a fourth open-coding of `${raw##*$'\n'}` is one more place for the two
# expansions to drift apart.
http_status() { printf '%s' "${1##*$'\n'}"; }
http_body()   { local r="$1"; case "$r" in *$'\n'*) printf '%s' "${r%$'\n'*}" ;; *) printf '' ;; esac; }

# DRAIN_BODY_MAX — how much of a failing drain's body reaches a log line and the
# RED alert. A bound, not a preference: this text travels into mail via the
# reason record's verbatim section, and pogod is free to answer with a stack
# trace or an HTML error page. Truncation is ANNOUNCED (see fmt_http_body) so a
# reader never mistakes a cut string for the whole answer — which would be a
# smaller copy of the defect being fixed.
DRAIN_BODY_MAX="${POGO_DEPLOY_BODY_MAX:-400}"

# fmt_http_body MAX BODY — render a response body as ONE bounded line, for an
# `err` line (and therefore for the alert). Pure; unit-tested.
#
# Three things it must never do. It must never render an empty body as an empty
# string — "the server answered and said nothing" is a fact the reader needs
# stated, not a blank where text should be. It must never emit raw newlines or
# control bytes: every err line is copied verbatim into the reason record, whose
# format is line-oriented, so a body containing "\nreason=..." would forge a
# field. And it must never truncate silently.
fmt_http_body() {
    local max="$1" body="$2" one n
    # Control bytes -> spaces (not deleted: deleting them would silently join
    # tokens that were separate), then squeeze and trim.
    one="$(printf '%s' "$body" | tr '\000-\037\177' '[ *]' | tr -s ' ')"
    one="${one# }"; one="${one% }"
    [ -n "$one" ] || { printf '(empty body — the server answered, but said nothing)'; return 0; }
    n=${#one}
    if [ "$n" -gt "$max" ]; then
        printf '%s… (truncated; %d chars in full — see the pogod log for the rest)' "${one:0:$max}" "$n"
    else
        printf '%s' "$one"
    fi
}

# ---------------------------------------------------------------------------
# Drain restore (mg-8b48)
# ---------------------------------------------------------------------------
# `drain_post true` is a MUTATION OF ANOTHER PROCESS'S STATE, and until this
# trap existed it had no guaranteed undo. Every exit between enabling drain and
# the kickstart left the OLD pogod up with draining=true — dispatching NO
# polecats, fleet-wide, until a human noticed and restarted it. do_build's four
# exits all sit in that window, and the dirty-tree one fires on a condition a
# human creates by accident. Nothing goes red when it happens: pogod is up, the
# port answers, crew keep answering mail, so every health signal stays green
# while the fleet quietly stops doing work. Unattended at 03:00 that is a worse
# outcome than a missed deploy (mg-46a4 §5b).
#
# exit 5 (kickstart), exit 8 (verify) and exit 11 (orchestration) LOOK like they
# are in the window and are not: by then the old process is gone, and a landed
# kickstart resets draining to its zero value (internal/agent/agent.go). That is
# luck of zero-value initialisation, not a restore path — do not lean on it, and
# do not mistake it for coverage of the exits above.
#
# exit 12 (orchestration already stopped) is squarely INSIDE it, and is the one
# exit in the window where the restore cannot possibly work: the restore POST
# goes to the same guarded endpoint that just returned 503, so it returns 503
# too. restore_drain says so in those terms rather than reporting a drain that
# was never enabled — see its 503 branch.
#
# RESTORE THE PRIOR VALUE, NEVER A HARD false. If drain was already on for an
# unrelated reason, forcing false asserts a state instead of restoring one, and
# that is the same bug wearing a different hat: this deploy would switch
# dispatch back on underneath whoever turned it off.
DRAIN_PRIOR=""     # draining as it was BEFORE this run touched it: true|false|?
DRAIN_ARMED=false  # true only between "we may have enabled drain" and the kickstart

# drain_state — the live draining flag: "true" | "false" | "?" when unreadable.
# "?" is the same unreachable sentinel the mail-check set uses, and for the same
# reason: "could not read it" and "it is off" are different facts, and restoring
# a value we never read is an assertion, not a restore.
drain_state() {
    local body v
    body="$(curl -sf --max-time 5 "$(base_url)/agents/drain" 2>/dev/null)" || { echo "?"; return 1; }
    v="$(printf '%s' "$body" | json_bool draining)"
    case "$v" in true|false) echo "$v" ;; *) echo "?"; return 1 ;; esac
}

# restore_drain CODE — half of the EXIT trap body (see on_deploy_exit). Puts
# dispatch back the way we found it on ANY exit path while armed: the four
# do_build exits, an unexpected error under set -u, and Ctrl-C/SIGTERM (INT/TERM
# are trapped too, since a human aborting a deploy mid-drain leaves exactly the
# same outage as a failed build).
#
# CODE is passed in rather than read from `$?`: since mg-0155 the trap does two
# things, and the second call in a trap body no longer sees the exit status that
# fired it. The status the operator is told about must be the run's, not the
# preceding statement's.
#
# Deliberately NOT self-healing-by-accident: it reports what it did, and reports
# LOUDLY when it could not, because a failed restore IS the outage this exists to
# prevent and the operator needs the one command that fixes it.
restore_drain() {
    local code="${1:-$?}" want st
    $DRAIN_ARMED || return
    DRAIN_ARMED=false   # a restore is attempted exactly once
    want="$DRAIN_PRIOR"
    if [ "$want" != "true" ] && [ "$want" != "false" ]; then
        err "drain restore: pre-deploy drain state was never read; ASSUMING dispatch was enabled"
        err "  (this ASSERTS draining=false rather than restoring a value — verify by hand if drain was intentionally on)"
        want=false
    fi
    log "restoring dispatch to its pre-deploy state (draining=$want) — deploy exited $code before the kickstart"
    local raw; raw="$(drain_post "$want")"
    st="$(http_status "$raw")"
    case "$st" in
        2??) log "dispatch restored: draining=$want" ;;
        503) # The restore POST goes to the SAME guarded endpoint the drain just
             # failed on, so on the mg-6d2f path it cannot succeed and its
             # failure means something quite specific. The generic branch below
             # would end the run with "pogod may STILL be draining" — a claim
             # about a flag that was never set, aimed at the wrong problem, and
             # printed LAST so it is the reader's final word. The fleet is not
             # draining; the fleet is stopped, and the drain flag is irrelevant
             # until orchestration is back.
             err "drain restore could not run: /agents/drain is behind RequireOrchestration and returned 503."
             # The daemon's own words here too (mg-08e9). This arm exists to
             # stop a WRONG story being told about a 503, not to stop the 503
             # being quoted — and the quote is what would surface the day the
             # sentence above stops being true of this status.
             err "  it answered: $(fmt_http_body "$DRAIN_BODY_MAX" "$(http_body "$raw")")"
             err "  Nothing was left draining — the drain was never enabled, because the same"
             err "  guard refused the request that would have enabled it. Do not chase the drain"
             err "  flag; it is not the problem and it will be at its zero value the moment"
             err "  orchestration is back. Fix the mode, and the flag follows:"
             err "    pogo server start"
             ;;
        *)   err "drain restore FAILED (HTTP ${st:-000}) — pogod may STILL be draining and dispatching NO polecats."
             # The same discard that cost mg-08e9 a night lived here too, on the
             # one path whose failure IS a fleet-wide dispatch outage. Whatever
             # pogod said about refusing is the operator's first clue, and this
             # err line rides the reason record into the alert like the rest.
             #
             # ONLY WHEN SOMETHING ANSWERED. 000/empty is curl reporting that
             # nothing responded, and there is no body to quote — printing the
             # absent one as "(empty body — the server answered...)" would
             # assert the opposite of what the status says. That is not a
             # hypothetical: the `down` refusal reaches this trap with a dead
             # port, so the unguarded version of this line put "it answered"
             # into the record of a run whose whole finding was that nothing
             # did. Caught by the mg-08e9 test that asserts `down` never makes
             # that claim.
             case "$st" in
                 000|"") err "  (nothing answered the restore POST either — no body to quote)" ;;
                 *)      err "  it answered: $(fmt_http_body "$DRAIN_BODY_MAX" "$(http_body "$raw")")" ;;
             esac
             err "  The fleet will look healthy and do nothing. Restore by hand:"
             err "    curl -X POST $(base_url)/agents/drain -H 'Content-Type: application/json' -d '{\"draining\":$want}'"
             ;;
    esac
}

# disarm_drain_restore WHY — cancel the restore on a path where the enabling
# POST PROVABLY never mutated anything (mg-0155). Logs what it did and why.
#
# The trap is armed BEFORE the POST on purpose, and the comment at the arming
# site says why: a POST that times out AFTER pogod set the flag comes back
# "000", so the one status that cannot tell us whether we mutated anything must
# still restore. That reasoning is about AMBIGUITY, and it does not reach the
# statuses that are not ambiguous.
#
# A 404 means the mux found no `/agents/drain` route to run. A 503 means
# `RequireOrchestration` returned before the handler was ever entered. On both,
# the server ANSWERED and the flag was not touched — so the restore has nothing
# to put back, and its failure line is worse than useless. On 2026-08-07 the 503
# refusal ran the restore anyway, the restore POST hit the same 503, and the
# alert carried "drain restore FAILED (HTTP 503) — pogod may STILL be draining
# and dispatching NO polecats. The fleet will look healthy and do nothing." The
# fleet was never draining (`{"draining":false}`, mode `full`), and the one
# command the message offered as the fix is aimed at the very endpoint that is
# refusing. A false outage report, plus a remedy that cannot work.
#
# Narrow ON PURPOSE: only the two statuses whose non-mutation is a property of
# the server's own routing. `down` and every other `error:*` keep the restore,
# because "the server answered 500" does not establish what it did first.
disarm_drain_restore() {
    $DRAIN_ARMED || return 0
    DRAIN_ARMED=false
    log "drain restore disarmed: dispatch was never touched — $1"
}

# ---------------------------------------------------------------------------
# The external sink (mg-f206) — how a run that DOES NOTHING gets noticed
# ---------------------------------------------------------------------------
# THE FAILURE THIS COVERS. `redeploy` fails CLOSED when the drain times out with
# polecats still working: it restores dispatch and exits 7 without deploying,
# rather than killing live work. Attended that is correct and self-reporting —
# the human who ran it is standing there and reads the refusal. Unattended at
# 03:00 it is a deploy that SILENTLY NEVER HAPPENS. Nothing is broken, so nothing
# goes red: pogod is up, the port answers, the fleet dispatches, every light is
# green — and we believe we track main while not tracking it, indefinitely. The
# absence of a deploy produces no signal. That is this fleet's defect (mg-de08,
# mg-8b48, mg-0b77) at the OUTCOME layer.
#
# "FAILS CLOSED" IS NOT "FAILS VISIBLY". They are as different as *unreachable*
# and *zero*, which is the distinction the rest of this file is built around.
#
# WHAT LOUD MEANS HERE, AND WHY IT IS NOT A LOG LINE. Architect's ruling: loud
# must be OBSERVABLE FROM OUTSIDE THE THING THAT FAILED. A louder err line into
# an unread log is the same silence with more characters — this script's stderr
# at 03:00 goes to a file nobody opens unless already suspicious, which is the
# state we are trying to cause, not assume. The shape is not invented here:
# sentineldrift.go and orphan.go (mg-0b77) both answer it with a durable event
# PLUS a mail to the coordinator, and this follows that precedent rather than
# inventing a second notion of loud.
#
# WHY THE MAIL IS VERIFIED AND THE EVENT IS NOT COUNTED. mg-0b77's sink is
# best-effort: a failed `mg` shell-out lands in a log line, so the sink can rot
# (a renamed flag, a moved binary) and go silent exactly like the thing it
# reports on. Its answer was a positive control proving the assembled sink fires
# — the ask this ticket inherits, and the live control does that. But a sink that
# fires at most once per run can do better than be proven in a lab: it can READ
# ITS OWN MESSAGE BACK OUT OF THE RECIPIENT'S MAILBOX and refuse to claim a
# delivery it cannot see. That is not proof it CAN fire; it is observation that
# it DID. `pogo events emit` cannot be held to that standard — it is documented
# best-effort and ALWAYS exits 0, so its status cannot distinguish a landed event
# from a dropped one. So it is emitted for mg and the digest, and deliberately
# NOT counted toward delivery. Counting it would be exactly the lie this script
# refuses everywhere else: inferring a fact from a channel that cannot report it.
#
# THE RESIDUAL, STATED HONESTLY. If every outbound channel is dead, this run is
# silent and no code here can fix that — a process whose every channel is gone
# cannot report that its channels are gone. What is bounded is the far more
# likely case: one channel wrong (a renamed coordinator, an unwritable box)
# while another works. Hence two recipients and a readback, not one blind send.
#
# The coordinator's mailbox is not addressed by a name we trust. This default is
# a CLAIM about config ([agents] coordinator) and it decays like any other — so
# it is CHECKED rather than believed: mg reports `mailbox_created` when a send
# invents the box, and for THIS recipient that is proof the name is wrong. The
# coordinator always has a mailbox by the time a nightly redeploy runs; if our
# send had to create one, we just filed the alert in a phantom nobody reads.
# (That is not hypothetical — this box carries a phantom mailbox today, minted by
# a mis-shelled recipient, and it is invisible precisely because it was silent.)
COORDINATOR="${POGO_COORDINATOR:-mayor}"

# MG — the ABSOLUTE path to the macguffin `mg`, resolved once by resolve_mg().
#
# BARE `mg` IS A TRAP, AND IT IS THE BUG THIS SINK WAS SILENTLY LOSING TO
# (mg-015f). On macOS, /usr/bin/mg is the Micro-Emacs text EDITOR. Under any
# PATH where /usr/bin precedes ~/go/bin — a login shell's reordered profile, or
# launchd's minimal PATH (/usr/bin:/bin:/usr/sbin:/sbin, which has NO ~/go/bin) —
# bare `mg` binds to that editor, not the macguffin tracker. Headless it panics
# ("standard input and output must be a terminal") and exits, so a bare-`mg`
# alert delivers NOTHING. The nightly redeploy runs in exactly that launchd
# context: a 03:00 stall alert would invoke the editor, panic, and fail closed
# and SILENT — the precise failure this whole sink exists to prevent.
#
# So every `mg` call in this deploy goes through "$MG", an absolute path to the
# go-installed macguffin binary. NOT a per-wrapper PATH export: that would only
# fix the launchers we happen to control and leaves the script PATH-fragile,
# which is worthless against a nightly launcher we do not control. An absolute
# path makes the deploy PATH-INDEPENDENT, which is the only thing that protects
# the nightly.
MG=""

# resolve_mg — set MG to the macguffin `mg`, or fail loudly. Never falls back to
# an UNVERIFIED bare `mg` (that could be the editor).
#
# It walks a list of candidate binaries and accepts the FIRST that passes a
# macguffin IDENTITY check. Two rules make this safe and PATH-independent:
#
#   1. IDENTITY, NOT EXISTENCE. /usr/bin/mg (the editor) satisfies -x and even
#      `command -v mg`, so locating a candidate never means trusting it. Every
#      candidate must self-identify as macguffin (its --help names "macguffin";
#      the editor's does not — it errors "illegal option -- -") before use. This
#      identity gate is the real safety property: the editor can appear anywhere
#      in the list and is always found-and-rejected, never invoked.
#
#   2. GOPATH CANDIDATES FIRST. The go-install bin dir is derived and tried
#      before any PATH lookup, so the production nightly — launchd's minimal PATH
#      with NO `go` and /usr/bin/mg (editor) ahead of ~/go/bin — resolves the
#      real ~/go/bin/mg without ever consulting PATH. That PATH-independence is
#      the whole point (mg-015f): a per-wrapper PATH export would only fix
#      launchers we control, and we do not control the nightly's.
#
# Deliberately NOT POGO_GOBIN: that overrides where THIS deploy INSTALLS pogod
# and pogo (its target dir, which the sink controls point at a throwaway). mg is
# not a deployed binary — it is a stable external tool macguffin `go install`s to
# the standard go bin dir.
resolve_mg() {
    local cand gobin gopath pathmg
    local -a cands=()
    gobin="$(go env GOBIN 2>/dev/null)"
    [ -n "$gobin" ] && cands+=("$gobin/mg")
    gopath="$(go env GOPATH 2>/dev/null)"
    [ -n "$gopath" ] && cands+=("$gopath/bin/mg")
    # `go` may be off PATH entirely (launchd's minimal PATH has no go), so the
    # env-var and conventional-default GOPATH cover the case where `go env` said
    # nothing. macguffin installs to $GOPATH/bin, default $HOME/go/bin.
    [ -n "${GOPATH:-}" ] && cands+=("$GOPATH/bin/mg")
    cands+=("$HOME/go/bin/mg")
    # LAST RESORT: a macguffin `mg` already on PATH — accepted ONLY if it passes
    # the identity check, so the editor at /usr/bin/mg is rejected here rather
    # than run. This rescues an isolated HOME (the live control sandboxes HOME to
    # isolate the mail STORE, which points every $HOME/go path at an empty tree
    # while the real macguffin binary sits on PATH). Production never reaches this
    # rung — its GOPATH candidate resolves first.
    pathmg="$(command -v mg 2>/dev/null)"
    [ -n "$pathmg" ] && cands+=("$pathmg")

    for cand in "${cands[@]}"; do
        [ -x "$cand" ] || continue
        "$cand" --help 2>/dev/null | grep -q 'macguffin' || continue
        MG="$cand"
        log "mg: resolved macguffin at $MG"
        return 0
    done

    err "mg: no macguffin 'mg' found among the go-install paths or PATH (tried: ${cands[*]})."
    err "mg: refusing bare 'mg' — on this OS that is /usr/bin/mg, the Micro-Emacs EDITOR, which satisfies 'command -v' but panics headless and delivers no alert (mg-015f)."
    return 1
}

# mail_alert RECIPIENT SUBJECT BODY_FILE
# Returns 0 ONLY when the message is READ BACK out of the recipient's mailbox.
# Every other path returns 1 and says which one it took: "we could not tell" and
# "it was delivered" must not collapse, here least of all.
#
# --body-file, not --body: the shell expands $VAR, backticks and $(cmd) inside
# --body="..." before mg ever sees them, and mg reports Delivered on the mangled
# string because it cannot tell it from one you typed (mg-8380). This body
# carries the operator's remedies; it must arrive as written.
mail_alert() {
    local to="$1" subject="$2" body_file="$3"
    local out id created
    # NO --create, deliberately. mg-d639 made an unknown recipient a refusal
    # (no_such_mailbox, exit 3); --create would opt back out of it and re-mint
    # the phantom box this function exists to refuse.
    if ! out="$("$MG" mail send "$to" --from=pogo-self-deploy \
                    --subject="$subject" --body-file "$body_file" --json 2>&1)"; then
        # THE WRONG-RECIPIENT REFUSAL, WHICHEVER SIDE MAKES IT. mg-d639 moved
        # this check from us to mg: before it, a typo'd name minted a dead drop
        # and reported "Delivered", which is why the mailbox_created branch
        # below was written. Now mg refuses first — better, but the refusal
        # arrives as a generic send failure carrying a JSON blob, and "the
        # coordinator name in your config is wrong" is not a thing an operator
        # reads out of {"code":"no_such_mailbox",...} at 03:00.
        #
        # So the diagnosis is attached HERE rather than moved: both mechanisms
        # say the same sentence, because the operator's situation is identical
        # either way and it is the sentence, not the mechanism, that has to
        # survive. The mailbox_created branch stays for an older mg that still
        # auto-creates — this script runs against whatever mg is installed on
        # the box, not against the one in this checkout.
        if printf '%s' "$out" | grep -q 'no_such_mailbox'; then
            err "sink: '$to' had NO mailbox — mg REFUSED the send rather than minting a phantom box nobody reads (no_such_mailbox)"
            err "sink: the recipient name is wrong (POGO_COORDINATOR / [agents] coordinator), not the message"
            return 1
        fi
        err "sink: mg mail send to '$to' failed: $out"
        return 1
    fi
    id="$(printf '%s' "$out" | json_str msg_id)"
    created="$(printf '%s' "$out" | json_bool mailbox_created)"
    if [ -z "$id" ]; then
        err "sink: mg mail send to '$to' exited 0 but named no msg_id: $out"
        return 1
    fi
    if [ "$created" = "true" ]; then
        err "sink: '$to' had NO mailbox — this send CREATED one, so the alert is sitting in a phantom box nobody reads (this mg auto-creates; a post-mg-d639 mg refuses the send instead)"
        err "sink: the recipient name is wrong (POGO_COORDINATOR / [agents] coordinator), not the message"
        return 1
    fi
    # THE READBACK. --all, not the default: the coordinator is a live agent and
    # may read the mail between the send and this probe, which moves it to cur/
    # and out of an unread-only listing. Without --all a FAST reader would look
    # exactly like a lost message and we would escalate over a success.
    # -F: msg_ids are dotted, and we are matching a literal, not a pattern.
    if "$MG" mail list "$to" --all --json 2>/dev/null | grep -Fq "$id"; then
        return 0
    fi
    err "sink: mailed '$to' (msg_id=$id) but could not read it back — treating as UNDELIVERED"
    return 1
}

# alert_external EVENT_TYPE SUBJECT BODY [DETAILS_JSON]
# Returns 0 iff a mail was VERIFIED into a real mailbox, by any recipient.
alert_external() {
    local event_type="$1" subject="$2" body="$3" details="${4:-}"
    local bf rc=1
    local -a ev

    if ! bf="$(mktemp)"; then
        err "sink: cannot create a temp file for the alert body — mailing the subject alone"
        bf=""
    else
        printf '%s\n' "$body" > "$bf" || { err "sink: could not write the alert body"; : > "$bf"; }
    fi

    # Channel 1 — the durable event, for mg and the digest. Best-effort by the
    # bridge's own contract (always exits 0); see the header for why its silence
    # is not counted as delivery.
    if command -v pogo >/dev/null 2>&1; then
        ev=(events emit --type="$event_type" --agent=pogo-self-deploy)
        [ -n "$details" ] && ev+=(--details="$details")
        pogo "${ev[@]}" >/dev/null 2>&1 || true
    else
        err "sink: no 'pogo' on PATH — the $event_type event was not emitted (launchd hands jobs a minimal PATH; the nightly wrapper must set it)"
    fi

    # Channel 2 — the mail. The loud half, and the only one we verify.
    if [ -n "$bf" ] && mail_alert "$COORDINATOR" "$subject" "$bf"; then
        log "sink: alerted '$COORDINATOR' and read the message back out of the mailbox"
        rc=0
    elif [ -n "$bf" ] && mail_alert human "$subject" "$bf"; then
        err "sink: could not verify a mail to coordinator '$COORDINATOR' — escalated to 'human' instead"
        rc=0
    else
        err "sink: NO EXTERNAL ALERT WAS DELIVERED — neither '$COORDINATOR' nor 'human' could be reached."
        err "sink: this run is now as silent as it was before mg-f206; the $event_type event (if it landed) is the only trace."
        rc=1
    fi
    [ -n "$bf" ] && rm -f "$bf"
    return $rc
}

# alert_drain_stalled REASON LEFTOVER — the exit 7 sink.
#
# `leftover` is a COUNT or the "?" sentinel. "?" is carried into the mail
# verbatim — the operator must see "we could not count them", not a fabricated
# number — but it is not a JSON number, so the event's `leftover` is emitted as a
# STRING. Quoting it keeps both facts expressible in one field rather than making
# "?" masquerade as 0, which is the count-vs-unknown collapse this file exists to
# refuse (mg-76e5).
#
# REASON SELECTS THE STORY, AND IT HAS TO (mg-65b2). Exit 7 now has two causes,
# and they are different situations needing different reactions:
#
#   timeout — the fleet was BUSY at the deadline. Nothing is wrong; the deploy
#             just didn't happen. Ignore it once; investigate if it repeats.
#   unknown — the drain could not establish the fleet's state at all. Something
#             IS wrong (pogod went silent mid-drain, or its readout is
#             unreadable), and it wants a human now.
#
# Before this the body narrated the timeout unconditionally: "the drain waited
# ${DRAIN_TIMEOUT}s ... and N were still active at the deadline". Sent for an
# unknown, every clause of that is false — no deadline passed, nothing was
# counted — and the "ignore it once" advice is exactly wrong. An alert that
# invents a confident story about a state we admitted we could not read is this
# ticket's defect wearing the sink's hat, so the sink gets told which one it is
# rather than assuming.
alert_drain_stalled() {
    local reason="$1" leftover="$2"
    local subject preamble what verdict todo
    case "$reason" in
        unknown)
            subject="[deploy-stalled] nightly pogod redeploy did NOT deploy — FLEET STATE UNKNOWN"
            preamble="The fleet's state is UNKNOWN — this is not the routine busy-fleet stall.
Something stopped answering, and this run refused rather than guess. The
refusal is correct and nothing was destroyed, but the CAUSE is still there
and the next run will refuse the same way until a human looks."
            verdict="This IS worth looking at, unlike a plain drain timeout: the deploy did not
happen AND the reason it did not happen is itself a fault. Refusing was the
safe outcome, not a resolution."
            what="the drain could not establish whether any polecat is alive.
                pogod stopped answering its drain readout mid-drain, or answered
                something unreadable, and the on-disk polecat witness could not
                settle it either. Bouncing a fleet whose state is unknown can
                mint PERMANENT survivors — polecats setsid out of the process
                group, outlive kickstart -k, and go invisible to every future
                registry — so this run refused. Nothing was killed or deployed."
            todo="WHAT TO DO. Unlike a plain drain timeout, this one is NOT routine and does
not clear itself. Look now:
  - Is pogod alive and answering?  curl $(base_url)/agents/drain
  - If it is WEDGED but the fleet is idle, the redeploy is the repair and will
    proceed on its own once pogod answers — or force it: redeploy --force.
  - If polecats ARE live, let them finish; do NOT --force. It re-gates mg-0b77
    and mg-13a3, and 46a4 measured that --force neither waits nor reliably
    kills: kickstart -k kills the job's process group, and polecats setsid out.
  - 'pogo agent witness' reports what the on-disk witness can still see with
    pogod down. If it says the witness is missing or unreadable, that is the
    double absence that produced this alert — fix the witness first."
            ;;
        *)
            subject="[deploy-stalled] nightly pogod redeploy did NOT deploy — $leftover polecat(s) hold unpushed work"
            preamble="Fleet is HEALTHY and dispatching. Nothing is broken. That is the problem:
this run failed CLOSED and produced no other signal, so the fleet is simply
NOT TRACKING main and every light stays green while it doesn't."
            verdict="This is NOT an emergency and NOT a bug. It is the safe outcome, reported —
the deploy simply did not happen and you would otherwise never learn that."
            what="the drain waited ${DRAIN_TIMEOUT}s and $leftover polecat(s) still held
                COMMITS THAT EXIST ONLY IN THEIR WORKTREE — nothing on origin holds
                them. That is the whole predicate. It is NOT 'polecats are running',
                and since mg-3a96 it is NOT 'the refinery has not merged them'
                either: a branch already pushed to origin is DURABLE and does not
                hold this deploy for one second, however long the refinery takes.
                The run log names each holder and how many local-only commits it
                has. Deploying past that means killing the only process that was
                ever going to push those commits, which needs --force, and --force
                is deliberately not armed on the nightly."
            todo="WHAT TO DO. Nothing, if this is a one-off: a merge queue was backed up at
03:00 and the next run will deploy. It matters when it REPEATS — a nightly that
stalls every night has silently stopped tracking main, which looks identical to
one that succeeds every night. So:
  - Once:      ignore it.
  - Repeatedly: this is a POLECAT question, not a refinery one — mg-3a96 cut the
               refinery out of this predicate entirely, so a backed-up merge queue
               can no longer produce this alert. Something is committing and not
               pushing: a polecat wedged mid-turn after a commit, or one killed
               between 'git commit' and 'git push'. Read the branch names in the
               run log above and check whether those polecats are alive and
               progressing ('pogo agent list'). Raising --drain-timeout is unlikely
               to help: a polecat that is not pushing does not push because the
               window got longer.
  - Do NOT 'fix' this by adding --force. It re-gates mg-0b77 and mg-13a3 (read
    them first), and 46a4 measured that --force neither waits nor reliably kills:
    kickstart -k kills the job's process group and polecats setsid out of it."
            ;;
    esac
    alert_external deploy_stalled \
        "$subject" \
        "A pogod redeploy refused to deploy and exited WITHOUT changing anything.

$preamble

What happened:  $what
Deploy ref:     $DEPLOY_REF
Running pogod:  $(short "${RUNNING:-?}")
Installed pogod:$(short "${INSTALLED:-?}")
Installed pogo: $(short "${INSTALLED_CLI:-?}")
main:           $(short "${MAIN:-?}")
Dispatch:       RESTORED (the exit trap put back draining=${DRAIN_PRIOR:-?}).
                No polecat was killed. No worktree was touched. Nothing deployed.

$verdict

$todo

Redeploy by hand when the fleet is idle:
  scripts/pogo-self-deploy redeploy --yes" \
        "{\"leftover\":\"${leftover}\",\"reason\":\"${reason}\",\"drain_timeout\":${DRAIN_TIMEOUT},\"deploy_ref\":\"${DEPLOY_REF}\",\"outcome\":\"no_deploy\"}"
}

# Pure decision function (unit-tested): map the POST /agents/drain HTTP status
# to a drain-phase disposition. Echoes exactly one word:
#   drain      — 2xx: endpoint present, proceed to drain_wait
#   bootstrap  — 404: server answers but predates the drain endpoint (mg-cae1);
#                the one-time self-deploy chicken-and-egg (mg-065e)
#   stopped    — 503: pogod is UP and in index-only mode; orchestration is
#                stopped. The only thing that returns 503 on this route is
#                RequireOrchestration (mg-0155, mg-6d2f)
#   down       — 000/empty: pogod not answering (connection refused / timeout)
#   error:<c>  — any other status; refuse rather than guess
#
# WHY 503 IS NOT "UNEXPECTED" (mg-0155). It is designed behaviour and it names
# exactly one state. `RequireOrchestration` (internal/server/server.go) answers
# 503 with `{"error":"orchestration is stopped"}` for everything under
# `/agents/`, `/refinery/` and `/scheduler/` whenever the mode is not `full`
# (cmd/pogod/main.go), and `/agents/drain` is wrapped by it. It is also the ONLY
# non-test source of a 503 on this route: `handleDrain` itself answers 200, 400
# or 405 and nothing else, and the other 503s in the agent API belong to
# `failPolecatSpawn` on `/agents/spawn-polecat`. So a 503 here means pogod was
# not in full mode — a named state with a one-command remedy — where the
# `error:*` branch means "we do not know, refuse rather than guess". Sending an
# operator to guess about a state the daemon just named is the defect, not the
# absence of a case arm.
#
# `stopped` is a HYPOTHESIS, not a verdict, and the caller confirms it against
# /server/mode before saying so out loud. A status code is the wrong evidence to
# announce an outage from: this function sees three digits and nothing else, and
# "503 therefore the fleet is stopped" is precisely the shape of confident
# inference the drain gate had to unlearn (mg-65b2). The confirmation costs one
# unguarded GET and turns a plausible reading into a measured one.
classify_drain_precondition() {
    case "$1" in
        2??)     echo "drain" ;;
        404)     echo "bootstrap" ;;
        503)     echo "stopped" ;;
        000|"")  echo "down" ;;
        *)       echo "error:$1" ;;
    esac
}

# drain_probe — GET the drain readout and echo BODY, then a final line carrying
# the HTTP status. One hop, two facts: the body we must parse and the status
# classify_drain_precondition needs to rule on it. Mirrors drain_post's `-w
# '%{http_code}'` trick, and for the same reason — curl (no -f) writes "000" for
# connection refused / DNS / timeout, so a numeric-but-non-2xx code always means
# the server answered.
#
# Deliberately NOT two calls. Fetching the body and then the status separately
# would let them describe different moments — a body from a live pogod and a
# status from a dead one — and the whole point of the caller is to stop treating
# two world-states as one.
drain_probe() {
    curl -s -w '\n%{http_code}' --max-time 5 "$(base_url)/agents/drain" 2>/dev/null
}

# refuse_drain_precondition DISPOSITION — report a drain-phase refusal and exit.
# NEVER RETURNS. Every disposition exits 6, and that is deliberate (mg-0155) —
# with ONE exception, added by mg-6d2f and described under EXIT 12 below.
#
# WHAT EXIT 6 IS ALLOWED TO MEAN. "The drain precondition refused, before the
# build." That is a claim about WHERE the run stopped, which is the most an
# integer can honestly carry, and it is true of all four dispositions. What it
# must NOT be asked to carry is WHICH refusal — `bootstrap`, `down`, `stopped`
# and `error:<c>` need four different operator reactions, and the difference
# between them travels on the reason channel (deploy_reason_record), not on the
# code.
#
# EXIT 12, AND WHY IT IS NOT THE THING THIS FUNCTION ARGUES AGAINST (mg-6d2f).
# A `stopped` disposition CONFIRMED against /server/mode exits 12 rather than 6.
# The argument below is against codes assigned per SITE, because operator-facing
# text was derived from the code and stories are needed per CAUSE. 12 is not
# that: the text still comes from here, verbatim, over the reason channel. What
# 12 carries is a property of the WORLD at exit — the fleet is not dispatching
# right now — which the runner needs BEFORE it has read the record, because it
# picks the mail subject from it. A reader who skims one line has to be able to
# tell "tonight's deploy did not land" from "nothing is running". That is a
# routing fact, not a story, and it is the one thing an integer is good at.
#
# WHY NOT FOUR CODES. Because that is the fix that has now been made four times.
# The runner used to render its whole RED alert from the exit code alone, so a
# code meaning four things forced it to pick one story for all four — and it
# picked a fifth: `describe_exit 6` said "post-restart verification failed" and
# handed the reader the exit-8 remedy, "The new pogod was installed and started
# but did not verify [...] the binary on disk is the NEW one". On 2026-08-07
# 03:00 that went out over a run that died at the FIRST step, `elapsed: 0s`,
# with `running == installed == d31297f`: no install, no split-brain, nothing to
# roll back, and the real cause (orchestration was stopped) visible only in a log
# line the alert did not carry.
#
# Splitting the code would have fixed that instance the way mg-8f7e (per-code
# remedies), mg-65b2 (a discriminator for alert_drain_stalled) and mg-0d70 (a
# new code for the transient sync class) each fixed theirs — correctly, and one
# exit path short of the next one. The generator is that operator-facing text was
# DERIVED FROM THE CODE, while codes are assigned per SITE and stories are needed
# per CAUSE. Every new failure path therefore either reuses a code and inherits a
# story about a different failure, or needs a fresh integer and a hand-written
# paragraph. Both arms guarantee the next instance.
#
# So the sentences below are written once, here, at the only place that knows
# which refusal this is — and they are what the operator reads, verbatim. See
# docs/deploy-exit-paths.md for the full enumeration of every exit in this
# script and what each one leaves behind.
#
# EVERY branch here exits BEFORE do_build: nothing is built, installed or
# restarted and there is nothing to roll back. The record says so in a field
# (`installed=no`) AND each branch says so in words, because the field is what
# the runner reasons about and the words are what a human reads.
#
# THE SECOND ARGUMENT IS WHAT THE DAEMON SAID (mg-08e9), and it is optional so
# that a caller which has no body — or an older test harness — still gets every
# sentence below. Each branch prints it as its own `err` line, which is copied
# verbatim into the reason record and therefore into the RED alert.
#
# It is not a decoration on the prose above it. The sentences below are an
# INFERENCE: they say what a status must have meant given how pogod is currently
# wired. The body is the daemon's own account of the same moment. Printing both
# means the alert can be checked instead of believed, and it is the only way a
# stale inference — a middleware added above the mux, a proxy in front of the
# port — ever surfaces rather than being confidently mis-narrated.
refuse_drain_precondition() {
    local disp="$1" body="${2:-}"
    # Rendered once: four branches would otherwise each carry the expansion, and
    # three of them would eventually disagree about the bound.
    local said; said="$(fmt_http_body "$DRAIN_BODY_MAX" "$body")"
    case "$disp" in
        bootstrap)
            disarm_drain_restore "HTTP 404 means the mux found no /agents/drain route to run"
            err "bootstrap: this pogod predates the /agents/drain endpoint (HTTP 404 from mg-cae1's feature)"
            err "it answered: $said"
            err "the pogod you are replacing does not yet have the drain feature you are deploying —"
            err "the one-time self-deploy chicken-and-egg. Nothing to drain via the API."
            err "re-run with --skip-drain to rebuild+restart without draining (safe when the fleet is idle)."
            err "this run built nothing, installed nothing and restarted nothing — it changed NOTHING."
            exit 6
            ;;
        down)
            # DELIBERATELY NO "it answered" LINE. `down` is 000/empty, which is
            # curl reporting that nothing answered — so there is no body, and
            # rendering the absent one as "(empty body — the server answered,
            # but said nothing)" would assert the very thing this disposition
            # denies. An unreachable daemon and a silent one are different
            # facts; that distinction is what the whole file is built around.
            err "pogod is not answering POST $(base_url)/agents/drain (connection refused / timeout)"
            err "this is NOT the bootstrap case — the server did not respond at all. Start pogod, then retry."
            err "this run built nothing, installed nothing and restarted nothing — it changed NOTHING."
            exit 6
            ;;
        stopped)
            disarm_drain_restore "HTTP 503 is RequireOrchestration answering before the drain handler runs"
            # CONFIRM BEFORE ANNOUNCING (mg-6d2f). `stopped` is a HYPOTHESIS
            # drawn from three digits, and "503 therefore the fleet is stopped"
            # is exactly the shape of confident inference the drain gate had to
            # unlearn (mg-65b2). One unguarded GET turns it into a measurement.
            local mode; mode="$(server_mode)"
            if [ "$mode" != "index-only" ]; then
                # The code and the mode endpoint disagree. Do not narrate an
                # outage that was just not confirmed; report both readings and
                # refuse. This is the branch that surfaces a stale inference —
                # a middleware above the mux, a proxy in front of the port.
                err "unexpected HTTP 503 from POST $(base_url)/agents/drain, but /server/mode reports '$mode' — refusing to proceed"
                err "it answered: $said"
                err "503 on this endpoint comes from RequireOrchestration, so these two readings should agree."
                err "this run built nothing, installed nothing and restarted nothing — it changed NOTHING."
                err "establish what is actually running before deploying anything:"
                err "    curl -s $(base_url)/server/mode"
                err "    curl -s $(base_url)/version"
                exit 6
            fi
            # THE 2026-08-07 NIGHT, EXACTLY. The 503 came from
            # RequireOrchestration: pogod was up and had been up since 08-04, but
            # orchestration was off, so this deploy's very first live action
            # failed and it exited at 0s — before do_build, before do_prove,
            # before do_restart. The restart step never ran.
            #
            # What made that cost 10h39m was not the refusal, which is correct: a
            # deploy must not kickstart -k a fleet it could not drain. It was
            # that the refusal exited anonymously on 6, sharing a code AND a
            # story with two unrelated causes, while the one fact worth waking
            # somebody for — the fleet is stopped RIGHT NOW and this run did not
            # restart it — appeared nowhere a skim-reader would meet it. Exit 12
            # is what the runner keys the FLEET DOWN subject and banner off; it
            # is not a per-site code (the thing mg-0155 argues against) but a
            # per-OUTCOME one, and the outcome is "there is an outage in
            # progress", which is a different kind of night from "the deploy did
            # not land".
            err "THE FLEET IS DOWN: orchestration is STOPPED and this deploy did not restart it — POST $(base_url)/agents/drain answered HTTP 503"
            # The daemon's own words, beside the inference drawn from them. Agree
            # and the diagnosis is confirmed; disagree and the reader has just
            # learned that a 503 on this route no longer means what the sentence
            # below says it means — which is the only way that ever surfaces.
            err "it answered: $said"
            err "confirmed against $(base_url)/server/mode, which reports index-only."
            err "pogod is UP and healthy — it is in index-only mode, so it refuses everything under"
            err "  /agents/, /refinery/ and /scheduler/ with 503. That is designed behaviour"
            err "  (RequireOrchestration, internal/server/server.go), not a fault and not a corrupt install."
            err "  So NO polecat is being dispatched and NO merge is running, and the box will look"
            err "  healthy while it happens: the port answers, the process is old and stable."
            err "this run built nothing, installed nothing and restarted nothing — it changed NOTHING,"
            err "  and dispatch was never touched, so there is no drain to clear and nothing to roll back."
            err "  The refusal itself is correct — a deploy cannot drain a fleet it cannot reach, and"
            err "  kickstart -k without a drain mints permanent polecat survivors — but it leaves the"
            err "  fleet exactly as stopped as it was a moment ago."
            err "restart orchestration, then re-run the redeploy:"
            err "    pogo server start                      # restarts orchestration when the mode is index-only"
            err "    curl -sX POST $(base_url)/server/start-orchestration   # the same thing without the CLI"
            err "confirm with: curl -s $(base_url)/server/mode   # expect {\"mode\":\"full\"}"
            exit 12
            ;;
        error:*)
            err "unexpected HTTP ${disp#error:} from POST /agents/drain; refusing to proceed"
            err "it answered: $said"
            err "the server ANSWERED, so this is neither the bootstrap 404 nor a down pogod, and it is not"
            err "  the 503 that means orchestration is stopped. This branch is deliberately the one that"
            # This sentence used to read "the status above is the whole of what
            # is known", and it was true — the body went to /dev/null. It is not
            # true any more, and leaving it would have this branch refuse to
            # guess while telling the reader there was nothing else to look at.
            err "  does not guess: the status and the answer above are the whole of what is known, and no"
            err "  story is invented to join them."
            err "this run built nothing, installed nothing and restarted nothing — it changed NOTHING."
            exit 6
            ;;
        *)
            # Unreachable via classify_drain_precondition, which emits exactly
            # the words above. Present so a future disposition cannot fall out
            # of a case statement into `drain` by silence — the failure mode
            # this whole function exists to stop.
            err "internal error: refuse_drain_precondition called with unknown disposition '$disp'"
            err "this run built nothing, installed nothing and restarted nothing — it changed NOTHING."
            exit 6
            ;;
    esac
}

# witness_alive_count — consult the SECOND witness (mg-13a3) about whether any
# polecat is alive, WITHOUT pogod. Echoes a count and returns 0 when that count
# is a measurement; echoes "?" and returns 1 when the witness cannot answer.
#
# WHY A CLI HOP IN A CURL-AND-SED SCRIPT. The header's rule is "call only STABLE
# primitives; keep it dumb", and reading the JSON here with the seds above would
# obey its letter. It would break the rule that matters. "Alive" is not "the pid
# is in the file" — it is kill(pid,0) AND a `ps -o lstart=` identity match,
# because a bare pid is a false witness (pids get recycled). That test already
# exists, unit-tested, in ONE place, whose own doc names this caller: "if they
# ever disagreed about what 'our process is alive' means, the drain and the
# reaper would be reasoning about different fleets." A shell re-implementation
# would be a second definition of the word, free to drift silently — the same
# mistake as growing a private notion of "down" beside
# classify_drain_precondition, which the ruling on mg-65b2 forbade twelve lines
# up. So: one definition, reached over a process boundary.
#
# THE DEPENDENCY FAILS CLOSED, WHICH IS WHY IT IS TOLERABLE. `pogo` is a binary
# this script DEPLOYS, so leaning on it here is a real coupling. Every way it can
# fail — missing from PATH, too old to know the subcommand, broken — exits
# non-zero and lands on "?", i.e. REFUSE. A broken CLI cannot manufacture a
# confident zero, and that asymmetry is the whole reason this hop is safe. Note
# the consequence honestly: until a redeploy installs a `pogo` carrying `agent
# witness`, the down-branch below always refuses. That is the safe direction and
# --force is the escape, but it is a real change of behaviour on the first night.
#
# BOUND OF THE INSTRUMENT, STATED RATHER THAN GLOSSED. The witness only knows
# polecats spawned by a pogod carrying mg-13a3. A survivor of a PRE-witness pogod
# is invisible to it — exactly as it is to the registry — so a present witness can
# under-count. That is the same limit 13a3 shipped with, it shrinks to nothing as
# the box's pogod moves past that commit, and it is not a reason to prefer the
# unconditional zero this replaces.
witness_alive_count() {
    local out rc n msg
    # 2>&1 on purpose: on the happy path the command says nothing on stderr, and
    # on a sad one — an OLD `pogo` that answers this subcommand with cobra's
    # usage text rather than our JSON — the complaint is the only diagnostic
    # there is, and it belongs in the operator's log rather than /dev/null.
    out="$("$POGO_CLI" agent witness --json 2>&1)"; rc=$?
    # The reason as a sentence, falling back to whatever came out if it was not
    # our JSON at all (again: the old-CLI case).
    msg="$(printf '%s' "$out" | json_str error)"; msg="${msg:-$out}"
    case "$rc" in
        0)
            n="$(printf '%s' "$out" | json_num alive_count)"
            case "$n" in
                ''|*[!0-9]*)
                    err "witness: '$POGO_CLI agent witness' returned no readable alive_count: $msg"
                    echo "?"; return 1 ;;
            esac
            echo "$n"; return 0 ;;
        2)
            err "witness: $msg"
            echo "?"; return 1 ;;
        *)
            err "witness: cannot read the on-disk polecat witness (rc=$rc): $msg"
            echo "?"; return 1 ;;
    esac
}

# ---------------------------------------------------------------------------
# THE DRAIN PREDICATE: "WOULD STOPPING THIS POLECAT LOSE WORK?" (mg-3a96)
# ---------------------------------------------------------------------------
# WHAT THIS REPLACED AND WHY IT HAD TO — TWICE. Read both narrowings; the second
# one is only legible against the first.
#
# FIRST NARROWING (mg-853a). The drain used to poll pogod's polecat COUNT to
# zero. That predicate is not satisfiable on this box: the nightly redeploy
# failed eight consecutive nights, and nights 7-8 were this exact stall —
# polecats outliving the 7200s budget, exit 7, fleet untouched. The population
# doing the outliving is compute-bound research work (measured: 392% Python under
# one polecat dir, five more at 38-44%), and a multi-hour combinatorics search
# does not finish because a deploy window opened. There is no drain budget it
# fits inside and the window is 4h wide by construction, so raising
# --drain-timeout cannot work and neither can adding retry fires: a maximal
# attempt consumes every hourly slot.
#
# SECOND NARROWING (mg-3a96 — this one). mg-853a replaced "is it running?" with
# "does it OWE THE REFINERY A MERGE?". That is still the wrong question, and
# mg-5472 measured what it costs by replaying both real stalls against the exact
# quantity the old predicate read (the reflog of refs/remotes/origin/<branch>):
#
#   2026-07-31 — all five polecats read `clear` at the drain's FIRST poll.
#                mg-853a fixes that night outright; the budget was simply too
#                small. The three survivors pushed 30, 33 and 47 minutes AFTER
#                the timeout and merged in 2.4-2.6s each.
#   2026-08-06 — exactly ONE of the four blockers, cat-z37ad, read `owes` — and
#                it read `owes` for the ENTIRE 7200s. origin/polecat-z37ad was
#                pushed and not contained in main from 22:48:36Z to 11:18:44Z,
#                12h30m, across four refinery attempts (a rebase conflict, then
#                three gate failures of 60-94 min each) with the gaps being a
#                single-lane queue serving other branches. Under mg-853a the
#                wait-set shrinks 4 -> 1 and THE DEPLOY STILL EXITS 7.
#
# So merge-debt is not merely an imperfect proxy for the question that matters.
# It is INVERTED. A polecat that has pushed its branch to origin has made its
# work DURABLE: the branch survives the restart, and the refinery can land it
# afterwards. That polecat is the SAFEST thing in the fleet to stop. mg-853a
# waited for precisely it, which is how a branch nobody could land held an entire
# deploy for 7,200 seconds while being completely safe to interrupt.
#
# THE QUESTION THIS ASKS INSTEAD (pm-pogo, ruled 2026-08-07 on mg-3a96):
#
#     WOULD STOPPING THIS POLECAT LOSE WORK?
#
# The drain exists to reach a state where restarting pogod is SAFE. It does not
# exist to make the refinery finish. Work is lost when a commit exists ONLY in
# this worktree — nothing on origin holds it, and the process that would have
# pushed it is the one we are about to kill. That is what this waits on, and
# nothing else. The wait is bounded by the polecat's own next push (seconds),
# not by a merge queue serving other branches (12h30m, measured).
#
# THIS IS WHAT DECOUPLES THE DEPLOY FROM REFINERY HEALTH (ruling rule 3). Under
# mg-853a the chain ran: a test-harness bug turns main red -> the refinery lands
# nothing -> every pushed branch reads `owes` -> the drain stalls -> the deploy
# fails. FOUR LINKS from a fixture defect to a missed deploy, converting one
# outage into two and doing it silently. This predicate never asks whether the
# refinery landed anything, so that chain has no first link any more.
# Pushed-but-unlanded branches are REPORTED — see drain_durability's
# `awaiting the refinery` marker — and the deploy proceeds.
#
# NO FUTILITY DETECTOR IS NEEDED, AND THAT IS NOT AN OMISSION. Rule 4 of the
# ruling required one IF ANY MERGE-WAITING WERE RETAINED. None is. Do not add a
# merge-waiting term back and then reach for a detector to bound it: the detector
# would be bounding a term that should not exist.
#
# UNCOMMITTED WORK IS DELIBERATELY NOT WAITED FOR, AND ITS CONTROL IS ALREADY
# SHIPPED. The ruling's prose names "uncommitted or unpushed" as the unsafe
# state; only the second half belongs here, for two reasons that were checked
# rather than assumed:
#
#   1. A BOUNCE DOES NOT DESTROY AN UNCOMMITTED WORKTREE. gitgc.RemoveWorktree
#      REFUSES a worktree holding uncommitted work and names the files (mg-ee02,
#      internal/gitgc/gitgc.go; the positive control in internal/gitgc/dirty_test.go
#      asserts the file survives the refused removal), and mg-32e3 taught the
#      preserved-worktree notice to name the work item. Nothing here needs to
#      re-protect it, and a second guard in a second language would only rot.
#   2. WAITING ON IT WOULD REBUILD THE UNSATISFIABLE PREDICATE mg-853a REMOVED.
#      The compute-bound population is dirty for hours by construction, so a
#      dirtiness term waits forever — the original stall's exact shape, and the
#      opposite of the ruling's "bounded by the polecat finishing its push".
#
# The genuinely exposed state is COMMITTED BUT UNPUSHED: the tree is CLEAN, so
# mg-ee02 does not fire and the worktree is reapable. The local branch itself
# survives a sweep while its ticket is unconcluded (internal/gitgc/sweep.go keeps
# a branch whose ticket has not concluded), so what the bounce destroys is not
# the objects but the only process that was ever going to push them. That is what
# "orphan" means in rule 2 of the ruling, and it is enough to wait on.
#
# WHY THIS SCRIPT IS THE SITE, AND THE ONLY ONE. The bootstrap constraint is the
# whole reason the narrowing lives in shell rather than in pogod. The runner
# re-syncs deploy-src from origin immediately before invoking this file:
#
#     02:00:10Z  sync: deploy-src at main <sha>
#     02:00:11Z  redeploy: deploy-src/scripts/pogo-self-deploy ... --drain-timeout 7200
#
# so a change here is live on the NEXT nightly with no redeploy required. Every
# alternative ships inside pogod, and the only thing that installs pogod is the
# redeploy it would unblock (mg-b468 is exactly that trap: verified by
# `git merge-base --is-ancestor e354eba d31297f` -> NO). This is the one step
# that can act BEFORE a successful redeploy.
#
# NOTHING NEW HAD TO SHIP FOR IT. The seam already exists on the 7-day-old daemon
# we are stuck on (d31297f): GET /agents/drain already returns
# polecats[].{name,pid,work_item_id,worktree_dir,source_repo}, and worktree_dir is
# the handle — git can be asked directly, per polecat, whether that worktree holds
# commits that exist nowhere else. No new endpoint, no new field. mg-3a96 narrows
# the QUESTION asked of that same seam; it asks for nothing new to answer it.
#
# THE OMISSIONS ARE RULED, NOT OVERLOOKED. Detached compute still falls outside
# this — an orphan has no registry entry AND holds no worktree we can read, so it
# fails both terms. That is pm-pogo's ruling on mg-797d; see "DETACHED COMPUTE IS
# DELIBERATELY NOT WAITED FOR" below before adding a term for it.
#
# THE ENV KNOB KEEPS ITS OLD NAME ON PURPOSE. POGO_DEPLOY_MERGE_TARGETS still
# names the integration branches, and renaming it here would silently drop any
# override already set on this box — a rename is not free when the setting lives
# outside the repo.
DRAIN_MERGE_TARGETS="${POGO_DEPLOY_MERGE_TARGETS:-refs/remotes/origin/main refs/remotes/origin/master}"

# integration_ref WORKTREE -> the ref a landed branch must be contained in.
# Echoes the first of DRAIN_MERGE_TARGETS that resolves; returns 1 (echoing
# nothing) if none does, which the caller turns into `unknown` rather than into
# a verdict. "I could not find the branch to compare against" is not an answer.
integration_ref() {
    local wt="$1" ref
    for ref in $DRAIN_MERGE_TARGETS; do
        if git -C "$wt" rev-parse --verify --quiet "$ref" >/dev/null 2>&1; then
            printf '%s' "$ref"; return 0
        fi
    done
    return 1
}

# durability_of WORKTREE -> "<verdict> <detail>". Exactly one verdict word:
#
#   durable  — every commit in this worktree exists somewhere a pogod restart
#              cannot reach past: on SOME ref under refs/remotes/origin/ — not
#              necessarily this branch's own (see test 2b) — or already in the
#              integration branch. Stopping this polecat loses nothing. It may be
#              busy for hours and it may be waiting on the refinery; neither is
#              this predicate's business. DOES NOT HOLD THE DRAIN.
#   unpushed — the worktree holds commits that exist ONLY here. Stopping now
#              orphans them. HOLDS THE DRAIN — and the hold is bounded by the
#              polecat's own next push, not by anything the refinery does.
#   unknown  — git could not answer. Held like `unpushed` and reported as
#              ITSELF: a question we failed to ask is not an answer of "durable",
#              and this file's whole history is the cost of rendering one as the
#              other (mg-65b2, mg-0b77, mg-76e5).
#
# THE `durable` DETAIL SAYS WHETHER THE REFINERY STILL HAS IT. A branch pushed
# and not yet landed carries the marker `awaiting the refinery`, so the deploy log
# records what it bounced past instead of quietly not mentioning it. That is a
# REPORT, not a wait — see "THIS IS WHAT DECOUPLES THE DEPLOY FROM REFINERY
# HEALTH" above, and do not turn the marker into a term.
#
# ONLY THE WORKTREE IS CONSULTED, not source_repo. A polecat worktree shares its
# `.git` infrastructure with the source repo, so origin/<branch> and origin/main
# are both readable from inside it — and asking the worktree is what makes the
# answer about THIS polecat rather than about the repo it came from.
#
# FOUR BOUNDS, STATED RATHER THAN GLOSSED:
#
#   1. EVERY origin ref read here is a local remote-tracking ref, so it reflects
#      what THIS clone last pushed or fetched. That is precisely right for the
#      question asked: the polecat pushes from this worktree, so its own push is
#      what writes the ref. A branch pushed from somewhere else entirely is
#      invisible here — and so is its polecat, which is not in this registry
#      either. Test (2b) widens the SET of refs consulted from origin/<branch> to
#      all of refs/remotes/origin/, which extends this bound rather than adding a
#      class: a SHA that origin has since force-pushed away still has a stale
#      tracking ref pointing at it, and (2b) would call it durable. A force-push
#      does not unpublish — the commits stay servable by SHA — so the residual is
#      "harder to find", not "lost", which is the same shape bound 1 has always
#      accepted for origin/<branch> (gh#134, mg-fd94).
#   2. THE REFINERY REBASES AND THEN REAPS, so the obvious test is not enough.
#      internal/refinery/merge.go runs `push origin --delete <branch>` after a
#      successful merge (step=branch-reap), and the landed commits carry DIFFERENT
#      SHAs because the branch was rebased onto main first. For a just-merged
#      polecat both containment tests therefore fail — origin/<branch> is gone and
#      HEAD's SHAs are not in main — and a naive durability test would report
#      `unpushed` for work that demonstrably landed, holding the deploy on a
#      branch nobody is ever going to push again. Test (4) below exists for
#      exactly that case: `git cherry` compares PATCH IDS, which survive a rebase.
#   3. `git cherry` can in principle be fooled by a genuine patch-id twin: every
#      local commit would have to match a commit already on the integration branch
#      since the merge base. That is the ONLY permissive branch in this function —
#      it would let a bounce past work byte-identical to work already landed — and
#      it is placed LAST, reached only when both containment tests have already
#      failed and only when the integration ref really resolved.
#   4. A work item can target a branch other than main (`mg new --branch`). Under
#      mg-853a that read as `owes` and held the deploy — a bound that ticket
#      stated and accepted. It DISSOLVES here: a pushed branch is durable whatever
#      it targets, because test (1) never mentions the integration branch.
#      DRAIN_MERGE_TARGETS is now consulted only to spare the unpushed case a
#      false hold, so widening it can no longer release a hold that mattered.
durability_of() {
    local wt="$1" branch head tip target tname cherry rc ahead holder
    [ -n "$wt" ]  || { echo "unknown no worktree_dir in the drain snapshot"; return 0; }
    [ -d "$wt" ]  || { echo "unknown worktree $wt does not exist"; return 0; }
    git -C "$wt" rev-parse --git-dir >/dev/null 2>&1 \
        || { echo "unknown $wt is not a git worktree"; return 0; }
    branch="$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null)"
    { [ -n "$branch" ] && [ "$branch" != "HEAD" ]; } \
        || { echo "unknown cannot name the branch checked out in $wt"; return 0; }
    # An unborn HEAD holds no commits at all, so there is nothing a bounce can
    # orphan. A measurement, not a fallback: `rev-parse --verify HEAD` fails only
    # when there is genuinely nothing committed, and every other git failure was
    # already caught by the --git-dir probe above.
    head="$(git -C "$wt" rev-parse --verify --quiet HEAD 2>/dev/null)"
    [ -n "$head" ] || { echo "durable no commits yet on $branch in $wt"; return 0; }

    tip="$(git -C "$wt" rev-parse --verify --quiet "refs/remotes/origin/$branch" 2>/dev/null)"
    target="$(integration_ref "$wt")" || target=""
    tname="${target##refs/remotes/}"; tname="${tname:-the integration branch}"

    # (1) THE COMMONEST DURABLE, AND THE ONE mg-853a HAD BACKWARDS: the polecat
    #     pushed, and origin/<branch> holds everything it has. Whether the
    #     refinery has landed it is reported, never waited on.
    if [ -n "$tip" ] && git -C "$wt" merge-base --is-ancestor "$head" "$tip" 2>/dev/null; then
        if [ -n "$target" ] && git -C "$wt" merge-base --is-ancestor "$head" "$target" 2>/dev/null; then
            echo "durable origin/$branch holds every local commit, and is contained in $tname"
        else
            echo "durable origin/$branch holds every local commit; awaiting the refinery (not yet in $tname)"
        fi
        return 0
    fi

    # (2) Nothing here that the integration branch does not already contain: a
    #     fresh worktree sitting at origin/main, or a branch that landed as a
    #     fast-forward. Distinct from (1) — this one never pushed anything.
    if [ -n "$target" ] && git -C "$wt" merge-base --is-ancestor "$head" "$target" 2>/dev/null; then
        echo "durable nothing committed on $branch that $tname does not already contain"
        return 0
    fi

    # (2b) SOME OTHER origin ref holds HEAD — ask whether ANY of them does, not
    #     whether this branch's own does. Tests (1) and (2) between them cover
    #     "this worktree pushed" and "the integration branch already has it", and
    #     A REVIEW POLECAT IS NEITHER. Reviewing a PR means holding the builder's
    #     commits, and git refuses to check out a branch already checked out in
    #     another worktree (the builder's is still live while its PR is in
    #     review), so the reviewer puts its OWN never-pushed branch at the PR
    #     head — internal/agent/prompts/templates/polecat-review.md, step 4. It
    #     now says so (`checkout -B <own> --no-track origin/<pr>`); until mg-f0bf
    #     it instructed the checkout git refuses, and every reviewer improvised
    #     its way to this same state via `reset --hard`. BOTH COMMANDS PRODUCE
    #     THE STATE THIS TEST READS — named branch, HEAD on the builder's ref, no
    #     origin ref of its own — measured, and asserted side by side in the test
    #     suite, so the prompt repair provably did not move this verdict. Its
    #     commits are on origin/polecat-<the builder>, a ref test (1) never looks
    #     at, so the drain read them as unique to this worktree and waited for a
    #     push that was never going to come from here. The wait was unsatisfiable:
    #     the reviewer cannot discharge it, and the deploy exits 7 at the deadline
    #     (gh#134). The drain's question is "would stopping this polecat LOSE
    #     WORK?" — docs/investigations/drain-stalls-2026-07-31-and-2026-08-06.md
    #     :215-226 — and any origin ref holding HEAD answers it, without needing
    #     the base ref. The genuine committed-but-unpushed case is untouched:
    #     nothing on origin holds those commits, so this test does not fire.
    #
    #     THE VERDICT DELIBERATELY DOES NOT SAY "a reviewed PR". The reviewer is
    #     why this test exists, not what it detects: any worktree whose HEAD is
    #     held by a ref it did not push itself lands here, and a fresh worktree in
    #     a repo with no resolvable integration ref does exactly that. Naming the
    #     motivating case in the verdict would be false for every other caller —
    #     and mg-0a43 wants this predicate lifted into gitgc, where it would be
    #     false for all of them.
    #
    #     THE SEAT IS LOAD-BEARING AND WAS MEASURED, IN BOTH DIRECTIONS. After
    #     (1) and (2) so their more specific details survive — moved above them, a
    #     fresh worktree and a landed branch both answer "some origin ref holds
    #     HEAD", and the five distinct durable shapes collapse to three. TWO assertions
    #     in scripts/pogo-self-deploy_test.sh fail on that seat: the pre-existing
    #     `awaiting the refinery` marker and count guards, which fire because (2b)
    #     preempts test (1)'s wording for the pushed-and-unlanded branch; and the
    #     distinct-durable-SHAPES count. The second of those only became true when
    #     it was changed to elide the branch and worktree it interpolates — as
    #     first written it compared raw lines, could not fail, and was cited here
    #     as the guard anyway (gh#134, PR 140 round 1).
    #
    #     Before (3) so it also answers when NO integration ref resolves: a
    #     reviewer on a repo whose base is neither main nor master read `unknown`,
    #     and `unknown` holds the drain identically to `unpushed`.
    #
    #     refs/remotes/origin/HEAD is excluded because it is a symref at the
    #     default branch: it would answer for the integration branch under a name
    #     that says nothing about who pushed. THIS CHANGES THE NAME IN THE VERDICT,
    #     NEVER THE VERDICT — measured, and asserted in the test suite, because an
    #     exclusion nothing exercises is indistinguishable from a comment.
    #
    #     DETACHED HEAD IS DELIBERATELY NOT COVERED. A detached reviewer still
    #     reads `unknown` and still holds, because the branch is named above and
    #     this test is seated below that. Ruled out of scope by pm-pogo: both
    #     measured live shapes are named-branch, and widening a drain predicate
    #     past its evidence is how this file accumulated its history. mg-f0bf
    #     carried the coupled constraint and DISCHARGED IT WITHOUT DETACHING: the
    #     prompt now names a branch explicitly, so the detached shape remains one
    #     nothing instructs. It is still not covered, and the constraint still
    #     stands the other way round — do not introduce a detached checkout into
    #     polecat-review.md step 4 without covering the detached case here first.
    holder="$(git -C "$wt" for-each-ref --contains "$head" --format='%(refname)' \
                  refs/remotes/origin/ 2>/dev/null \
              | grep -v '^refs/remotes/origin/HEAD$' | head -n 1)"
    if [ -n "$holder" ]; then
        echo "durable ${holder#refs/remotes/} holds every commit on $branch, which was never pushed from $wt"
        return 0
    fi

    # (3) No integration ref resolved AND no origin ref holds HEAD.
    #     Nothing left to compare against, so we say that rather than guess.
    [ -n "$target" ] || {
        echo "unknown none of [$DRAIN_MERGE_TARGETS] resolves in $wt and no ref under refs/remotes/origin/ holds HEAD — cannot tell whether anything here is durable"
        return 0
    }

    # (4) THE REBASE CASE (bound 2). Compare patch ids, not SHAs. A `+` line is a
    #     commit with no equivalent upstream; `-` is one already applied there.
    #     rc is captured because an EMPTY cherry output is ambiguous — it is what
    #     both "nothing ahead" and "git refused the question" produce, and this
    #     file exists because that pair was once collapsed (mg-65b2).
    cherry="$(git -C "$wt" cherry "$target" "$head" 2>/dev/null)"; rc=$?
    if [ "$rc" -ne 0 ]; then
        echo "unknown git cherry could not compare $branch against $tname in $wt (rc=$rc)"
        return 0
    fi
    # `grep -c` exits 1 on no match and a legitimate zero is a real answer here,
    # so the `|| true` is load-bearing: without it the count is discarded exactly
    # when it says "nothing is ahead".
    ahead="$(printf '%s\n' "$cherry" | grep -c '^+' || true)"
    if [ "$ahead" = "0" ]; then
        echo "durable every commit on $branch has a patch-equivalent in $tname (rebase-landed; origin/$branch reaped)"
        return 0
    fi
    echo "unpushed $ahead commit(s) on $branch exist only in $wt — nothing on origin holds them"
}

# polecat_objects — one JSON object per line for every entry of the `polecats`
# array in an /agents/drain body on stdin.
#
# THE `unreachable` TAIL IS CUT FIRST, AND THAT IS LOAD-BEARING. The capture
# below is greedy, so with survivors present `\[\(.*\)\]` runs straight past the
# polecats array's own `]` and swallows the unreachable array too — and an
# OrphanedPolecat carries a "name" and a "work_item_id" exactly like a polecat
# does, so the result would look entirely plausible while asking git about
# processes this drain cannot drain and does not count (mg-0b77). Field order is
# fixed by the struct: draining, count, polecats, unreachable, unreachable_err.
polecat_objects() {
    sed 's/,"unreachable.*$//' \
        | sed -n 's/.*"polecats":\[\(.*\)\].*/\1/p' \
        | sed 's/},{/}\n{/g'
}

# drain_durability BODY -> one line per polecat, "<verdict> <name> (<work item>): <detail>".
# The verdict word is FIRST so the line is countable with an anchored grep, and
# the name and detail travel with it so every count this script prints can be
# expanded into the per-polecat evidence behind it.
#
# `|| [ -n "$line" ]` is load-bearing — the fourth encounter with the trap that
# extract_mail_check_ids_for_agents, unreachable_list and cleanup_orphans each
# document. The body arrives via command substitution, which strips trailing
# newlines, so the LAST object has none and a bare `read` sets $line and then
# returns non-zero at EOF. Here that would silently drop one polecat from the
# predicate — and with a single polecat, all of them: the drain would proceed
# past the exact case it exists to catch.
drain_durability() {
    local line name item wt out
    printf '%s' "$1" | polecat_objects | while IFS= read -r line || [ -n "$line" ]; do
        name="$(printf '%s' "$line" | json_str name)"
        [ -n "$name" ] || continue
        item="$(printf '%s' "$line" | json_str work_item_id)"
        wt="$(printf '%s'   "$line" | json_str worktree_dir)"
        out="$(durability_of "$wt")"
        echo "${out%% *} $name (${item:-no work item}): ${out#* }"
    done
}

# drain_unpushed_holders REPORT -> how many of those lines HOLD the drain.
# `unknown` is counted with `unpushed` on purpose: the two differ in what we
# know, not in what is safe to do about it.
#
# The `|| true` is required, not defensive noise — `grep -c` exits 1 when it
# matches nothing, and a legitimate zero is the whole happy path. The count is
# already on stdout by then.
drain_unpushed_holders() {
    printf '%s\n' "$1" | grep -cE '^(unpushed|unknown) ' || true
}

# drain_awaiting_refinery REPORT -> how many polecats are DURABLE but not yet
# landed. This count HOLDS NOTHING; it is the deploy's record of what it bounced
# past, which is what keeps rule 3's decoupling auditable rather than silent. A
# drain that proceeds without naming these is indistinguishable from a drain that
# had nothing to name.
drain_awaiting_refinery() {
    printf '%s\n' "$1" | grep -c 'awaiting the refinery' || true
}

# ---------------------------------------------------------------------------
# THE HOLDER LEDGER (gh#135, mg-ea06)
# ---------------------------------------------------------------------------
# THE DEFECT, stated as the reporter found it: everything above is a fact about
# ONE POLL. drain_wait re-derives its subject set from the live registry every
# 15s, and Registry.Polecats() filters on alive() — so a polecat that STOPS
# between polls LEAVES THE DENOMINATOR instead of satisfying it. drain_durability
# has no line for it, drain_unpushed_holders counts no line for it, and the drain
# prints `0 holding` over commits that exist in exactly one place on this
# machine. The check was not satisfied; it was SILENCED. And when the LAST holder
# stops, the `count -eq 0` early return fires before drain_durability runs at
# all, so there is not even a per-polecat report to read afterwards — no
# evidence, rather than misleading evidence.
#
# WHY THE HANDLE IS THE BRANCH REF AND NOT THE WORKTREE. The fix shape the issue
# proposes — snapshot the holders and BLOCK until they come back — cannot work,
# and this was measured rather than argued. By the time the drain would re-ask,
# the worktree is GONE: pogod reaps a CLEAN tree on exit, and committed-but-
# unpushed IS clean (mg-ee02's preservation fires only on UNCOMMITTED work, which
# this drain deliberately does not wait for). `durability_of <reaped path>`
# returns `unknown`, and `unknown` HOLDS — so blocking would burn the whole
# window and exit 7 over a holder that is already dead. That is mg-853a's failure
# mode rebuilt and gh#134's symptom re-created.
#
# What SURVIVES a stop is `refs/heads/polecat-<name>` in the SOURCE repo. The
# worktree is removed; the branch and its objects are not. So the reconciliation
# asks the source repo, with the same predicate gh#134/mg-1539 established one
# function up: DOES ANY origin REF CONTAIN THIS HEAD. Not ancestry of main —
# mayor measured that trap on mg-0a43 and it is the wrong predicate here for the
# same reason it is wrong there: the refinery REBASES before merging, so a branch
# whose work landed perfectly is not an ancestor of main afterwards (146 polecat
# branches in the live repo, 71 `--no-merged main`, and sampled counterexamples
# whose work is demonstrably on main). Containment survives a rebase; ancestry
# does not.
#
# AND IT DOES NOT HOLD. A departed-unsatisfied holder is reported LOUDLY — via
# err, so it reaches ERR_LOG, the reason record and the nightly's RED path — and
# the deploy PROCEEDS. This is mg-797d's rule 1 applied to a new subject:
# waiting protects nothing once the holder is dead, because the process that
# would have pushed those commits is already gone. Holding would convert a false
# GREEN into an unsatisfiable HOLD, which is strictly worse.
#
# WHERE IT IS SEATED, AND WHY THE LIST IS BY EXIT CODE RATHER THAN BY SITE.
# What decides whether an exit needs reconciling is not where it sits but what
# the deploy does next. drain_wait's rc=2 exits all REFUSE — the caller restores
# dispatch and exits 7 — so nothing is bounced past them and nothing can be
# stranded by proceeding. Every other exit is seated:
#
#   rc 0, `count -eq 0`   — the whole fleet stopped (gh#135)
#   rc 0, `held -eq 0`    — the survivors are all durable (gh#135)
#   rc 0, witness idle    — pogod wedged, nothing alive to ask (mg-8bb1)
#   rc 1, deadline        — refuses unless --force, and reports either way,
#                           because a run that times out with a departure in its
#                           ledger has BOTH problems (gh#135)
#
# The wedged exit was left for a follow-up when gh#135 landed (its scope named
# the two clears, and the reviewer declined to widen a passing PR), and its
# absence had exactly the shape the others were fixed for: rc=0 and an empty
# ERR_LOG over branches whose commits existed only on this host. A new exit that
# lets the deploy proceed must be seated here too, or it inherits that shape by
# default.
#
# THE SAFETY OF NOT-HOLDING HAS A DEADLINE, AND THE ALERT MUST NAME IT (ruled by
# pm-pogo, 2026-08-12). internal/gitgc/sweep.go keeps a polecat branch while its
# ticket is unconcluded and requires BranchMerged before deleting a *done*
# ticket's branch — but :346-348 deletes an ARCHIVED ticket's branch with no
# merge check and no durability check of any kind. Those commits live only there.
# So "reported, deploy proceeded" is safe only until archival, and archival is
# routine coordinator tidying. The deadline goes in the ALERT rather than in a
# ticket body, because the alert is the half that travels. (The gitgc defect
# itself is mg-0a43 and is NOT fixed here.)

# BranchPrefix, from internal/gitgc/gitgc.go:36. The agreement between an agent's
# registry name and its branch holds only while a polecat stays on its own branch
# (sweep.go:32-35 records the same caveat), which is why a branch that does not
# resolve reads `unknown` below rather than being called satisfied or lost.
DRAIN_BRANCH_PREFIX="polecat-"

# drain_ledger_has NAME LEDGER -> is NAME already recorded?
# `cut -f1` reads the tab-delimited first field and `grep -qxF` compares it
# whole and literally: a substring or regex match here would silently merge two
# polecats whose names share a prefix.
drain_ledger_has() {
    printf '%s\n' "$2" | cut -f1 | grep -qxF -- "$1"
}

# drain_ledger_add LEDGER BODY REPORT -> LEDGER with a row appended for every
# polecat REPORT says is HOLDING that is not already in it. One row per polecat:
#
#     <name>\t<work item>\t<source repo>
#
# The ledger is a plain string carried in drain_wait's own scope rather than a
# temp file, for the same reason the rest of this driver avoids state on disk:
# drain_wait has six exits and none of them would have to remember to clean up.
#
# ROWS ARE NEVER REMOVED. A polecat that stops holding is answered by the
# reconciliation below (it is still present, so it is not a departure); a polecat
# that vanishes is exactly what this ledger exists to remember. Forgetting a row
# because a later poll no longer mentions it would rebuild the defect.
drain_ledger_add() {
    local ledger="$1" body="$2" report="$3" line name obj item repo
    # $'\t' and $'\n' are ANSI-C quoting and are NOT expanded inside a
    # double-quoted string, so the separators are bound to names first and
    # interpolated as values. Written the other way the ledger acquires literal
    # `$'\t'` text, every row parses as one field, and every departure reads as
    # `unknown` — a failure that keeps reporting, so it would survive review.
    local nl=$'\n' tab=$'\t'
    while IFS= read -r line || [ -n "$line" ]; do
        # The same two verdicts drain_unpushed_holders counts, for the same
        # reason: they differ in what we know, not in what is safe to do.
        case "$line" in
            unpushed\ *|unknown\ *) ;;
            *) continue ;;
        esac
        name="${line#* }"; name="${name%% *}"
        [ -n "$name" ] || continue
        drain_ledger_has "$name" "$ledger" && continue
        obj="$(printf '%s' "$body" | polecat_objects | grep -F "\"name\":\"$name\"" | head -n 1)"
        item="$(printf '%s' "$obj" | json_str work_item_id)"
        repo="$(printf '%s' "$obj" | json_str source_repo)"
        ledger="${ledger:+$ledger$nl}${name}${tab}${item}${tab}${repo}"
    done <<EOF
$report
EOF
    printf '%s' "$ledger"
}

# drain_departure_verdict SOURCE_REPO NAME -> "<verdict> <detail>", where verdict
# is one of:
#
#   satisfied             — some origin ref holds every commit on its branch. It
#                           pushed on its way out; the stop satisfied the check.
#   departed-unsatisfied  — the branch resolves and NO origin ref holds its head.
#                           The commits exist only in the source repo.
#   unknown               — we could not ask. Reported as itself, NEVER as
#                           satisfied: a question we failed to ask is not an
#                           answer, which is the same rule durability_of follows.
#
# refs/remotes/origin/HEAD is excluded for the reason durability_of documents at
# length: it is a symref at the default branch and would name the integration
# branch under a name that says nothing about who pushed. It changes the NAME in
# the verdict, never the verdict.
drain_departure_verdict() {
    local repo="$1" branch="$DRAIN_BRANCH_PREFIX$2" head holder
    [ -n "$repo" ] && [ -d "$repo" ] || {
        echo "unknown it left the fleet mid-drain and its source repo (${repo:-none recorded}) is not readable here — nothing left to ask about its commits"
        return 0
    }
    head="$(git -C "$repo" rev-parse --verify --quiet "refs/heads/$branch" 2>/dev/null)"
    [ -n "$head" ] || {
        echo "unknown it left the fleet mid-drain and refs/heads/$branch does not resolve in $repo — the branch is gone or was never named after the agent"
        return 0
    }
    holder="$(git -C "$repo" for-each-ref --contains "$head" --format='%(refname)' \
                  refs/remotes/origin/ 2>/dev/null \
              | grep -v '^refs/remotes/origin/HEAD$' | head -n 1)"
    if [ -n "$holder" ]; then
        echo "satisfied it left the fleet mid-drain, and ${holder#refs/remotes/} holds every commit on $branch — it pushed on its way out"
        return 0
    fi
    echo "departed-unsatisfied it left the fleet mid-drain and NO origin ref holds $branch — those commits exist ONLY on refs/heads/$branch in $repo"
}

# drain_departures LEDGER BODY -> one line per ledger entry that is no longer in
# BODY's polecats array, in drain_durability's own format so the two reports read
# as one: "<verdict> <name> (<work item>): <detail>".
drain_departures() {
    local ledger="$1" body="$2" present name item repo v
    [ -n "$ledger" ] || return 0
    present="$(printf '%s' "$body" | polecat_objects | json_str name)"
    while IFS=$'\t' read -r name item repo || [ -n "$name" ]; do
        [ -n "$name" ] || continue
        printf '%s\n' "$present" | grep -qxF -- "$name" && continue
        v="$(drain_departure_verdict "$repo" "$name")"
        printf '%s %s (%s): %s\n' "${v%% *}" "$name" "${item:-no work item}" "${v#* }"
    done <<EOF
$ledger
EOF
}

# drain_departed_holders DEPARTURES -> how many departures did NOT reach origin.
# `unknown` is counted with `departed-unsatisfied` for the third time in this
# file and for the same reason every time. The `|| true` is load-bearing: grep -c
# exits 1 on no match and a legitimate zero is the happy path.
drain_departed_holders() {
    printf '%s\n' "$1" | grep -cE '^(departed-unsatisfied|unknown) ' || true
}

# Print a departure report, routing each line to the emitter its verdict earns:
# a departure that pushed on its way out is good news and goes to the log; one
# that did not is the alert this whole ledger exists to raise, and goes through
# err so it reaches ERR_LOG, the reason record and the nightly's RED path.
print_drain_departures() {
    local departures="$1" line
    [ -n "$departures" ] || return 0
    printf '%s\n' "$departures" | sed '/^$/d' | while IFS= read -r line; do
        case "$line" in
            departed-unsatisfied\ *|unknown\ *) err "  $line" ;;
            *) log "  $line" >&2 ;;
        esac
    done
}

# The deadline on not-holding, emitted ONCE per drain and only when there is a
# departed holder to attach it to. Three lines, in the order a reader needs them:
# what happened, why the deploy did not wait, and when the safety of not waiting
# runs out. The third is the one that must not be dropped — a reader who sees
# "reported, deploy proceeded" and files it for later has no other way to learn
# that archiving the work item destroys the commits.
alert_drain_departures() {
    [ "$1" -gt 0 ] || return 0
    err "$1 polecat(s) STOPPED DURING THE DRAIN still holding commits that reached no origin ref"
    err "the deploy did NOT wait for them: the process that would have pushed those commits is already gone, so holding the gate protects nothing (mg-797d rule 1)"
    err "THAT IS SAFE ONLY UNTIL THE WORK ITEM IS ARCHIVED. internal/gitgc/sweep.go:346-348 deletes an ARCHIVED item's polecat branch with NO merge check and no durability check, and these commits exist nowhere else. Push or land each branch named above BEFORE its item is archived (mg-0a43)."
}

# Print a durability report through a given emitter (log for good news, err for
# bad), one polecat per line. Nothing is summarised away: a count that cannot be
# expanded into the polecats behind it is how "0 polecats active" came to be
# printed over live work in the first place.
print_drain_durability() {
    local emit="$1" report="$2"
    printf '%s\n' "$report" | sed '/^$/d' | while IFS= read -r line; do "$emit" "  $line"; done
}

# Poll until NO POLECAT HOLDS UNPUSHED WORK. Echoes the number still holding
# some, or the "?" sentinel when the fleet's state could not be established.
#
#   rc 0 — clear. Every polecat's commits exist on origin; safe to bounce.
#   rc 1 — the deadline passed with polecats still holding local-only commits
#          (echoes how many).
#   rc 2 — CANNOT TELL (echoes "?"). Refuse; --force overrides.
#
# rc 0 DOES NOT MEAN "DRAINED" and this function must never be quoted as if it
# did. Polecats may still be running, and some of their branches may still be
# waiting on the refinery; what has been established is that stopping them now
# would orphan nothing (mg-3a96, and see THE DRAIN PREDICATE above). Every
# caller's wording is built on that distinction — see report_drain_complete and
# alert_drain_stalled.
#
# WHY THIS IS NOT `count="${count:-0}"` ANY MORE (mg-65b2)
# --------------------------------------------------------
# It used to be. `curl -sf` yields an EMPTY body on any failure — refused
# connection, timeout, 5xx, a non-JSON body — json_num then yields empty, and
# `${count:-0}` rendered "I could not read it" as "there are zero polecats". The
# gate returned quiesced on the FIRST poll, without waiting at all, and the
# redeploy went on to kickstart -k over a live fleet: polecats setsid out of the
# process group and SURVIVE (mg-46a4, mg-61a0), holding worktrees and claims,
# invisible to the successor's registry forever. No --force required. Measured
# against a dead port, not inferred.
#
# The irony was exact and is worth keeping on the record: report_drain_complete,
# three lines down, was ALREADY honest — 935ce5f taught it to say "this is NOT a
# report that there are none — it is a report that we could not look" — while the
# function that DECIDES WHETHER TO BOUNCE still rendered the same absence as a
# confident zero. 0b77 fixed the report. It never touched the gate.
#
# THE FORK "FAIL OPEN OR FAIL CLOSED?" IS MALFORMED, AND BOTH RULERS REFUSED IT.
# Each is an attempt to pick a least-bad action for a state whose distinguishing
# information `${count:-0}` had already destroyed. The fix is not a better
# default for an unknown state; it is to STOP MAKING THE STATE UNKNOWN. Three
# parts, cheapest first:
#
#   1. A MISSING SAMPLE IS NOT A MEASUREMENT. This is a deadline-bounded poll: a
#      single transient curl failure means no data this tick, not a reading of
#      zero. So poll again. That alone covers most real occurrences — a >5s
#      response under load, a blip — and it needs no policy and no fork.
#   2. SUSTAINED SILENCE IS A REAL STATE CHANGE — and the classifier for it
#      already exists, pure and unit-tested, twelve lines up. Reuse it. Two
#      functions with private definitions of "down" is how this recurs.
#   3. THEN EACH BRANCH IS OBVIOUS. See the case below.
#
# UNREACHABLE IS NOT UNKNOWABLE. /agents/drain is a PROXY; the real question —
# "are there live polecats?" — stays observable when pogod dies, because mg-13a3
# persisted a second witness to disk for exactly this class of question. We just
# had not noticed the drain was asking it. So `down` consults the witness rather
# than guessing, and that is what dissolves the objection that refusing on an
# unreachable pogod blocks the repair at the moment it is needed: wedged+idle
# PROCEEDS (by right — the bounce IS the repair, and cannot destroy a process
# that is already gone), wedged+live REFUSES. The gate blocks exactly when it
# should and never when it shouldn't.
#
# WHAT WEDGED+IDLE DOES *NOT* ESTABLISH (mg-8bb1). "No live polecat" is an
# answer about PROCESSES. It is not an answer about COMMITS, and the wedged exit
# used to print one as if it were the other. A polecat that stopped earlier in
# this same drain holding local-only commits leaves no process for the witness
# to see and no registry entry for anything else to read — so the idle fleet is
# real, the repair is real, and the branch is still stranded. The ledger below
# is what closes that gap, and it is reconciled at the wedged exit too.
#
# DETACHED COMPUTE IS DELIBERATELY NOT WAITED FOR (ruled 2026-08-07, mg-797d)
# --------------------------------------------------------------------------
# What this waits on is POLECATS HOLDING COMMITS THAT EXIST ONLY LOCALLY. Compute
# can OUTLIVE the polecat that started it: architect measured python launched from
# a polecat's own script still burning ~308% CPU for 30+ minutes at ppid=1, under
# no polecat at all. So a clear here does not mean "no work in flight" — an orphan
# holds neither a polecat record nor a worktree this can read, and falls through
# BOTH tests. The narrowing landed in mg-853a and was re-aimed in mg-3a96; the gap
# it leaves is the one ruled on below, unchanged and still deliberate.
#
# THAT GAP IS REAL AND IT IS NOT AN OVERSIGHT. It was raised deliberately and
# pm-pogo ruled: the deploy must EXPLICITLY NOT wait for detached compute. Do
# not add a third term here to close it. The reasons, in the order that decides:
#
#   1. Waiting would protect NOTHING. This drain exists so that bouncing pogod
#      does not destroy in-flight work. An orphan has ALREADY detached from
#      pogod — that is what ppid=1 means — so the bounce cannot destroy it.
#      Waiting would trade a real deploy for an imagined risk.
#   2. It would give the drain a predicate it CANNOT SATISFY. The detached
#      population is pm-onethird's research jobs — multi-hour combinatorics
#      searches working exactly as designed, not runaway work. A drain that
#      waits on compute rather than on merge obligations waits forever by
#      construction, and the nightly redeploy never bounces again.
#   3. Nothing here can SEE them anyway. An orphan has no registry entry, and a
#      process-table scan cannot tell a detached polecat child from any other
#      python on this box.
#
# The orphan is still a defect — a polecat's children should not outlive it —
# but it is PROCESS-LIFECYCLE work (same family as mg-55de, mg-56d1), not drain
# work. Coupling a deploy unblocker to a lifecycle redesign is how the unblocker
# strands.
#
# If you are here to widen this back toward "wait for all work in flight", read
# mg-797d FIRST: pm-onethird priced that widening in advance, in their own
# product's throughput, and asked to be consulted before it is made.
DRAIN_UNREADABLE_LIMIT=3   # consecutive unreadable samples before it means something
DRAIN_UNREADABLE_SLEEP=2   # a blip is re-probed in seconds, not the 15s drain tick

drain_wait() {
    local deadline=$(( $(date +%s) + DRAIN_TIMEOUT ))
    local raw code body count disp live misses=0 report held pending shown=false
    # THE CROSS-POLL TERM (gh#135). Everything else in this loop is re-derived
    # from the current tick; this is the only thing that remembers a previous
    # one, and it is the only thing that can see a holder LEAVE.
    local ledger="" departures gone
    # DID THIS DRAIN EVER GET A READABLE POLL AT ALL (mg-8bb1)? An empty ledger
    # has two causes that must not read alike at the wedged-pogod exit: we asked
    # and nobody was holding, or we never got to ask. The first is a clean
    # reconciliation; the second is this bug family one level up — the absence of
    # evidence wearing the clothes of evidence of absence.
    local sampled=false
    while :; do
        raw="$(drain_probe)"
        code="${raw##*$'\n'}"
        body="${raw%$'\n'*}"

        # A count is a MEASUREMENT only if the server answered 2xx AND the body
        # actually parsed. Anything else falls through to the missing-sample
        # path below — it must never reach the `-eq 0` test.
        count=""
        [ "$(classify_drain_precondition "$code")" = "drain" ] \
            && count="$(printf '%s' "$body" | json_num count)"

        case "$count" in
            ''|*[!0-9]*) ;;   # no sample this tick — handled below
            *)
                misses=0
                sampled=true
                # Zero POLECATS — not zero work. Detached compute is left out
                # of this test on purpose (mg-797d); see "DETACHED COMPUTE IS
                # DELIBERATELY NOT WAITED FOR" above before adding a term here.
                #
                # THE RECONCILIATION IS SEATED ABOVE THIS RETURN AND NOT ONLY AT
                # THE CLEAR BELOW, AND THAT PLACEMENT IS LOAD-BEARING (gh#135).
                # This return fires BEFORE drain_durability runs, so the
                # single-holder fleet — the commonest shape, and one poll from
                # the reporter's own — would escape a fix seated only at the
                # `held -eq 0` branch. Until this ticket, the last holder
                # stopping produced no per-polecat report and not even a
                # `0 holding` line: no evidence at all, rather than misleading
                # evidence. The line below is that missing evidence.
                if [ "$count" -eq 0 ]; then
                    departures="$(drain_departures "$ledger" "$body")"
                    gone="$(drain_departed_holders "$departures")"
                    log "no polecat holds unpushed work — 0 running, $gone that stopped mid-drain without reaching origin" >&2
                    print_drain_departures "$departures"
                    alert_drain_departures "$gone"
                    echo 0; return 0
                fi

                # NARROWED (mg-853a) AND RE-AIMED (mg-3a96): neither "is it
                # running?" nor "does the refinery owe it a merge?" is the
                # question. Ask git, per polecat, whether its worktree holds
                # commits that exist NOWHERE ELSE. Only those hold the deploy.
                report="$(drain_durability "$body")"
                held="$(drain_unpushed_holders "$report")"
                pending="$(drain_awaiting_refinery "$report")"

                # RECORD BEFORE RECONCILING. Every holder this tick joins the
                # ledger, so that if it is absent from a LATER tick there is
                # something left that remembers it was ever here. Nothing else
                # in this loop does — the registry has already forgotten it
                # (Registry.Polecats() filters on alive()), and so has the
                # witness store (noteWitnessExit deletes the witness on a
                # witnessed exit, internal/agent/agent.go:1898).
                ledger="$(drain_ledger_add "$ledger" "$body" "$report")"
                departures="$(drain_departures "$ledger" "$body")"
                gone="$(drain_departed_holders "$departures")"

                if [ "$held" -eq 0 ]; then
                    # THE SECOND TERM IS WHY THIS LINE CHANGED. `0 holding` was
                    # true of the polecats still present and said nothing about
                    # the ones that had left, which is precisely how a check that
                    # was SILENCED read identically to one that was SATISFIED
                    # (gh#135). The count is printed whether or not it is zero:
                    # a term that appears only when it is non-zero is one a
                    # reader cannot tell from a term that was never computed.
                    log "no polecat holds unpushed work — $count running, 0 holding commits that exist only locally, $gone that stopped mid-drain without reaching origin" >&2
                    # Rule 3's decoupling, said out loud at the moment it acts.
                    # The deploy proceeds over these on purpose; a run that
                    # bounced past pending merges without naming them would be
                    # indistinguishable from one that had none to name.
                    [ "$pending" -gt 0 ] && log "proceeding past $pending pushed branch(es) the refinery has not landed — durable on origin, and NOT waited on (mg-3a96 rule 3)" >&2
                    print_drain_durability log "$report" >&2
                    print_drain_departures "$departures"
                    alert_drain_departures "$gone"
                    echo 0; return 0
                fi

                # The per-polecat evidence goes out ONCE per drain rather than
                # every 15s: a 7200s window would otherwise emit it ~480 times
                # and bury the tick that mattered. The terminal paths below and
                # above print it again, because those are the lines a reader
                # actually acts on.
                if ! $shown; then
                    log "$held of $count polecat(s) hold commits that exist only in their worktree:" >&2
                    print_drain_durability log "$report" >&2
                    shown=true
                fi

                if [ "$(date +%s)" -ge "$deadline" ]; then
                    err "deadline reached; still holding unpushed work:"
                    print_drain_durability err "$report"
                    # Departures are reported here too, and AFTER the headline so
                    # deploy_reason_record still picks "deadline reached" as the
                    # reason. A drain that times out with a departure in its
                    # ledger has both problems, and the one that leaves no
                    # evidence anywhere else is this one.
                    print_drain_departures "$departures"
                    alert_drain_departures "$gone"
                    echo "$held"; return 1
                fi
                log "waiting: $held of $count polecat(s) still hold unpushed commits (bounded by their next push, not by the refinery)..." >&2
                sleep 15
                continue ;;
        esac

        # --- (1) missing sample: poll again, conclude nothing ----------------
        misses=$(( misses + 1 ))
        if [ "$misses" -lt "$DRAIN_UNREADABLE_LIMIT" ]; then
            log "drain readout unreadable (http=${code:-000}, sample $misses/$DRAIN_UNREADABLE_LIMIT) — polling again" >&2
            if [ "$(date +%s)" -ge "$deadline" ]; then echo "?"; return 2; fi
            sleep "$DRAIN_UNREADABLE_SLEEP"
            continue
        fi

        # --- (2) sustained: classify it, with the classifier we already have -
        disp="$(classify_drain_precondition "$code")"
        case "$disp" in
            down)
                # (3) pogod is not answering. Ask the other witness.
                live="$(witness_alive_count)" || {
                    # DOUBLE ABSENCE — pogod silent AND the witness cannot
                    # answer. Genuinely unknown, and the one place where there
                    # is nothing left to consult. Fail closed; that is 13a3's
                    # thesis one layer up: never conclude "drained" from a
                    # SINGLE absence, and certainly not from two.
                    err "pogod is not answering AND the polecat witness could not be read"
                    err "this is a DOUBLE ABSENCE: nothing here knows whether polecats are alive."
                    err "refusing to bounce a fleet whose state is unknown. --force overrides."
                    echo "?"; return 2
                }
                if [ "$live" -eq 0 ]; then
                    # THE THIRD CLEAR-AND-PROCEED EXIT, RECONCILED (mg-8bb1).
                    # This exit used to print "bouncing a wedged pogod strands
                    # nothing and IS the repair" as a flat assertion. Half of
                    # that sentence was checked and half was not: the witness
                    # establishes that no polecat is RUNNING, which is what
                    # makes the bounce the repair, and it says nothing whatever
                    # about whether commits exist only on this box. Those are
                    # different questions, and one polecat stopping mid-drain
                    # separates them — poll 1 with two unpushed holders followed
                    # by HTTP 000 and a witness count of 0 returned rc=0 with an
                    # EMPTY ERR_LOG over two branches that existed nowhere else
                    # (measured, p7182). An empty error log there was not
                    # evidence that nothing was stranded; it was evidence that
                    # nothing was asked.
                    #
                    # It is asked here for the same reason and in the same way
                    # as at the two clears above, and the ledger is the only
                    # thing that CAN answer it: pogod is gone, so the registry
                    # cannot be re-read, and the witness store has already
                    # deleted the witness of anything that exited.
                    #
                    # THE BODY IS DELIBERATELY EMPTY, and passing "$body" here
                    # would be a bug. This branch is only reached after
                    # DRAIN_UNREADABLE_LIMIT unreadable samples, so $body holds
                    # whatever the failed probe left behind — and a body that
                    # accidentally parsed would suppress the very departures
                    # this call exists to surface. The witness has already
                    # ruled: nothing is alive, so every row in the ledger has
                    # departed.
                    departures="$(drain_departures "$ledger" "")"
                    gone="$(drain_departed_holders "$departures")"
                    log "pogod stopped answering, and the witness reports no live polecat" >&2
                    if [ "$gone" -gt 0 ]; then
                        # The bounce still happens — holding protects nothing
                        # once the holders are dead (mg-797d rule 1), and
                        # refusing here would rebuild mg-853a's failure mode at
                        # the one exit where a bounce is most likely to be the
                        # right move. What changes is that the operator is told
                        # what is at risk WHILE it happens, instead of being
                        # told that stranding is impossible at the moment it is
                        # occurring.
                        log "the fleet is idle, so the bounce IS the repair and proceeds — but it does NOT follow that nothing is stranded: $gone polecat(s) held unpushed commits earlier in this drain and are gone" >&2
                    elif $sampled; then
                        log "the fleet is idle and the drain's holder ledger reconciles clean: bouncing a wedged pogod strands nothing and IS the repair" >&2
                    else
                        # THE REMEDY, SUBJECTED TO THE DEFECT IT REMEDIES. A
                        # ledger that is empty because no poll ever parsed is
                        # not a clean reconciliation, and reporting "0
                        # departures" over it would restore this ticket's own
                        # bug one level up. Said as a log line and not an err on
                        # purpose: pogod wedged before the first readable sample
                        # is the ORDINARY shape of this exit, and an alert that
                        # fires on every wedged bounce is one that gets filtered
                        # within a week.
                        log "the fleet is idle, so the bounce IS the repair and proceeds — but pogod never answered this drain, so no holder ledger was built: this is NOT a report that nothing is at risk, it is a report that nothing could be asked" >&2
                    fi
                    print_drain_departures "$departures"
                    alert_drain_departures "$gone"
                    echo 0; return 0
                fi
                err "pogod is not answering, but the witness reports $live live polecat(s)"
                err "bouncing now would mint PERMANENT survivors: they outlive kickstart -k"
                err "(they setsid out of the process group) and go dark forever — no registry"
                err "can ever see them again. Refusing. --force overrides."
                echo "?"; return 2 ;;
            *)
                # Reachable, but we cannot read what it said. A LIVE pogod with
                # an invisible count is exactly where bouncing destroys work,
                # and the witness cannot help: it does not know about polecats
                # this pogod holds in a registry we just failed to read. Refuse
                # rather than guess — --force already means "I know it's wedged,
                # bounce it anyway".
                err "pogod is answering (${disp}) but its drain readout is unreadable after $misses tries"
                err "refusing to bounce a LIVE pogod whose polecat count we cannot see. --force overrides."
                echo "?"; return 2 ;;
        esac
    done
}

# Echo one line per polecat that is alive but UNREACHABLE — witnessed processes
# with no registry entry (mg-0b77). Input: an /agents/drain snapshot.
#
# These are survivors of an EARLIER pogod restart. They are not in `count`, and
# so they are not what drain_wait polls to zero: a survivor is not drainable
# (there is no adopt path, and absence never heals), so counting one would block
# every future redeploy forever rather than fix anything. They are reported
# instead — the drain completes, it just stops claiming they do not exist.
unreachable_list() {
    # `|| [ -n "$line" ]` is load-bearing, not defensive noise — the same trap
    # extract_mail_check_ids_for_agents already documents above. The pipeline's
    # last record carries NO trailing newline (the body arrives via command
    # substitution, which strips them), and a bare `read` sets the variable but
    # returns non-zero at EOF, so the plain loop silently DROPS the last
    # survivor. With one survivor that is all of them: this function reports
    # nothing while looking like it worked — the exact silence mg-0b77 exists to
    # remove, rebuilt inside its own fix. Caught by its own test, not by review.
    printf '%s' "$1" \
        | sed -n 's/.*"unreachable":\[\(.*\)\].*/\1/p' \
        | sed 's/},{/}\n{/g' \
        | while IFS= read -r line || [ -n "$line" ]; do
            local n p w
            n="$(printf '%s' "$line" | json_str name)"
            p="$(printf '%s' "$line" | json_num pid)"
            w="$(printf '%s' "$line" | json_str work_item_id)"
            [ -z "$n" ] && continue
            echo "$n (pid=${p:-?}, work_item=${w:-unknown})"
        done
}

# Report the end of a successful drain HONESTLY — which now means saying WHAT WAS
# CHECKED, in the words of the predicate, rather than the word "drained".
#
# The old message said "drain complete — 0 polecats active". Two separate
# over-claims lived in that line, and each was paid for once already:
#
#   - `count` reaching zero is a fact about pogod's in-memory REGISTRY, not about
#     the machine. It says nothing about a polecat that outlived an earlier
#     restart and is invisible to this registry forever (mg-0b77 / mg-46a4 §5a).
#   - Since mg-853a the drain no longer polls `count` to zero AT ALL. It clears
#     while polecats are very much still running — since mg-3a96, when none of
#     them holds a commit that exists only locally. "0 polecats active" would now
#     be flatly false rather than merely narrow.
#
# So the headline names the predicate and the numbers behind it. An alert naming a
# cause it has not established is the defect that started this whole line of work;
# it must not be reinstalled at the moment of success.
report_drain_complete() {
    local body errmsg leftovers n count report held pending
    body="$(curl -sf --max-time 5 "$(base_url)/agents/drain" 2>/dev/null)"

    # This is a SECOND, independent fetch — drain_wait's success proves the
    # daemon answered 15s ago, not that it is answering now. An empty body means
    # we learned nothing, and "I could not ask" must never print as "none
    # unreachable": that is this ticket's own defect (absence of evidence
    # rendered as a positive claim about the world) reproduced inside its fix.
    if [ -z "$body" ]; then
        log "drain check cleared — no polecat held unpushed work (see the drain's own report above)"
        err "could not re-read /agents/drain to check for unreachable survivors"
        err "this is NOT a report that there are none — it is a report that we could not look"
        return 0
    fi

    # Re-state the predicate against THIS body, so the completion line reports a
    # measurement rather than a memory. It can legitimately disagree with
    # drain_wait's — and mg-3a96 INVERTED WHICH EVENT CAUSES THE DISAGREEMENT. A
    # push used to flip a polecat INTO the held set; now it flips one OUT, and the
    # event that can flip one back in is a fresh local COMMIT. drain_wait owns the
    # decision — this is the report — so a disagreement is NAMED and the deploy
    # continues, which is the only combination that neither hides the race nor
    # invents authority to act on it.
    count="$(printf '%s' "$body" | json_num count)"
    report="$(drain_durability "$body")"
    held="$(drain_unpushed_holders "$report")"
    pending="$(drain_awaiting_refinery "$report")"
    log "drain check cleared — checked ${count:-?} polecat(s) for commits that exist only in their worktree"
    if [ "$held" -gt 0 ]; then
        err "re-read AFTER the drain cleared: $held polecat(s) now hold unpushed commits"
        print_drain_durability err "$report"
        err "a polecat committed between the drain's last poll and this re-read. The bounce"
        err "leaves those commits on a local branch with no process left to push them —"
        err "the stranded-push case mg-be37 detects and mg-b468 is meant to carry across."
    else
        print_drain_durability log "$report"
    fi
    # NOT an error and NOT a hold: the deploy is decoupled from the refinery on
    # purpose (mg-3a96 rule 3). Named so the night's log says what it went past.
    if [ "$pending" -gt 0 ]; then
        log "$pending pushed branch(es) are still unlanded — durable on origin, so the bounce"
        log "strands nothing; the refinery lands them without their author, which is normal."
    fi

    # A witness we could not read means we do not know whether survivors exist.
    # That is NOT "none" and must not be printed as a clean drain (mg-76e5).
    errmsg="$(printf '%s' "$body" | json_str unreachable_err)"
    if [ -n "$errmsg" ]; then
        err "cannot tell whether any polecat survived an earlier restart: $errmsg"
        err "proceeding, but this redeploy may bounce live work it cannot see"
        return 0
    fi

    leftovers="$(unreachable_list "$body")"
    if [ -z "$leftovers" ]; then
        log "none unreachable"
        return 0
    fi

    n="$(printf '%s\n' "$leftovers" | wc -l | tr -d ' ')"
    err "$n polecat(s) are ALIVE but unreachable and were NOT drained:"
    printf '%s\n' "$leftovers" | while IFS= read -r line; do err "  $line"; done
    err "these survived an earlier pogod restart, so this registry cannot see them"
    err "and never will (no adopt path — absence never heals). They are still"
    err "holding a worktree and a claim. This redeploy does NOT touch them; they"
    err "need a human. pogod is also mailing the coordinator about each one."
    return 0
}

# On a forced hard bounce, clean up every polecat the bounce orphaned: unclaim
# its work item and gc its worktree. Input: the /agents/drain snapshot captured
# BEFORE the kickstart (after kickstart, pogod's registry is gone).
cleanup_orphans() {
    local snapshot="$1" line id wt repo
    # Extract "work_item_id":"..","worktree_dir":"..","source_repo":".." tuples.
    # One polecat object per line after we split on '},{'.
    #
    # `|| [ -n "$line" ]` is load-bearing — the third encounter with the trap
    # extract_mail_check_ids_for_agents and unreachable_list already document
    # above. The snapshot arrives from a `$(curl ...)`, and command substitution
    # strips trailing newlines, so the LAST object has none; a bare `read` sets
    # $line and then returns non-zero at EOF, and the loop body never runs for it.
    #
    # Here that is worse than a miss. This function only runs on a --force hard
    # bounce, over the population that bounce just killed — so the last polecat is
    # never unclaimed and its worktree is never removed, and nothing else will
    # ever come for it: the claim and the worktree leak permanently. With ONE
    # polecat it dropped all of them, logging nothing at all.
    #
    # The guard existed in this same file, with a comment explaining exactly this,
    # and it did not transfer. What made this copy live is not that the knowledge
    # was missing — it is that cleanup_orphans had no test, so getting it wrong
    # failed silently. The control below (mg-a558) is the part that can fail.
    printf '%s' "$snapshot" \
        | sed 's/},{/}\n{/g' \
        | while IFS= read -r line || [ -n "$line" ]; do
            id="$(printf '%s' "$line"  | json_str work_item_id)"
            wt="$(printf '%s' "$line"  | json_str worktree_dir)"
            repo="$(printf '%s' "$line" | json_str source_repo)"
            [ -z "$id" ] && [ -z "$wt" ] && continue
            if [ -n "$id" ]; then
                log "unclaiming orphaned work item $id"
                "$MG" unclaim "$id" 2>&1 | sed 's/^/  /' || err "mg unclaim $id failed"
            fi
            if [ -n "$wt" ] && [ -n "$repo" ] && git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
                log "removing orphaned worktree $wt"
                git -C "$repo" worktree remove --force "$wt" 2>&1 | sed 's/^/  /' || true
            fi
        done
    # Reap any now-dangling worktree administrative entries.
    [ -n "$REPO" ] && git -C "$REPO" worktree prune 2>/dev/null || true
}

# Installs every binary in DEPLOYED_CMDS. The daemon and the CLI move together
# or not at all — that lockstep is the point, so the failure modes must not be
# able to move one without the other.
#
# COMPILE EVERYTHING BEFORE INSTALLING ANYTHING. `go install pkgA pkgB` is NOT
# all-or-nothing: it installs each package as that package finishes, so a
# compile error in the CLI still leaves a freshly-installed pogod on disk. That
# is measured, not assumed — a deliberately broken cmd/pogo installed pogod and
# nothing else. Building the whole set into a throwaway dir first turns a
# compile error into a refusal that has written nothing to GOBIN, and costs
# almost nothing: the install that follows is a build-cache hit, not a recompile.
#
# ITS HONEST LIMIT: this closes the compile-error window, not every window. A
# go install that dies for a non-compile reason (full disk, GOBIN perms) after
# writing pogod can still split the pair. The post-install check below is what
# catches that: it asks EVERY binary its revision and refuses unless they all
# report main, so a split pair fails the deploy loudly instead of shipping. A
# refusal here exits with the drain trap still armed, leaving the old pogod
# running and dispatching — the correct resting state for "we could not build".

# THE BUILD STAMP (mg-3141). Makes each installed binary able to say what it
# contains, from inside itself, without a log line or an mtime or an inference.
#
# This is a deliberate duplicate of build.sh's version_ldflags. This script is
# standalone by ruling (see the header: it calls only STABLE primitives and must
# not grow dependencies, because it is the thing that repairs a broken pogod).
# scripts/stamp_test.sh sources THIS function, builds with it, RUNS the binary
# and asserts the commit — so the two copies are guarded by behaviour rather
# than by a shared file the deploy path would then depend on.
#
# A wrong -X symbol path is a silent no-op producing exactly the empty-string
# state this ticket exists to end, with no error at build time. That is why the
# guard runs the binary and why the post-install check below asks each artifact
# rather than trusting this string.
version_ldflags() {
    local repo="${1:-.}"
    local pkg="github.com/drellem2/pogo/internal/version"
    local commit branch dirty
    commit="$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)"
    if [ -z "$commit" ]; then echo ""; return 0; fi
    branch="$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    [ -n "$branch" ] || branch="unknown"
    if [ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]; then dirty=true; else dirty=false; fi
    printf -- '-X %s.Commit=%s -X %s.Build=%s -X %s.Branch=%s -X %s.Dirty=%s' \
        "$pkg" "$commit" "$pkg" "${commit:0:7}" "$pkg" "$branch" "$pkg" "$dirty"
}

# stamped_rev: the revision a binary REPORTS ABOUT ITSELF, from its own ldflags
# stamp, by being RUN and asked.
#
# This is a different reading from installed_rev, and keeping them apart is the
# point. installed_rev asks the FILE (`go version -m`, Go's automatic
# vcs.revision); stamped_rev asks the PROGRAM. They can disagree, and when they
# do the disagreement is the finding: Go's stamp names whatever repo the build
# directory walked up into, while this one names the repo this script chose.
#
# HOW IT ASKS IS LOAD-BEARING, AND IT IS NOT THE SPELLING A HUMAN WOULD USE.
# This function runs a binary of UNKNOWN VINTAGE — that is the whole point, it
# is checking whether the install landed. A pre-mg-3141 pogod given the bare
# `version` argument does not print a version and does not error: stdlib flag
# ignores unrecognised positional args, so it STARTS THE DAEMON. Measured: on a
# box where the pogod lock is free — which is precisely the state during a
# redeploy — that is a second daemon launched by the post-install check, and a
# check that never returns.
#
# The FLAG form is the safe probe, because stdlib flag REFUSES an unknown flag:
# a pre-fix pogod given `-version` exits 2 with "flag provided but not defined"
# having started nothing (measured). So the flag form is the DEFAULT here, and
# any binary not named below is probed that way — an unhandled new binary then
# fails loudly as UNSTAMPED rather than hanging the deploy.
#
# cmd/pogo is the exception: it is a cobra CLI, which rejects `-version` as an
# unknown shorthand (both vintages, measured) and has no daemon to start, so the
# subcommand form is both necessary and harmless for it.
stamped_rev() {
    local name="$1"
    local bin; bin="$(installed_bin "$name")"
    [ -x "$bin" ] || { echo "$REV_MISSING"; return 0; }
    local out
    case "$name" in
        pogo|lsp|pose) out="$("$bin" version --json 2>/dev/null || true)" ;;
        *)             out="$("$bin" -version -json 2>/dev/null || true)" ;;
    esac
    # NOT json_str: that one is pinned to the compact `"k":"v"` shape pogod's
    # HTTP handler emits, and both CLIs print INDENTED JSON — `"commit": "..."`
    # with a space. json_str returns empty on it, which stamped_rev would have
    # reported as UNSTAMPED: a check that fails a good deploy while looking
    # exactly like the defect it is testing for. BRE, BSD sed (macOS).
    local rev src
    rev="$(printf '%s' "$out" | sed -n 's/.*"commit"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    src="$(printf '%s' "$out" | sed -n 's/.*"source"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    # "unknown" is what an unstamped binary reports — honest and greppable, and
    # not comparable to a revision, so it maps onto the existing sentinel.
    if [ -z "$rev" ] || [ "$rev" = "unknown" ]; then echo "$REV_UNSTAMPED"; return 0; fi
    # ONLY AN ldflags STAMP COUNTS, and this line is the whole point of the
    # check rather than a nicety. A `-X` naming a symbol path that does not
    # exist links cleanly and sets nothing — the silent no-op this ticket was
    # filed about. In a worktree that is NOT nested inside another git repo,
    # Go's automatic vcs.revision then supplies the CORRECT sha anyway, so a
    # check that accepted any non-empty commit would report the deploy healthy
    # while the stamping it exists to verify had done nothing at all.
    #
    # That is not hypothetical: the first version of this function omitted the
    # test and passed on the developer box — where a polecat worktree under
    # ~/.pogo makes Go's stamp foreign and so accidentally distinguishable —
    # and the refinery caught it on the merge gate, whose worktree is not
    # nested and where buildinfo covered for the missing stamp exactly as
    # described. The remedy was subject to the defect it remedies.
    if [ "$src" != "ldflags" ]; then echo "$REV_UNSTAMPED"; return 0; fi
    echo "$rev"
}

do_build() {
    local name; local pkgs=()
    for name in "${DEPLOYED_CMDS[@]}"; do pkgs+=("./cmd/$name"); done
    log "building ${DEPLOYED_CMDS[*]} from $REPO ($DEPLOY_REF)"
    local head; head="$(git -C "$REPO" rev-parse HEAD 2>/dev/null)"
    if [ "$head" != "$MAIN" ]; then
        err "repo HEAD ($(short "$head")) != $DEPLOY_REF ($(short "$MAIN")); checkout $DEPLOY_REF first or pass --repo to a checkout on it"
        exit 4
    fi
    if [ -n "$(git -C "$REPO" status --porcelain 2>/dev/null)" ]; then
        err "repo $REPO has uncommitted changes; refusing to go install a dirty tree"
        exit 4
    fi
    # Stage: compile the whole set into a throwaway dir. A failure here has
    # written nothing to GOBIN.
    local stage; stage="$(mktemp -d)" || { err "cannot create a staging dir"; exit 4; }
    # The stamp is derived once and used for BOTH the staged build and the
    # install below. Deriving it twice would let the two differ if the tree
    # changed between them — and the whole value of the stamp is that the
    # artifact and the claim about it cannot come apart.
    local ldflags; ldflags="$(version_ldflags "$REPO")"
    if [ -z "$ldflags" ]; then
        err "cannot read a revision from $REPO — refusing to install binaries that cannot say what they contain"
        rm -rf "$stage"
        exit 4
    fi
    log "stamping $(short "$head") into ${DEPLOYED_CMDS[*]}"
    if ! ( cd "$REPO" && go build -ldflags "$ldflags" -o "$stage/" "${pkgs[@]}" ); then
        rm -rf "$stage"
        err "go build failed — refusing to install a partial set (nothing was written to GOBIN)"
        exit 4
    fi
    rm -rf "$stage"
    # THE MUTATION POINT (mg-0155). Everything above this line leaves GOBIN
    # exactly as it found it; everything below has, or may have, written to it.
    # `partial` is not hedging — go install writes the binaries one at a time, so
    # a failure inside this call genuinely leaves an unknown subset installed,
    # and that is the state an operator must be told about rather than have
    # guessed at in either direction. The alert's "was anything installed?"
    # sentence is derived from this flag, not from the exit code, which is why a
    # future exit added anywhere in this function cannot get the answer wrong.
    DEPLOY_INSTALLED="partial"
    ( cd "$REPO" && go install -ldflags "$ldflags" "${pkgs[@]}" ) || { err "go install failed"; exit 4; }
    # Verify EVERY binary, not just the daemon: an install that silently skipped
    # one is exactly the failure this ticket exists to end, and it is only
    # detectable by asking each binary what revision it carries.
    for name in "${DEPLOYED_CMDS[@]}"; do
        local now; now="$(installed_rev "$name")"
        if [ "$now" != "$MAIN" ]; then
            err "post-install $name revision $(short "$now") != main $(short "$MAIN")"
            exit 4
        fi
        # ASK THE BINARY, not just the file (mg-3141). installed_rev reads Go's
        # automatic vcs stamp off the file; this asks the program what it says
        # about itself, which is the reading every "is the fix live?" question
        # actually needs and the one that did not exist before. It also catches
        # the failure this ticket's remedy is itself subject to: a `-X` naming a
        # symbol path that does not exist links cleanly, produces no error, and
        # yields exactly the unstamped binary we set out to stop shipping.
        local said; said="$(stamped_rev "$name")"
        if [ "$said" != "$MAIN" ]; then
            err "post-install $name SAYS $(short "$said") when asked (\`$name version --json\`) but main is $(short "$MAIN") — the binary cannot say what it contains"
            exit 4
        fi
        log "installed $name is now $(short "$now") and says so itself"
    done
    # `yes` is claimed only once every binary has been asked and answered main.
    # A `go install` that returned 0 over a split pair is the failure this loop
    # exists to catch, so the flag it drives must not be set before it runs —
    # that would report GOBIN as good on the one path that just proved it is not.
    DEPLOY_INSTALLED="yes"
}

# ---------------------------------------------------------------------------
# do_prove — the deploy must not trust a detector it has not just proven can
# fail. Runs the live control against the BUILT ARTIFACT, both directions, and
# refuses to deploy unless it observes both (mg-bfe5).
#
# WHY THIS EXISTS: do_build runs `go install` and NO TESTS. The live control is
# wired into test.sh, so it runs at MERGE and never at DEPLOY — every redeploy
# before this shipped a pogod whose detector had never been exercised against it.
# The attended ones were not safe either; they were covered by a human standing
# there doing the detector's job by hand.
#
# AND MERGE-TIME PROOF DOES NOT SUBSTITUTE. It is tempting — the refinery really
# does re-gate on the exact tree that lands (mg-a9bb read it: attemptMerge orders
# fetch -> checkout -B -> rebase -> runQualityGates -> merge --ff-only, so the
# gate runs on the rebased worktree, there is no batch primitive, and --ff-only
# re-gates on a race). So "main is green" is NOT a decaying claim. It is still
# the wrong fact: a merge-time pass is a claim about a COMMIT, and what gets
# kickstarted is an ARTIFACT. `go install` reads a toolchain, a module cache and
# a build environment that the gate's machine did not necessarily share.
#
# WHY THIS SHAPE AND NOT A PATH LIST: "re-prove when the diff touches the reap"
# is a PROXY for "did this change break the detector?", and it inherits that
# proxy's decay — move the reap out of cmd/pogod/main.go and the list silently
# stops covering it. It fails OPEN: a check that can no longer fail, inside the
# mechanism protecting the thing we spent all night proving can fail. Tonight
# proved it twice (a `-eq 4` literal decayed on the next commit; mg-6b66's
# main.go:915 decayed on that same night's merges). Every decaying guard is a
# proxy for a question you could ask directly — and this question is directly
# observable, so it asks it: run the detector and see. This function names no
# path, judges no diff, and asserts nothing about the tree. It contains a
# measurement, not a claim, which is why it cannot rot.
#
# ITS HONEST LIMIT: per-run proof shows the detector WORKS; it cannot show its
# coverage is COMPLETE. Nothing self-proves coverage. That argues for expanding
# the control as new modes are learned — not for a human, who at 03:00 is asleep
# and awake would be reading these same signals by hand.
do_prove() {
    local ctl="$REPO/scripts/pogo-self-deploy_live_test.sh"
    # pogod specifically: the control proves the DAEMON's detector.
    local bin; bin="$(installed_bin pogod)"
    # ...and the CLI, because the drain gate now shells to `pogo agent witness`
    # to ask the on-disk witness whether the fleet is live (mg-65b2). That makes
    # the CLI part of the deploy's decision path, not just its payload, so the
    # control drives the artifact we are about to install rather than whatever
    # `pogo` the PATH happens to resolve. Same discipline as $bin above: prove
    # the thing being deployed, not a stand-in for it.
    local cli; cli="$(installed_bin pogo)"

    # The gate must fail CLOSED on its own absence. If the control is missing,
    # that is not "nothing to prove" — it is the detector's detector gone, which
    # is the exact fail-open this function exists to close.
    if [ ! -f "$ctl" ]; then
        err "live control $ctl not found — refusing to deploy a pogod whose detector cannot be proven"
        exit 9
    fi
    if [ ! -x "$bin" ]; then
        err "no installed pogod at $bin to prove — refusing to deploy"
        exit 9
    fi
    # Fail closed on the CLI's absence too, rather than letting the control
    # quietly source-build one: do_build installs pogo in lockstep with pogod
    # (mg-ddf1), so a missing artifact here means the build did not do what it
    # said, and proving a binary we then do not deploy proves nothing.
    if [ ! -x "$cli" ]; then
        err "no installed pogo CLI at $cli to prove — refusing to deploy"
        err "the drain gate shells to 'pogo agent witness' when pogod stops answering (mg-65b2),"
        err "so an unproven CLI is an unproven gate."
        exit 9
    fi

    # Re-entrancy: fail LOUD, never skip. The live control drives real
    # cmd_redeploy runs, and today every one of them dies in do_build (exit 4)
    # and so never reaches here — but that is a CLAIM about the control, and
    # claims rot. If one ever gets past the build, this turns an infinite
    # recursion of 2-minute daemon-spawning runs into one legible error. Skipping
    # instead would mean a stray env var silently downgrades a deploy to the
    # unproven behaviour this ticket removes, which is the wrong direction to
    # fail in.
    if [ -n "${POGO_DEPLOY_PROVING:-}" ]; then
        err "do_prove re-entered from inside the live control (POGO_DEPLOY_PROVING is set) — refusing to recurse"
        exit 9
    fi

    log "proving the detector against the built artifact $(short "$(installed_rev pogod)") ($bin)"
    log "  running $ctl — both directions, ~2min; a deploy does not trust an unproven detector"

    # Capture rather than stream: the verdict is drawn from the tokens, so the
    # output has to be readable afterwards. It is echoed on failure only — on
    # success the two PROVED lines below are the whole story.
    local out rc=0
    out="$(POGO_DEPLOY_PROVING=1 POGO_LIVE_CONTROL_POGOD="$bin" POGO_LIVE_CONTROL_POGO="$cli" bash "$ctl" 2>&1)" || rc=$?

    if [ "$rc" -ne 0 ]; then
        err "the live control FAILED against the built artifact (exit $rc) — refusing to deploy a pogod whose detector does not work on it"
        printf '%s\n' "$out" | sed 's/^/  control: /'
        exit 9
    fi

    # BOTH DIRECTIONS OR NOTHING. Not the exit code: exit 0 only means nothing
    # that ran failed, and cannot tell a run that demonstrated both directions
    # from one where the RED control was deleted, skipped, or never reached. A
    # control that only demonstrates RED can be hard-wired to RED; one that only
    # demonstrates GREEN is decoration. So assert on what was OBSERVED.
    local saw_red=false saw_green=false
    printf '%s\n' "$out" | grep -q '^PROVED: RED$'   && saw_red=true
    printf '%s\n' "$out" | grep -q '^PROVED: GREEN$' && saw_green=true

    if ! $saw_red || ! $saw_green; then
        err "the live control exited 0 but did not demonstrate both directions against the artifact (RED=$saw_red GREEN=$saw_green) — refusing to deploy on a detector that was not shown able to fail AND able to pass"
        printf '%s\n' "$out" | sed 's/^/  control: /'
        exit 9
    fi

    log "proven on this artifact: detector goes RED on a broken fleet and GREEN on an intact one"
}

# ---------------------------------------------------------------------------
# The restart IS the prompt install (mg-b6bd). Read this before grepping.
# ---------------------------------------------------------------------------
# `grep -c 'prompt install' scripts/pogo-self-deploy` is 0, and has been since
# this script was written. That is the correct result and it does NOT mean
# prompts never get installed, which is the conclusion mg-b6bd drew from it —
# reasonably, because nothing in here said otherwise until now.
#
# The four acts of getting a merged prompt fix in front of a running agent:
#
#   1. merge the prompt fix                   the refinery
#   2. ship the new binary                    do_build + go install, above
#   3. install the prompts onto disk          do_restart, below, INDIRECTLY
#   4. restart the agent so it re-reads       do_restart for auto_start = true;
#                                             the mail-check alert at the end of
#                                             cmd_redeploy names the others
#
# Act 3 is performed by pogod's own boot: cmd/pogod/main.go calls
# agent.InstallPrompts before it auto-starts any crew (40b60c1, 2026-04-27), so
# the kickstart below propagates every prompt the new binary embeds. This script
# has no business shelling out to `pogo agent prompt install` on top of that —
# it would be a second installer racing the first, with no way to say which one
# wrote a given file.
#
# So act 3 IS automatic and its cadence IS nightly. What it was missing until
# mg-b6bd is a record: the boot logged a counts-only line ("updated=9") to
# pogod.log, from which nobody could tell WHICH prompts moved or FROM WHAT
# revision. report_prompt_refresh below reads the record pogod now emits and
# puts it in this transcript, which is the artifact an operator actually reads.
do_restart() {
    local target="gui/$(id -u)/$DAEMON_LABEL"
    log "restarting pogod: launchctl kickstart -k $target"
    # ALWAYS kickstart — never rely on KeepAlive to pick up a stopped job
    # (mg-6afa mechanism 2 / mg-50e0). -k kills the running instance first.
    $LAUNCHCTL kickstart -k "$target" || { err "launchctl kickstart failed"; exit 5; }
}

# ---------------------------------------------------------------------------
# Spawn accounting (mg-9cc0): how many times did launchd have to start pogod
# before one of them stayed up?
# ---------------------------------------------------------------------------
#
# WHAT WENT UNRECORDED. On 2026-08-13 at 02:01:19Z — inside the `verify` stage
# of the run 17 lines of this same log describe as a success — launchd's first
# post-kickstart spawn of com.pogo.daemon died 29ms in:
#
#   'xpcproxy exited due to OS_REASON_CODESIGNING | Launch Constraint Violation
#    ... ran for 29ms' / 'removing service since it exited with consistent
#    failure'
#
# launchd respawned 10s later, that instance came up, verify_running saw main's
# revision, and the deploy reported success. Everything after the first spawn is
# true. The burned spawn appears in NOTHING this project writes: pogo-deploy.log
# for that window holds `stage: restart`, `stage: verify`, `verified:` and not
# one word about a restart that took two attempts.
#
# The one place it did appear was the unified log, and that is a tier which ages
# out in hours: it was readable at ~07:30 and gone by ~08:50 the same morning.
# So the failure was, by mid-morning, not merely unrecorded but unobservable —
# which is the actual defect. A retry that succeeds is fine. A retry nobody can
# ever learn about is not.
#
# WHY A DELTA AND NOT A READING. launchd does keep durable state: this box still
# read `last exit reason = OS_REASON_CODESIGNING` on a healthy daemon seven
# hours later, long after the log line had aged out. But `runs` and
# `last exit …` are LIFETIME values — they carry no timestamp and no attribution.
# Printed on their own every night they would say OS_REASON_CODESIGNING forever,
# about an event nobody could place, which is the mg-fa79 reading of them
# ("counters are not evidence") and it is correct for a single-sample check.
#
# Two samples change what the same fields can answer. `runs` sampled either side
# of THIS kickstart bounds the spawns to THIS restart, and once the delta says
# an attempt was burned, `last exit …` is no longer a floating lifetime value:
# the only instance that has exited since the pre-reading is the burned one, so
# the record describes it. Measured, not assumed — on this host a job armed to
# fail its first spawn moved runs 3 -> 5 across one `kickstart -k`, with
# `last exit code = 1` from the spawn that died and the survivor arriving on
# launchd's 10s respawn throttle. Same delta, same shape, same 10s as the night
# this is about.
#
# WHY PURE SHELL AND launchctl, WITH NO `pogo` CALL. This recorder must not
# depend on the artifact under suspicion. report_supervision and
# report_prompt_refresh both ask the freshly-installed `pogo` binary — sound for
# what they report, and exactly wrong here: the failure being recorded is a
# LAUNCH CONSTRAINT VIOLATION against the newly installed binary, so a reader
# that has to launch that binary can fail for the same reason as the thing it
# was sent to observe. It would go quiet in precisely the case it exists for.
# launchctl is the kernel-side bookkeeper and is not the artifact being deployed.

# launchd_runs — parse launchd's lifetime spawn counter from `launchctl print`
# output on stdin. Echoes the integer, or nothing when the field is absent or
# unparseable. Pure: no launchctl, no clock. Nothing is echoed as 0 on failure —
# 0 is a legal counter value and must not double as "could not read".
launchd_runs() {
    sed -n 's/^[[:space:]]*runs = \([0-9][0-9]*\)[[:space:]]*$/\1/p' | head -1
}

# launchd_exit_record — parse launchd's account of why the PREVIOUS instance of
# the job exited, from `launchctl print` output on stdin. Pure.
#
# launchd prints this two different ways and the interesting one is the rarer:
#
#   last exit reason = OS_REASON_CODESIGNING   a kernel-side kill (the 08-13 case)
#   last exit code = 1                         an ordinary nonzero exit
#
# Both are reported. `last exit code = (never exited)` is launchd's way of
# saying there is no record, so it yields empty rather than being passed through
# as though it named a reason.
#
# A `kickstart -k` of a healthy job leaves NO such line at all (measured): the
# SIGKILL launchd itself issues is not recorded as an exit. So the presence of
# one of these lines after a restart is already a signal, and its absence
# alongside a burned spawn is worth printing as an absence rather than skipping.
launchd_exit_record() {
    local out reason code
    out="$(cat)"
    reason="$(printf '%s' "$out" | sed -n 's/^[[:space:]]*last exit reason = \(.*[^[:space:]]\)[[:space:]]*$/\1/p' | head -1)"
    code="$(printf '%s' "$out" | sed -n 's/^[[:space:]]*last exit code = \(.*[^[:space:]]\)[[:space:]]*$/\1/p' | head -1)"
    case "$code" in "(never exited)"|"") code="" ;; esac
    if [ -n "$reason" ] && [ -n "$code" ]; then
        printf 'last exit reason = %s (code %s)' "$reason" "$code"
    elif [ -n "$reason" ]; then
        printf 'last exit reason = %s' "$reason"
    elif [ -n "$code" ]; then
        printf 'last exit code = %s' "$code"
    fi
}

# spawn_snapshot — the impure half: one `launchctl print` of the daemon job,
# rendered as a single tab-separated "RUNS<TAB>EXIT_RECORD" line.
#
# RUNS is "?" when the counter could not be read for ANY reason, and the reason
# travels in the second field so the report can say which kind of blindness it
# hit. Never fails: an unreadable sample is a thing to report, not a thing to
# abort a deploy over.
spawn_snapshot() {
    local target="gui/$(id -u)/$DAEMON_LABEL" out runs rec
    if ! out="$($LAUNCHCTL print "$target" 2>&1)"; then
        printf '?\tlaunchctl print %s failed: %s\n' "$target" "$(printf '%s' "$out" | head -1)"
        return 0
    fi
    runs="$(printf '%s' "$out" | launchd_runs)"
    rec="$(printf '%s' "$out" | launchd_exit_record)"
    if [ -z "$runs" ]; then
        printf '?\tno `runs` field in launchctl print %s\n' "$target"
        return 0
    fi
    printf '%s\t%s\n' "$runs" "$rec"
}

# format_spawn_report BEFORE AFTER EXIT_RECORD NOTE — render the spawn
# accounting for one restart. Pure: no launchctl, no daemon, no clock, so the
# controls can drive every branch without a host. Prefixes each line with
# "ok: " or "loud: " and lets the caller pick log vs err, on the same split
# format_prompt_refresh uses.
#
# It ALWAYS emits a line. A restart that took exactly one spawn says so — the
# positive record is what makes its absence mean something, and "no news"
# is what this defect looked like for the whole of 2026-08-13.
format_spawn_report() {
    local before="$1" after="$2" rec="$3" note="$4" delta
    if [ "$before" = "?" ] || [ "$after" = "?" ]; then
        echo "loud: restart: SPAWN COUNT UNREADABLE (before=${before} after=${after}) — this deploy cannot say whether the kickstart took one attempt or several. ${note}"
        return 0
    fi
    if [ "$after" -lt "$before" ]; then
        # launchd resets the counter when a job is unloaded and re-registered,
        # which is what it does after "removing service since it exited with
        # consistent failure" — the exact phrase from the 08-13 episode. So a
        # counter that went BACKWARDS is not a bad reading, it is the loudest
        # reading this function has.
        echo "loud: restart: launchd's spawn counter went BACKWARDS (before=${before} after=${after}) — the ${DAEMON_LABEL} job was UNLOADED and re-registered during this restart. That is what launchd does when it removes a service after consistent failure, so treat this as at least one burned spawn and probably several."
        [ -n "$rec" ] && echo "loud: restart:   launchd's exit record for the job: ${rec}"
        return 0
    fi
    delta=$(( after - before ))
    case "$delta" in
        0)
            # A kickstart always spawns. Zero means the two samples are not of
            # the same job instance, or the restart did not happen.
            echo "loud: restart: launchd's spawn counter did NOT move across the kickstart (runs=${before} both sides) — a kickstart always spawns, so either the restart did not reach launchd or these two samples are of different job instances. The revision check below is the one to believe over this."
            ;;
        1)
            echo "ok: restart: 1 spawn, no attempts burned (launchd runs ${before} -> ${after})"
            ;;
        *)
            echo "loud: restart: took ${delta} SPAWNS — $(( delta - 1 )) burned before one stayed up (launchd runs ${before} -> ${after}). The daemon is up and the verifies below still mean what they say; what this line adds is that getting here was not clean."
            if [ -n "$rec" ]; then
                echo "loud: restart:   why the burned spawn died — ${rec}. The only instance to have exited since the pre-kickstart reading is that one, so this record is about THIS restart, not a lifetime leftover."
            else
                echo "loud: restart:   launchd has NO exit record for the burned spawn, so this deploy can say that an attempt was burned but not why. Check now, before it ages out: log show --last 1h --predicate 'process == \"launchd\"' --info --debug | grep ${DAEMON_LABEL}"
            fi
            echo "loud: restart:   IF that reason is OS_REASON_CODESIGNING, this is the mg-9cc0 shape: a Launch Constraint Violation refused the just-installed binary on its first launch and accepted it on the retry. Any other reason is a different failure and worth its own ticket."
            ;;
    esac
}

# report_spawns — the caller. Reads the post-restart sample, formats against the
# pre-kickstart one captured in cmd_redeploy, and routes each line to log/err.
#
# Report-only, and deliberately so: a deploy whose daemon is up, current and
# serving is a successful deploy even if launchd needed two goes to get there.
# The defect this closes is silence, not the retry.
#
# MUST BE CALLED AFTER verify_running, AND THE REASON IS NOT TIDINESS. The post
# sample has to be taken once a spawn has STAYED up, or it undercounts. launchd
# reports a dying spawn as `state = running` for the milliseconds it lives, so
# anything that waits on launchd's own state field can sample between the burned
# spawn and its replacement and read a delta of 1 — a burned spawn rendered as a
# clean restart. The control for this ticket did exactly that on its first run.
# verify_running is immune because it polls GET /version until a pogod ANSWERS,
# which a spawn that dies in 29ms never does.
report_spawns() {
    local before="$1" snap after rec line
    snap="$(spawn_snapshot)"
    after="${snap%%	*}"
    rec="${snap#*	}"
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        case "$line" in
            "loud: "*) err "${line#loud: }" ;;
            *)         log "${line#ok: }" ;;
        esac
    done <<EOF
$(format_spawn_report "$before" "$after" "$rec" "$rec")
EOF
}

# format_prompt_refresh — render ONE prompt_refresh event (raw JSONL on stdin)
# into the lines this deploy should log. Pure: no daemon, no CLI, no clock.
#
# Empty input means no record at all, and that gets a line of its own rather
# than silence. Three things produce it and they are not distinguishable from
# here — the restarted pogod predates the record (any build before mg-b6bd),
# the events log is unwritable, or act 3 genuinely did not run. All three are
# worth a word; none of them is worth failing a deploy whose daemon is up and
# answering, so this reports and never sets an exit code.
format_prompt_refresh() {
    local ev; ev="$(cat)"
    if [ -z "$ev" ]; then
        echo "prompts: NO REFRESH RECORD from this restart — cannot say whether act 3 ran, which prompts moved, or from what revision. Either the new pogod predates the prompt_refresh event, or the refresh did not happen. Check: pogo events list --since=1h --type=prompt_refresh --json"
        return 0
    fi
    local ok rev changed installed updated conflicts errmsg
    ok="$(printf '%s' "$ev" | json_bool ok)"
    rev="$(printf '%s' "$ev" | json_str revision)"
    changed="$(printf '%s' "$ev" | json_num changed)"
    installed="$(printf '%s' "$ev" | json_arr installed)"
    updated="$(printf '%s' "$ev" | json_arr updated)"
    conflicts="$(printf '%s' "$ev" | json_arr conflicts)"

    if [ "$ok" = "false" ]; then
        errmsg="$(printf '%s' "$ev" | json_str error)"
        echo "prompts: REFRESH FAILED at $(short "${rev:-?}") — every live prompt is still at its previous content. ${errmsg:-no reason recorded}"
        return 0
    fi

    # ok=true. Say what moved, by name, or say plainly that nothing did — the
    # no-op is the answer to "is the fleet current", not an absence of one.
    if [ "${changed:-0}" = "0" ] || [ -z "$changed" ]; then
        echo "prompts: all current at $(short "${rev:-?}") — nothing to install (this is the normal outcome; the record is what makes it distinguishable from a refresh that never ran)"
    else
        echo "prompts: ${changed} changed at $(short "${rev:-?}")"
        [ -n "$installed" ] && echo "prompts: INSTALLED (new): $installed"
        [ -n "$updated" ] && echo "prompts: UPDATED: $updated — agents that were NOT restarted by this bounce are still running the old text until they are"
    fi
    if [ -n "$conflicts" ]; then
        echo "prompts: ⚠ DECLINED (hand-edited canonical preserved, shipped copy went to <name>.dist): $conflicts"
    fi
    return 0
}

# report_supervision — put the post-restart supervision reading in the
# transcript (mg-fa79). Reports only; never sets an exit code.
#
# WHAT IT ADDS THAT verify_running DOES NOT. verify_running asks whether a pogod
# at main's revision is answering. In the 2026-08 displacement the answering
# pogod was a process launchd had not started and could not restart — and if it
# had been at main's revision already (an orphan that outlived a previous
# deploy), verify_running would have said "verified" about a daemon this
# deploy's kickstart did not touch. That is not hypothetical about REVISION, it
# is a statement about IDENTITY, and revision cannot see it.
#
# Deliberately report-only, on the same reasoning as report_prompt_refresh: the
# fleet is up and answering by the time this runs, and a supervision finding is
# a thing to say loudly, not a reason to call a completed deploy failed. It also
# tolerates a `pogo` with no such subcommand — on the FIRST night this ships,
# the CLI being asked is the one this deploy just installed, but a rollback or a
# hand-run against an older install must not turn an unknown subcommand into a
# deploy failure.
report_supervision() {
    local cli; cli="$(installed_bin pogo)"
    if [ ! -x "$cli" ]; then
        log "supervision: SKIPPED — no pogo CLI at $cli to ask"
        return 0
    fi
    local out rc
    out="$("$cli" service supervision 2>&1)"; rc=$?
    case "$rc" in
        0) log "supervision: $(printf '%s' "$out" | head -1)" ;;
        1) err "supervision: $(printf '%s' "$out" | head -1)"
           err "supervision: THIS DEPLOY'S RESTART ACTED ON A JOB THAT IS NOT THE RUNNING DAEMON. The revision check above can still read green — it asks what is answering, not who launchd supervises."
           printf '%s\n' "$out" | tail -n +2 | while IFS= read -r l; do err "supervision:   $l"; done ;;
        *) log "supervision: could not establish (exit $rc) — $(printf '%s' "$out" | head -1)" ;;
    esac
    return 0
}

# ---------------------------------------------------------------------------
# Launchd activation reporting (mg-b9e7)
# ---------------------------------------------------------------------------
#
# THE GAP. Nothing on this machine re-asserts an installed LaunchAgent plist
# against the one the code ships. A merge under scripts/launchd/ changes nothing
# until somebody runs `pogo service install <...>` — no boot hook, no login hook,
# and until this, no step of the nightly redeploy. `pogo doctor --check` grew a
# `launchd activation` row (mg-fc99) that does the comparison, but it only exists
# when a person runs doctor, so between two such runs the drift is silent. It was
# silent for seven days in the case mg-b201 fixed: the box ran a one-fire deploy
# plist against three-fire code, and every fire the installed copy lacked was
# INERT — no log line, no failure, nothing downstream that could observe it.
#
# WHY THE READING BELONGS HERE AND NOWHERE ELSE. The audit compares the installed
# plist against the plist THIS BUILD renders, so its answer is only as good as
# the binary asked. Ask an old `pogo` and it reports its own older plist as the
# expectation — on 2026-08-07 that build predated the schedule change, so
# "reconciling" from it would have reinstalled the drift and printed success.
# This step runs immediately after the deploy has built, installed and VERIFIED a
# binary from main, which is the one moment in this machine's day when "which
# build?" has a right answer. That placement is the whole reason a nightly step
# can be trusted with this question at all.
#
# REPORT-ONLY, on the same reasoning as report_supervision. It never installs,
# never bootstraps, never kickstarts, and it never sets this script's exit code:
# the fleet is up and answering by the time it runs, and a stale plist is a thing
# to say loudly, not a reason to call a completed deploy failed.
#
# AND IT STAYS THAT WAY — that is a DECISION (mg-de0c), not a gap. mg-b9e7 left
# auto-reconciling open; it is now closed as NO, per job, with the blast radius
# measured. docs/design/launchd-reconcile-decision.md is the argument; the four
# findings that decide it are:
#
#   - `pogo service install` reaches the orchestrated bounce every time a
#     reconciler would fire, because its skip-when-unchanged gate is false by
#     construction in the drift case. And the drift on this box is the legacy
#     POGO_HOME=$HOME — reconciling it moves the running daemon's state root,
#     unattended, on a nightly whose next act is to call the deploy a success.
#   - `install-recovery` bootstraps a RunAtLoad=true job, so it RUNS
#     pogo-recovery.sh, which kickstarts pogod whenever a .req sits in the
#     queue — a conditional daemon bounce whose condition nothing here reads.
#   - `install-deploy` boots out THIS job. Measured with an isolated LaunchAgent:
#     the process dies AT the `launchctl bootout` line, so the `bootstrap` that
#     follows it in InstallDeploy NEVER RUNS. The plist is left byte-correct on
#     disk and the job left UNLOADED — the nightly deletes itself from launchd
#     until the next login, and nothing survives to report it.
#   - com.pogo.reclaim is ABSENT, not drifted, and the audit says in its own
#     output that it cannot tell a job deliberately left uninstalled from one
#     whose install never ran.
#
# THE DODGE THAT LOOKS SAFE IS THE WORST OPTION. "Write the plist, skip the
# reload" avoids every launchctl hazard above — and the audit's drift predicate
# is byte equality of the file on disk, which nothing in buildActivationReport
# crosses with whether the job is LOADED. So it would flip this step's verdict
# from DRIFTED to ACTIVATED and its exit status from 1 to 0 while launchd still
# runs the old job, for however many weeks until the next login. That is mg-8f7e
# exactly — an artifact that merged, was never activated, and reads green —
# manufactured by its own remedy. pogo-self-deploy_test.sh asserts, with an armed
# witness, that this step invokes the CLI once and only for check-activation.
#
# IT ESCALATES, THOUGH — because a report that lands only in pogo-deploy.log is
# the opt-in problem again with a different reader. DRIFTED and NO VERDICT go out
# through alert_external, at most once per night, and they stop the moment
# somebody reconciles. UNKNOWN does not mail: a plist deliberately left
# uninstalled would otherwise alert every night forever with nothing drifted.
#
# THE DEFECT THIS STEP IS SUBJECT TO, AND WHAT IS DONE ABOUT IT. The detector
# ships inside the `pogo` binary, so a build predating it does not have it — the
# detector for "merged but not installed" being itself merged but not installed
# is mg-b9e7's second gap, and a remedy in the same shape inherits it. Two things
# make it survivable here:
#
#   - `check-activation` is a TOP-LEVEL command, not `pogo service
#     check-activation`. Measured on this box: `pogo service <unknown>` exits 0
#     and prints help, while `pogo <unknown>` exits 1. Under `service` an old
#     binary would have answered this step with a SUCCESS.
#   - nonzero is still not enough, because "unknown command" and "drifted" are
#     both exit 1. So the verdict line carries a marker, and this step refuses to
#     read an exit status as a verdict without it. An old binary is reported as
#     NO VERDICT — its own finding — never as clean and never as drift.
#
# What remains uncovered, stated rather than implied: this runs inside a deploy,
# so a box whose nightly has been failing for a week gets no report. That is the
# same argument that keeps com.pogo.revisionprobe outside internal/service's
# registry (mg-a03d), and it is not closed here.

# classify_activation RC FIRST_LINE -> ACTIVATED | DRIFTED | UNKNOWN | MISMATCH |
# NO_VERDICT. Pure, so every branch is reachable in a test on a box whose real
# answer is whatever it happens to be today.
#
# It reads BOTH the marker word and the exit status and requires them to agree.
# They are two renderings of one value in cmd/pogo/checkactivation.go, so a
# disagreement means something between here and there is rewriting one of them —
# a wrapper swallowing exit codes is the ordinary way that happens — and a
# reader that trusted either alone would report a confident wrong answer.
classify_activation() {
    local rc="$1" line="$2" word
    case "$line" in
        "activation: "*) word="${line#activation: }"; word="${word%% *}" ;;
        *)               echo "NO_VERDICT"; return 0 ;;
    esac
    case "$word/$rc" in
        ACTIVATED/0) echo "ACTIVATED" ;;
        DRIFTED/1)   echo "DRIFTED" ;;
        UNKNOWN/3)   echo "UNKNOWN" ;;
        *)           echo "MISMATCH" ;;
    esac
}

# alert_activation VERDICT REPORT — the escalation, split out so report_activation
# stays testable without a mailbox.
alert_activation() {
    local verdict="$1" report="$2" subject preamble
    case "$verdict" in
        NO_VERDICT|MISMATCH)
            subject="[activation] the pogo this deploy installed cannot answer the launchd activation check"
            preamble="The nightly asked the freshly-installed \`pogo\` whether every managed launchd
plist matches the code it ships, and got no usable verdict back. The likely
cause is that this build predates \`pogo check-activation\` — which is exactly
the defect the check exists to report, one layer down: the detector for
'merged but not installed' merged but not installed.

Until this is resolved the nightly is NOT watching the plists at all." ;;
        *)
            subject="[activation] installed launchd plist(s) disagree with the code that ships them"
            preamble="The nightly compared every managed launchd plist against the plist the binary
it just installed from main would write, and they differ. A plist that differs
in its FIRE TIMES is a job doing a fraction of what the code believes it does,
and every fire it lacks is INERT — it writes no log line and produces no
failure, so nothing downstream can observe its absence.

Nothing was reconciled. This deploy SUCCEEDED; the drift is a separate defect
that predates it and outlives it." ;;
    esac
    alert_external launchd_activation_drift \
        "$subject" \
        "$preamble

$report

Reconcile by hand, from a build that CONTAINS the plist change:

  cd \$POGO_DEPLOY_SRC        # ~/.pogo/deploy-src — the checkout this deploy built
  ./build.sh --install        # so the installer you run renders the CURRENT plist
  pogo check-activation       # confirm the remedy each job names
  <the \`pogo service install*\` the report names, one per drifted job>

Then READ BACK, because the installer's own output does not prove anything:

  /usr/libexec/PlistBuddy -c 'Print :StartCalendarInterval' \\
      ~/Library/LaunchAgents/<label>.plist
  launchctl print gui/\$UID/<label>        # what launchd actually registered

Install OUTSIDE the 02:00-06:00 window: \`install-deploy\` does a \`launchctl
bootout\` first, and booting the deploy job out mid-fire kills a deploy in
progress. See scripts/launchd/README.md, 'What re-asserts an installed plist
against the shipped one'." \
        "{\"verdict\":\"${verdict}\",\"deploy_ref\":\"${DEPLOY_REF:-?}\",\"main\":\"$(short "${MAIN:-?}")\"}" \
        || err "activation: the drift report could NOT be delivered — pogo-deploy.log is the only trace"
    return 0
}

# report_activation — the impure half: ask the binary this deploy just installed
# whether the box's launchd plists match it, and put the answer in this
# transcript. Never sets an exit code.
report_activation() {
    local cli; cli="$(installed_bin pogo)"
    if [ ! -x "$cli" ]; then
        log "activation: SKIPPED — no pogo CLI at $cli to ask. This is NOT a report that the plists are current"
        return 0
    fi
    local out rc first verdict
    out="$("$cli" check-activation 2>&1)"; rc=$?
    first="$(printf '%s\n' "$out" | head -1)"
    verdict="$(classify_activation "$rc" "$first")"

    case "$verdict" in
        ACTIVATED)
            log "activation: $first"
            ;;
        UNKNOWN)
            # Loud in the transcript, not in the mail. "Could not compare" is a
            # real answer and is not a pass — but a job deliberately left
            # uninstalled sits in it indefinitely, and a nightly alert nothing
            # can clear is the surest way to get this check filtered.
            err "activation: $first"
            printf '%s\n' "$out" | tail -n +2 | while IFS= read -r l; do err "activation:   $l"; done
            ;;
        DRIFTED)
            err "activation: $first"
            err "activation: THE INSTALLED PLISTS ARE NOT WHAT THIS DEPLOY'S CODE SAYS. Nothing here reconciles them; a fire the installed copy lacks is inert and writes no log line."
            printf '%s\n' "$out" | tail -n +2 | while IFS= read -r l; do err "activation:   $l"; done
            alert_activation "$verdict" "$out"
            ;;
        MISMATCH)
            err "activation: the verdict word and the exit status DISAGREE (exit $rc, line '$first') — something between this script and the CLI is rewriting one of them, and neither can be trusted"
            alert_activation "$verdict" "$out"
            ;;
        *)
            err "activation: NO VERDICT — \`$cli check-activation\` exited $rc with no activation marker. An exit status without the marker is NOT a clean box: this build almost certainly predates the check, which is the defect the check reports."
            err "activation:   ${first:-<no output>}"
            alert_activation "$verdict" "$out"
            ;;
    esac
    return 0
}

# report_prompt_refresh — the impure half: ask the freshly-restarted pogod's
# event log what act 3 did, and put it in this transcript.
#
# --since is generous on purpose. It is bounded by the fact that we only ever
# read the LAST matching record, and this runs seconds after a restart that
# emits one; a wide window costs nothing and survives a slow boot, where a tight
# one would report "NO REFRESH RECORD" for a refresh that was merely late.
report_prompt_refresh() {
    local cli; cli="$(installed_bin pogo)"
    local ev=""
    if [ -x "$cli" ]; then
        ev="$("$cli" events list --since="${PROMPT_REFRESH_WINDOW:-15m}" --type=prompt_refresh --json 2>/dev/null | grep . | tail -1)"
    fi
    local line
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        case "$line" in
            *"NO REFRESH RECORD"*|*"REFRESH FAILED"*|*DECLINED*) err "$line" ;;
            *) log "$line" ;;
        esac
    done <<EOF
$(printf '%s' "$ev" | format_prompt_refresh)
EOF
}

verify_running() {
    local deadline=$(( $(date +%s) + 60 )) rev
    while :; do
        rev="$(running_rev)"
        if [ "$rev" = "$MAIN" ]; then
            log "verified: new pogod running at $(short "$rev")"
            return 0
        fi
        if [ "$(date +%s)" -ge "$deadline" ]; then
            err "new pogod did not report main revision within 60s (got '${rev:-unreachable}')"
            return 1
        fi
        sleep 3
    done
}

# on_deploy_exit — the single EXIT trap (mg-0155). Two jobs, in this order:
# restore dispatch if this run armed it, then write the reason record.
#
# The restore runs FIRST so that its own errors — "drain restore FAILED (HTTP
# ...)" is the loudest line this script can emit — are in the transcript the
# record carries. A record written before the restore would describe a run that
# had not finished failing.
#
# ONE trap, installed ONCE, at the top of cmd_redeploy. It used to be armed only
# inside the drain branch, which was correct for a trap whose only job was the
# restore and is wrong for one that also has to report: the exits BEFORE the
# drain (bad repo, unresolvable mg, unclassifiable drift, a declined prompt) are
# exactly the ones an operator is most likely to be told nothing useful about.
on_deploy_exit() {
    local code=$?
    restore_drain "$code"
    deploy_reason_record "$code"
}

# How long verify_orchestration polls for the new pogod to report full mode.
# Overridable so the controls do not pay a real deploy's wall clock.
ORCHESTRATION_VERIFY_TIMEOUT="${ORCHESTRATION_VERIFY_TIMEOUT:-60}"

# verify_orchestration — the second half of "the server came back", and the half
# that was missing (mg-6d2f).
#
# A restarted pogod ALWAYS starts in full mode: server.New hard-codes ModeFull
# and no config key selects index-only, so the only way to reach index-only is a
# POST to /server/stop-orchestration on a running daemon. That makes this a safe
# assertion rather than a policy: after a kickstart, anything other than `full`
# means the restart did not produce a working fleet, and there is no legitimate
# configuration in which it should.
#
# It polls rather than reads once because /version answering does not imply the
# mode endpoint is registered in the same instant, and a single read would turn a
# startup race into a nightly false RED — the surest way to get a check deleted.
verify_orchestration() {
    local deadline=$(( $(date +%s) + ORCHESTRATION_VERIFY_TIMEOUT )) mode
    while :; do
        mode="$(server_mode)"
        if [ "$mode" = "full" ]; then
            log "verified: orchestration is up (mode=full) — /agents, /refinery and /scheduler are past RequireOrchestration"
            return 0
        fi
        if [ "$(date +%s)" -ge "$deadline" ]; then
            err "THE FLEET IS DOWN: pogod restarted but orchestration did not start (mode=$mode)"
            err "  The process is up and /version answers at main's revision, so every"
            err "  ordinary liveness check on this box reads GREEN. It is not: /agents,"
            err "  /refinery and /scheduler are all returning HTTP 503, which means NO"
            err "  polecat will be dispatched and NO merge will run until this is fixed."
            err "  This is the state that went unnoticed for 10h39m on 2026-08-07."
            err "  Start it by hand and confirm:"
            err "    pogo server start"
            err "    curl -s $(base_url)/server/mode"
            return 1
        fi
        sleep 3
    done
}

cmd_redeploy() {
    # The reason channel, before anything that can fail (mg-0155). ERR_LOG must
    # exist before the first `err` call or that line is missing from the record,
    # and the first `err` call is inside assert_out_of_band on the next line.
    if [ -n "$REASON_FILE" ]; then
        ERR_LOG="$(mktemp -t pogo-self-deploy-err 2>/dev/null)" || ERR_LOG=""
    fi
    trap on_deploy_exit EXIT
    deploy_stage "startup"

    # FIRST, ahead of every other precondition (mg-1bbf). Not because it is the
    # most likely refusal but because it is the only one whose failure mode is
    # the fleet: everything below this line assumes the caller is allowed to
    # kill pogod's process tree, and that assumption is checked here or nowhere.
    assert_out_of_band

    # Resolve the macguffin `mg` to an absolute path up front. The redeploy's
    # entire alert path (mail_alert) and its orphan cleanup call `mg`; a redeploy
    # whose alerter cannot be resolved is a redeploy that cannot report its own
    # stalls — refuse it loudly rather than ship a silent one (mg-015f).
    resolve_mg || { err "cannot resolve the macguffin 'mg' — refusing to redeploy with an unusable alert path"; exit 1; }
    resolve_repo
    compute_drift
    print_drift
    if ! classify_drift; then err "$ACTION"; exit 1; fi
    echo "action    : $ACTION"
    if ! $NEEDS_BUILD && ! $NEEDS_RESTART; then
        log "nothing owed — pogod is already at main. Done."
        exit 0
    fi

    confirm

    # 1. Signal drain (stop dispatching new polecats) and let the fleet quiesce.
    #    Disambiguate three POST /agents/drain outcomes (mg-065e): endpoint
    #    present (drain), endpoint absent but server up (bootstrap — a pogod
    #    predating mg-cae1), and pogod genuinely down. Each has a DIFFERENT
    #    remedy, so they must not collapse into one "is pogod up?" message.
    local snapshot leftover=0
    deploy_stage "drain"
    if $SKIP_DRAIN; then
        # Operator-directed skip (or the bootstrap remedy). No drain, no fleet
        # quiesce, no snapshot — the kickstart -k below will bounce whatever is
        # running. Explicit acknowledgement of the un-drained bounce.
        log "--skip-drain: skipping drain phase (no fleet quiesce, no orphan cleanup)"
    else
        log "enabling drain mode"
        # Read dispatch as it stands BEFORE we touch it, then arm the restore.
        # Armed BEFORE the POST, not after, on purpose: a POST that times out
        # AFTER pogod set the flag comes back "000" and classifies as `down`,
        # so the one path where we cannot tell whether we mutated anything is a
        # path that must still restore. A restore POST on a genuinely-down or
        # bootstrap daemon fails harmlessly and says so; the reverse mistake is
        # a silent fleet-wide outage.
        DRAIN_PRIOR="$(drain_state)"
        DRAIN_ARMED=true
        # ONLY the EXIT trap restores. INT/TERM merely convert the signal into an
        # exit, because a bash signal handler that RETURNS resumes the script
        # where it was interrupted: `trap on_deploy_exit EXIT INT TERM` would
        # restore dispatch on Ctrl-C and then carry on building and kickstarting
        # with the fleet live — a cleanup that fires and then un-fires itself.
        # Routing both through exit gives one restore, on one path, with the
        # signal's status preserved.
        #
        # The EXIT trap itself is installed at the top of cmd_redeploy (mg-0155)
        # and is NOT re-installed here: DRAIN_ARMED, not the trap, is what says
        # whether there is dispatch to put back. Re-installing it would replace a
        # trap that also writes the reason record with one that only restores.
        trap 'err "interrupted (SIGINT) during the drain window"; exit 130' INT
        trap 'err "terminated (SIGTERM) during the drain window"; exit 143' TERM
        # One hop, both facts (mg-08e9). The status decides which refusal this
        # is; the body is what lets the next morning check that ruling instead
        # of taking it on faith.
        local dp_raw dp_body
        dp_raw="$(drain_post true)"
        dp_body="$(http_body "$dp_raw")"
        local disp; disp="$(classify_drain_precondition "$(http_status "$dp_raw")")"
        case "$disp" in
            drain)
                # Take drain_wait's OWN verdict and its OWN number, rather than
                # re-reading the endpoint for a third opinion (mg-65b2). The old
                # re-fetch was redundant on the timeout path and actively wrong
                # on the new one: when drain_wait refuses because pogod went
                # silent, that curl fails too, `${leftover:-?}` renders "?", and
                # the script announced "? polecat(s) still active after 1800s
                # drain timeout" — a confident story about a deadline that never
                # passed, over a state we had just admitted we could not read.
                # Telling a timeout's story about an unknown is this ticket's own
                # defect rebuilt inside its fix.
                local drain_rc=0 leftover
                leftover="$(drain_wait)" || drain_rc=$?
                if [ "$drain_rc" -eq 0 ]; then
                    report_drain_complete
                else
                    leftover="${leftover:-?}"
                    if ! $FORCE; then
                        if [ "$drain_rc" -eq 2 ]; then
                            # The drain could not establish the fleet's state and
                            # has already said why, in detail, above.
                            err "the drain could not establish whether the fleet is idle (see above)"
                            err "refusing to bounce a fleet whose state is unknown; restoring dispatch"
                        else
                            err "$leftover polecat(s) still hold commits that exist only in their worktree after ${DRAIN_TIMEOUT}s (named above)"
                            err "refusing to orphan unpushed work without --force; restoring dispatch"
                        fi
                        # The two err lines above are the ATTENDED report: they
                        # work because a human ran this and is reading them. The
                        # sink below is the UNATTENDED one, and it is not a
                        # louder version of them — it leaves the script (mg-f206).
                        # Fired BEFORE the exit, not from the trap: the trap runs
                        # on every armed exit path, and a sink that fires on all
                        # of them announces failures that are already reported by
                        # something else. This one is scoped to the single outcome
                        # nothing else can see — the run that changed NOTHING.
                        # The sink is told WHICH refusal this is: a busy fleet
                        # and an unreadable one need opposite reactions from the
                        # operator, and one story for both would mis-advise half
                        # the pages it sends (mg-65b2).
                        if [ "$drain_rc" -eq 2 ]; then
                            alert_drain_stalled unknown "$leftover"
                        else
                            alert_drain_stalled timeout "$leftover"
                        fi
                        # The restore is the trap's job now — and the trap puts
                        # back the PRIOR value, where the bare `drain_post false`
                        # that used to live here asserted `false` unconditionally.
                        # This path was the ONLY one that restored anything; every
                        # other exit between here and the kickstart leaked drain.
                        exit 7
                    fi
                    if [ "$drain_rc" -eq 2 ]; then
                        # Do not promise the cleanup here. The snapshot below is
                        # fetched from the daemon we just failed to read, so on
                        # this path it comes back EMPTY and cleanup_orphans has
                        # nothing to work from — no unclaim, no worktree removal.
                        # The timeout path's message can promise cleanup because
                        # pogod is answering there; saying it here would be one
                        # more confident claim about a state we cannot see, which
                        # is the whole thing this ticket removes.
                        log "--force: bouncing WITHOUT knowing whether polecats are live (the drain could not tell)"
                        log "--force: if any are, they will survive the bounce and keep their claims + worktrees;"
                        log "--force: no snapshot is readable from a silent pogod, so nothing will be cleaned up"
                    else
                        log "--force: hard-bouncing with $leftover polecat(s) still holding unpushed commits; will clean up after"
                    fi
                fi
                # Capture the pre-kickstart polecat snapshot for post-bounce cleanup.
                snapshot="$(curl -sf --max-time 5 "$(base_url)/agents/drain" 2>/dev/null)"
                ;;
            *)
                # bootstrap | stopped | down | error:<code> — four refusals that
                # all stop BEFORE the build, each needing a different operator
                # reaction. They live in one function (mg-0155) because that
                # function is the only place that knows which one this is, and
                # what it writes is what the operator reads: the runner carries
                # the sentence across rather than re-deriving one from the code.
                refuse_drain_precondition "$disp" "$dp_body"   # never returns
                ;;
        esac
    fi

    # 2. Build (only if a build is owed — a restart-only drift skips go install
    #    so we do not pay a rebuild we do not need).
    if $NEEDS_BUILD; then
        deploy_stage "build"
        do_build
    else
        log "installed already matches main — skipping go install (restart-only)"
    fi

    # 2a. Prove the detector against the artifact we are about to kickstart into
    #     — RED on a broken fleet, GREEN on an intact one — or refuse to deploy.
    #
    #     EVERY run, not just $NEEDS_BUILD runs. A restart-only deploy installs
    #     nothing, but it still kickstarts the fleet onto that binary and still
    #     leans on the post-check at step 5 to tell it whether the mail loop
    #     survived; the artifact being older than this run does not make its
    #     detector proven. Gating this on NEEDS_BUILD would also make the
    #     guarantee conditional on a drift classification — i.e. back to a claim
    #     about when proof is needed, which is the shape that rots.
    #
    #     Deliberately INSIDE the drain window, per the ticket: after go install,
    #     before do_restart. It costs ~2min of drain, and a refusal here exits
    #     while the trap is still armed — so the restore puts dispatch back
    #     exactly as it does for a failed build (mg-8b48). A refusal to deploy
    #     therefore leaves the OLD pogod running and the fleet dispatching, which
    #     is the correct resting state for "we could not prove the new one".
    deploy_stage "prove"
    do_prove

    # 3. Restart (always kickstart) and verify the new process is main.
    #    Read the fleet's mail-checks FIRST — the old pogod is the only thing
    #    that can tell us what there was to preserve (mg-de08). Keep the whole
    #    body, not just the ids: step 5 needs the agent each schedule is
    #    addressed to in order to name the losses a forced bounce explains, and
    #    after the kickstart there is nothing left to ask (mg-ea3e).
    local mail_pre_body="" mail_pre
    if mail_pre_body="$(schedules_body)"; then
        mail_pre="$(printf '%s' "$mail_pre_body" | extract_mail_check_ids)"
    else
        mail_pre="?"
    fi
    # Disarm BEFORE the kickstart: it kills the pogod whose dispatch flag we
    # mutated, so from here there is no state left to restore and no process to
    # restore it on. The replacement starts with draining at its zero value.
    # This is the far edge of the window mg-46a4 identified; past it, a restore
    # POST would be aimed at a DIFFERENT daemon than the one we changed — and if
    # drain had been on before, it would re-drain the fresh fleet.
    #
    # DRAIN_ARMED is what disarms the restore; the EXIT trap STAYS (mg-0155).
    # `trap - EXIT` here used to be belt-and-braces over the same flag, and since
    # the trap also writes the reason record it would now silence the run's
    # report over exactly the region where an install HAS happened — exit 8, the
    # one code whose remedy is allowed to talk about a binary on disk. INT/TERM
    # are still cleared: their only job was to convert a signal into a
    # restore-able exit, and there is nothing left to restore.
    DRAIN_ARMED=false
    trap - INT TERM
    deploy_stage "restart"
    # The pre-kickstart half of the spawn accounting (mg-9cc0). Taken as late as
    # possible and unconditionally: `runs` is a lifetime counter, so the delta is
    # only about this restart if nothing else bounced the job in between.
    local spawns_pre; spawns_pre="$(spawn_snapshot)"; spawns_pre="${spawns_pre%%	*}"
    do_restart
    deploy_stage "verify"
    # Report the spawn accounting BEFORE acting on the verify result, not after.
    # A deploy that burned spawns AND failed to come up is the worst case this
    # recorder exists for, and `verify_running || exit 8` would have exited
    # through it without a word — reproducing, in the remedy, the silence the
    # remedy is for.
    # `|| verify_rc=$?` rather than a bare call: this script is `set -u` only
    # today, but under a future `set -e` a bare failing call would abort here —
    # before the report — which is the same silence by a different route.
    local verify_rc=0
    verify_running || verify_rc=$?
    report_spawns "$spawns_pre"
    [ "$verify_rc" -eq 0 ] || exit 8
    # BOTH, and in this order. verify_running answers "is a pogod at main's
    # revision answering?"; verify_orchestration answers "did the fleet come
    # back?". Only the second is the question this deploy exists to close, and
    # for its whole life the script asked only the first (mg-6d2f).
    verify_orchestration || exit 11

    # 3a. Report the supervision reading (mg-fa79). AFTER the two verifies,
    #     because a daemon that has not finished booting has not taken the
    #     lockfile yet and would read UNKNOWN for a reason that is about timing
    #     rather than about ownership.
    report_supervision

    # 3a-ii. Report whether the box's launchd plists match the code this deploy
    #        just installed (mg-b9e7). AFTER the install and the two verifies,
    #        because the whole value of asking here is that the binary being
    #        asked is a VERIFIED build from main — the audit compares against the
    #        plist the asked binary renders, and an older `pogo` answers with its
    #        own older plist. This is the only moment in the machine's day when
    #        "which build?" has a right answer. Reports and escalates; never
    #        reconciles, and never sets this script's exit code.
    report_activation

    # 3b. Report act 3 (mg-b6bd). AFTER verify_orchestration, because a pogod
    #     that has not finished booting has not finished refreshing prompts
    #     either, and reading the log before then would report a stale record or
    #     none. Reports only — the fleet is up; a missing prompt record is a
    #     thing to say, not a reason to call a completed deploy failed.
    report_prompt_refresh

    # 4. If a forced bounce killed active polecats, clean up the wreckage.
    if [ "$leftover" != "0" ] && [ "$leftover" != "?" ]; then
        log "cleaning up $leftover polecat(s) orphaned by the forced bounce"
        cleanup_orphans "$snapshot"
    fi

    # 5. Assert the fleet's mail loop survived the bounce. Reports only — the
    #    daemon is already up; a mail-check gap is an alarm to act on, not a
    #    reason to call a completed deploy failed (mg-de08).
    #
    #    Slack is the SET of schedules the force-killed polecats took with them,
    #    looked up BY NAME out of the pre-bounce body — never the NUMBER of dead
    #    polecats (mg-ea3e). The two differ exactly when a dead polecat had no
    #    mail-check to lose: the count hands out an allowance nothing earned,
    #    and a real crew loss disappears under it without a word.
    local mail_slack=""
    if [ -n "$mail_pre_body" ] && [ "$leftover" != "0" ] && [ "$leftover" != "?" ]; then
        mail_slack="$(expected_lost_mail_checks "$mail_pre_body" "$snapshot")"
    fi
    deploy_stage "post-check"
    verify_mail_checks_restored "$mail_pre" "$mail_slack"

    deploy_stage "done"
    log "redeploy complete."
}

# ---------------------------------------------------------------------------
# Arg parsing
# ---------------------------------------------------------------------------
usage() {
    sed -n '2,40p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

main() {
    [ $# -ge 1 ] || { usage; exit 2; }
    local subcmd="$1"; shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --yes)            ASSUME_YES=true ;;
            --force)          FORCE=true ;;
            --skip-drain)     SKIP_DRAIN=true ;;
            --drain-timeout)  DRAIN_TIMEOUT="$2"; shift ;;
            --repo)           REPO="$2"; shift ;;
            --port)           PORT="$2"; shift ;;
            -h|--help)        usage; exit 0 ;;
            *)                err "unknown flag: $1"; usage; exit 2 ;;
        esac
        shift
    done

    case "$subcmd" in
        check)     cmd_check ;;
        redeploy)  cmd_redeploy ;;
        -h|--help) usage; exit 0 ;;
        *)         err "unknown subcommand: $subcmd"; usage; exit 2 ;;
    esac
}

# Run main only when executed directly, so a test harness can source this file
# to exercise the pure helpers (classify_drift, json_str) without dispatching.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    main "$@"
fi
